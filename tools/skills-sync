#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   "typer>=0.9.0",
#   "rich>=13.0.0",
# ]
# ///
"""skills-sync: Ensure plugin is installed and sync skills/subagents for Claude + Codex."""

import json
import shutil
import subprocess
import sys
from pathlib import Path

import typer
from rich.console import Console

VERSION = "4.3.0"

console = Console()

# Resolve paths relative to script location
SCRIPT_DIR = Path(__file__).resolve().parent
REPO_ROOT = SCRIPT_DIR.parent
SUBAGENTS_ROOT = REPO_ROOT / "subagents"
RULES_ROOT = REPO_ROOT / "rules"

# Plugin/marketplace configuration
MARKETPLACE_REPO = "enitrat/skill-issue"
MARKETPLACE_NAME = "eni-skills"
PLUGIN_NAMES = ["base-config", "personal-skills"]

# Target directories
CODEX_SKILLS_DIR = Path.home() / ".codex" / "skills"
CODEX_PROMPTS_DIR = Path.home() / ".codex" / "prompts"
CODEX_AGENT_MIGRATION_FILE = Path.home() / ".codex" / "AGENT_MIGRATION.md"
CLAUDE_AGENTS_DIR = Path.home() / ".claude" / "agents"
CLAUDE_RULES_DIR = Path.home() / ".claude" / "rules"
CLAUDE_SETTINGS_FILE = Path.home() / ".claude" / "settings.json"

app = typer.Typer(
    help="Ensure Claude plugin is active and sync skills/subagents to Claude and Codex",
    add_completion=False,
    no_args_is_help=False,
)


def load_claude_settings() -> dict:
    """Load Claude settings.json."""
    if not CLAUDE_SETTINGS_FILE.exists():
        return {}
    try:
        return json.loads(CLAUDE_SETTINGS_FILE.read_text())
    except json.JSONDecodeError:
        console.print(f"[yellow]Warning:[/yellow] Invalid JSON in {CLAUDE_SETTINGS_FILE}")
        return {}


def is_plugin_installed(plugin_name: str) -> bool:
    """Check if a plugin is installed in Claude Code."""
    settings = load_claude_settings()

    # Check in plugins array for the plugin
    plugins = settings.get("plugins", [])
    for plugin in plugins:
        if isinstance(plugin, dict):
            # Check by name or by marketplace reference
            name = plugin.get("name", "")
            if name == plugin_name or name == f"{plugin_name}@{MARKETPLACE_NAME}":
                return True
        elif isinstance(plugin, str):
            # String format: "plugin-name@marketplace-name"
            if plugin == f"{plugin_name}@{MARKETPLACE_NAME}" or plugin == plugin_name:
                return True

    return False


def is_marketplace_added() -> bool:
    """Check if eni-skills marketplace is added."""
    settings = load_claude_settings()

    # Check in pluginMarketplaces array
    marketplaces = settings.get("pluginMarketplaces", [])
    for marketplace in marketplaces:
        if isinstance(marketplace, dict):
            if marketplace.get("name") == MARKETPLACE_NAME:
                return True
            # Also check source/url
            source = marketplace.get("source", marketplace.get("url", ""))
            if MARKETPLACE_REPO in source:
                return True
        elif isinstance(marketplace, str):
            if MARKETPLACE_NAME in marketplace or MARKETPLACE_REPO in marketplace:
                return True

    return False


def run_claude_command(args: list[str], dry_run: bool = False) -> tuple[bool, str]:
    """Run a claude CLI command. Returns (success, output)."""
    cmd = ["claude", "plugin"] + args
    cmd_str = " ".join(cmd)

    if dry_run:
        console.print(f"  [dim]Would run:[/dim] {cmd_str}")
        return True, ""

    console.print(f"  [dim]Running:[/dim] {cmd_str}")
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
        output = result.stderr.strip() or result.stdout.strip()
        if result.returncode == 0:
            return True, output
        else:
            return False, output
    except FileNotFoundError:
        return False, "'claude' command not found. Is Claude Code CLI installed?"
    except subprocess.TimeoutExpired:
        return False, "Command timed out"


def ensure_claude_plugins(dry_run: bool = False) -> bool:
    """Ensure all plugins are installed on Claude Code."""
    console.print("\n[blue]Claude Code Plugins[/blue]")
    console.print(f"[blue]{'─' * 40}[/blue]")

    # First ensure marketplace is added (do this once)
    marketplace_added = is_marketplace_added()
    if not marketplace_added:
        console.print(f"  [yellow]→[/yellow] Adding marketplace [bold]{MARKETPLACE_NAME}[/bold]...")
        success, output = run_claude_command(["marketplace", "add", MARKETPLACE_REPO], dry_run)

        if success:
            if not dry_run:
                console.print(f"  [green]✓[/green] Marketplace added")
        elif "already installed" in output.lower() or "already added" in output.lower():
            console.print(f"  [green]✓[/green] Marketplace [bold]{MARKETPLACE_NAME}[/bold] already added")
        else:
            console.print(f"  [red]Error:[/red] {output}")
            return False
    else:
        console.print(f"  [green]✓[/green] Marketplace [bold]{MARKETPLACE_NAME}[/bold] already added")

    # Install each plugin
    all_success = True
    for plugin_name in PLUGIN_NAMES:
        if is_plugin_installed(plugin_name):
            console.print(f"  [green]✓[/green] Plugin [bold]{plugin_name}@{MARKETPLACE_NAME}[/bold] is already installed")
            continue

        console.print(f"  [yellow]→[/yellow] Installing plugin [bold]{plugin_name}[/bold]...")
        success, output = run_claude_command(["install", f"{plugin_name}@{MARKETPLACE_NAME}"], dry_run)

        if success:
            if not dry_run:
                console.print(f"  [green]✓[/green] Plugin [bold]{plugin_name}[/bold] installed successfully")
        elif "already installed" in output.lower():
            console.print(f"  [green]✓[/green] Plugin [bold]{plugin_name}[/bold] already installed")
        else:
            console.print(f"  [red]Error:[/red] {output}")
            all_success = False

    return all_success


def sync_codex_skills(dry_run: bool = False) -> int:
    """Sync skills to Codex directory."""
    plugin_skill_roots = [(name, REPO_ROOT / "plugins" / name / "skills") for name in PLUGIN_NAMES]

    console.print("\n[blue]Codex Skills Sync[/blue]")
    console.print(f"[blue]{'─' * 40}[/blue]")
    console.print(f"[blue]Target:[/blue] {CODEX_SKILLS_DIR}\n")
    for _, root in plugin_skill_roots:
        console.print(f"[blue]Source:[/blue] {root}")
    console.print("")

    # Build skill map from all plugin skill roots. Later plugins in PLUGIN_NAMES
    # intentionally take precedence if a skill name appears multiple times.
    skill_map: dict[str, Path] = {}
    missing_roots: list[Path] = []
    for plugin_name, root in plugin_skill_roots:
        if not root.is_dir():
            missing_roots.append(root)
            continue
        for skill_dir in sorted(root.iterdir()):
            if not skill_dir.is_dir():
                continue
            skill_name = skill_dir.name
            if skill_name in skill_map:
                console.print(
                    f"  [yellow]Note:[/yellow] '{skill_name}' overridden by plugin [bold]{plugin_name}[/bold]"
                )
            skill_map[skill_name] = skill_dir

    for root in missing_roots:
        console.print(f"  [yellow]Warning:[/yellow] Skills directory not found: {root}")

    if not skill_map:
        console.print("[dim]No skills found[/dim]")
        return 0

    if dry_run:
        console.print("[yellow][DRY RUN][/yellow] Would sync:\n")

    # Create target if needed
    if not dry_run:
        CODEX_SKILLS_DIR.mkdir(parents=True, exist_ok=True)

    synced_count = 0
    skipped_count = 0

    for skill_name in sorted(skill_map):
        skill_dir = skill_map[skill_name]
        target_skill = CODEX_SKILLS_DIR / skill_name

        # Check if identical (simple check: target exists and has same files)
        if target_skill.exists():
            # Quick check: compare file count and SKILL.md
            src_skill_md = skill_dir / "SKILL.md"
            dst_skill_md = target_skill / "SKILL.md"

            if src_skill_md.exists() and dst_skill_md.exists():
                if src_skill_md.read_text() == dst_skill_md.read_text():
                    console.print(f"  [dim]\\[skip]      [/dim] {skill_name}")
                    skipped_count += 1
                    continue

            action = "update"
            style = "yellow"
        else:
            action = "create"
            style = "green"

        action_tag = f"\\[{action}]"

        if dry_run:
            console.print(f"  [{style}]{action_tag:<12}[/{style}] {skill_name}")
        else:
            # Remove old and copy fresh
            if target_skill.exists():
                shutil.rmtree(target_skill)
            shutil.copytree(skill_dir, target_skill)
            console.print(f"  [{style}]✓[/{style}] {action_tag:<12} {skill_name}")

        synced_count += 1

    console.print(f"\n  {synced_count} synced, {skipped_count} skipped (up-to-date)")
    return synced_count


def sync_subagents(dry_run: bool = False) -> int:
    """Sync subagent definitions for Claude and Codex."""
    console.print("\n[blue]Subagents Sync[/blue]")
    console.print(f"[blue]{'─' * 40}[/blue]")

    claude_src = SUBAGENTS_ROOT / "claude"
    codex_prompts_src = SUBAGENTS_ROOT / "codex" / "prompts"
    codex_doc_src = SUBAGENTS_ROOT / "codex" / "docs" / "AGENT_MIGRATION.md"

    if not SUBAGENTS_ROOT.is_dir():
        console.print(f"[dim]No subagents config found:[/dim] {SUBAGENTS_ROOT}")
        return 0

    if dry_run:
        console.print("[yellow][DRY RUN][/yellow] Would sync:\n")

    synced_count = 0

    def sync_file(src: Path, dst: Path) -> None:
        nonlocal synced_count
        if not src.exists():
            return

        if dst.exists() and src.read_text() == dst.read_text():
            console.print(f"  [dim]\\[skip]      [/dim] {dst}")
            return

        action = "update" if dst.exists() else "create"
        style = "yellow" if dst.exists() else "green"
        action_tag = f"\\[{action}]"

        if dry_run:
            console.print(f"  [{style}]{action_tag:<12}[/{style}] {dst}")
            synced_count += 1
            return

        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(src, dst)
        console.print(f"  [{style}]✓[/{style}] {action_tag:<12} {dst}")
        synced_count += 1

    # Claude agents (.json + optional .md)
    if claude_src.is_dir():
        console.print(f"[blue]Claude:[/blue] {claude_src} -> {CLAUDE_AGENTS_DIR}")
        for src in sorted(claude_src.iterdir()):
            if src.is_file() and src.suffix in {".json", ".md"}:
                sync_file(src, CLAUDE_AGENTS_DIR / src.name)
    else:
        console.print(f"[dim]Missing:[/dim] {claude_src}")

    # Codex prompts
    if codex_prompts_src.is_dir():
        console.print(f"[blue]Codex prompts:[/blue] {codex_prompts_src} -> {CODEX_PROMPTS_DIR}")
        for src in sorted(codex_prompts_src.iterdir()):
            if src.is_file() and src.suffix == ".md":
                sync_file(src, CODEX_PROMPTS_DIR / src.name)
    else:
        console.print(f"[dim]Missing:[/dim] {codex_prompts_src}")

    # Codex migration doc
    if codex_doc_src.is_file():
        console.print(f"[blue]Codex docs:[/blue] {codex_doc_src} -> {CODEX_AGENT_MIGRATION_FILE}")
        sync_file(codex_doc_src, CODEX_AGENT_MIGRATION_FILE)

    # Ensure project-local cache directories exist for codex subagent outputs
    local_cache_dirs = [
        Path.cwd() / ".codex" / "cache" / "agents" / "scout",
        Path.cwd() / ".codex" / "cache" / "agents" / "oracle",
        Path.cwd() / ".codex" / "cache" / "agents" / "spark",
    ]
    for cache_dir in local_cache_dirs:
        if dry_run:
            if not cache_dir.exists():
                console.print(f"  [green]\\[create]    [/green] {cache_dir}")
                synced_count += 1
            continue
        cache_dir.mkdir(parents=True, exist_ok=True)

    console.print(f"\n  {synced_count} subagent files synced")
    return synced_count


def sync_rules(dry_run: bool = False) -> int:
    """Sync rules to Claude Code directory."""
    console.print("\n[blue]Rules Sync[/blue]")
    console.print(f"[blue]{'─' * 40}[/blue]")
    console.print(f"[blue]Source:[/blue] {RULES_ROOT}")
    console.print(f"[blue]Target:[/blue] {CLAUDE_RULES_DIR}\n")

    if not RULES_ROOT.is_dir():
        console.print(f"[dim]No rules directory found:[/dim] {RULES_ROOT}")
        return 0

    # Find rule files (markdown)
    rule_files = [f for f in RULES_ROOT.iterdir() if f.is_file() and f.suffix == ".md"]
    if not rule_files:
        console.print("[dim]No rules found[/dim]")
        return 0

    if dry_run:
        console.print("[yellow][DRY RUN][/yellow] Would sync:\n")

    # Create target if needed
    if not dry_run:
        CLAUDE_RULES_DIR.mkdir(parents=True, exist_ok=True)

    synced_count = 0
    skipped_count = 0

    for rule_file in sorted(rule_files):
        rule_name = rule_file.name
        target_rule = CLAUDE_RULES_DIR / rule_name

        # Check if identical
        if target_rule.exists():
            if rule_file.read_text() == target_rule.read_text():
                console.print(f"  [dim]\\[skip]      [/dim] {rule_name}")
                skipped_count += 1
                continue
            action = "update"
            style = "yellow"
        else:
            action = "create"
            style = "green"

        action_tag = f"\\[{action}]"

        if dry_run:
            console.print(f"  [{style}]{action_tag:<12}[/{style}] {rule_name}")
        else:
            shutil.copy2(rule_file, target_rule)
            console.print(f"  [{style}]✓[/{style}] {action_tag:<12} {rule_name}")

        synced_count += 1

    console.print(f"\n  {synced_count} synced, {skipped_count} skipped (up-to-date)")
    return synced_count


def version_callback(value: bool) -> None:
    """Show version and exit."""
    if value:
        console.print(f"skills-sync version {VERSION}")
        raise typer.Exit()


@app.command()
def main(
    dry_run: bool = typer.Option(
        False,
        "--dry-run",
        "-n",
        help="Show what would be done without making changes.",
    ),
    version: bool = typer.Option(
        False,
        "--version",
        "-v",
        callback=version_callback,
        is_eager=True,
        help="Show version number.",
    ),
) -> None:
    """
    Sync Claude Code plugins, Codex skills, subagent configs, and rules.

    For Claude Code:
      - Checks if plugins (base-config, personal-skills) are installed
      - If not, adds marketplace and installs plugins via CLI
      - Syncs rules to ~/.claude/rules/ (custom behavior overrides)

    For Codex:
      - Copies skills to ~/.codex/skills/ (direct file sync)

    Examples:
      $ skills-sync              # Sync everything
      $ skills-sync --dry-run    # Preview changes
    """
    console.print(f"[bold]skills-sync v{VERSION}[/bold]")

    # Ensure Claude Code plugins are active
    claude_ok = ensure_claude_plugins(dry_run=dry_run)

    if not claude_ok:
        console.print("\n[yellow]Warning:[/yellow] Claude Code plugin setup incomplete")

    # Sync to Codex and Claude
    sync_codex_skills(dry_run=dry_run)
    sync_subagents(dry_run=dry_run)
    sync_rules(dry_run=dry_run)

    console.print("\n[green]Done![/green]")


if __name__ == "__main__":
    app()
