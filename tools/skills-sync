#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   "typer>=0.9.0",
#   "rich>=13.0.0",
# ]
# ///
"""skills-sync: Sync skills from this repo to ~/.claude/skills/ and ~/.codex/skills/"""

import filecmp
import shutil
import sys
from pathlib import Path

import typer
from rich.console import Console

VERSION = "2.0.0"

console = Console()

# Resolve paths relative to script location
SCRIPT_DIR = Path(__file__).resolve().parent
REPO_SKILLS = SCRIPT_DIR.parent / "skills"
TARGET_DIRS = [
    Path.home() / ".claude" / "skills",
    Path.home() / ".codex" / "skills",
]

app = typer.Typer(
    help="Sync Claude skills from repo to ~/.claude/skills/ and ~/.codex/skills/",
    add_completion=False,
    no_args_is_help=False,
)


def directories_identical(src: Path, dst: Path) -> bool:
    """Check if two directories have identical content recursively."""
    if not dst.exists():
        return False

    # Use filecmp.dircmp for recursive comparison
    comparison = filecmp.dircmp(src, dst)
    return _dircmp_equal(comparison)


def _dircmp_equal(dcmp: filecmp.dircmp) -> bool:
    """Recursively check if dircmp shows directories are equal."""
    # Check for any differences
    if dcmp.left_only or dcmp.right_only or dcmp.diff_files or dcmp.funny_files:
        return False

    # Recursively check subdirectories
    for subdir in dcmp.common_dirs:
        sub_dcmp = filecmp.dircmp(
            Path(dcmp.left) / subdir,
            Path(dcmp.right) / subdir,
        )
        if not _dircmp_equal(sub_dcmp):
            return False

    return True


def get_changed_files(src: Path, dst: Path) -> list[str]:
    """Get list of files that differ between directories."""
    if not dst.exists():
        return ["(new skill)"]

    changes = []
    comparison = filecmp.dircmp(src, dst)
    _collect_changes(comparison, "", changes)
    return changes[:3]  # Limit to first 3 for brevity


def _collect_changes(dcmp: filecmp.dircmp, prefix: str, changes: list[str]) -> None:
    """Recursively collect changed files."""
    for name in dcmp.left_only:
        changes.append(f"+{prefix}{name}")
    for name in dcmp.right_only:
        changes.append(f"-{prefix}{name}")
    for name in dcmp.diff_files:
        changes.append(f"~{prefix}{name}")

    for subdir in dcmp.common_dirs:
        sub_dcmp = filecmp.dircmp(
            Path(dcmp.left) / subdir,
            Path(dcmp.right) / subdir,
        )
        _collect_changes(sub_dcmp, f"{prefix}{subdir}/", changes)


def sync_skills(dry_run: bool = False) -> None:
    """Main sync logic."""
    # Check source exists
    if not REPO_SKILLS.is_dir():
        console.print(f"[red]Error:[/red] Source directory not found: {REPO_SKILLS}")
        raise typer.Exit(1)

    # Check if any skills exist
    skill_dirs = [d for d in REPO_SKILLS.iterdir() if d.is_dir()]
    if not skill_dirs:
        console.print(f"[yellow]Warning:[/yellow] No skills found in {REPO_SKILLS}")
        raise typer.Exit(0)

    console.print(f"[blue]Source:[/blue] {REPO_SKILLS}\n")

    if dry_run:
        console.print("[yellow][DRY RUN][/yellow] Would sync:\n")

    total_count = 0

    for target_dir in TARGET_DIRS:
        # Create target if needed
        if not dry_run:
            target_dir.mkdir(parents=True, exist_ok=True)

        console.print(f"[blue]Target:[/blue] {target_dir}")

        synced_count = 0
        skipped_count = 0

        for skill_dir in sorted(skill_dirs):
            skill_name = skill_dir.name
            target_skill = target_dir / skill_name

            # Check if content is identical
            if directories_identical(skill_dir, target_skill):
                console.print(f"  [dim]\\[skip]      [/dim] {skill_name}")
                skipped_count += 1
                continue

            # Determine action
            if target_skill.exists():
                action = "update"
                style = "yellow"
            else:
                action = "create"
                style = "green"

            # Get changed files for verbose output
            changes = get_changed_files(skill_dir, target_skill)
            changes_str = f" [dim]({', '.join(changes)})[/dim]" if changes else ""

            # Format action tag with escaped brackets
            action_tag = f"\\[{action}]"

            if dry_run:
                console.print(f"  [{style}]{action_tag:<12}[/{style}] {skill_name}{changes_str}")
            else:
                # Remove old target and copy fresh
                if target_skill.exists():
                    shutil.rmtree(target_skill)
                shutil.copytree(skill_dir, target_skill)
                console.print(f"  [{style}]\u2713[/{style}] {action_tag:<12} {skill_name}{changes_str}")

            synced_count += 1

        console.print(f"  {synced_count} synced, {skipped_count} skipped (up-to-date)\n")
        total_count += synced_count

    if dry_run:
        console.print(f"Would sync [blue]{total_count}[/blue] skill(s) total")
    else:
        console.print(f"Synced [green]{total_count}[/green] skill(s) total")


def version_callback(value: bool) -> None:
    """Show version and exit."""
    if value:
        console.print(f"skills-sync version {VERSION}")
        raise typer.Exit()


@app.command()
def main(
    dry_run: bool = typer.Option(
        False,
        "--dry-run",
        "-n",
        help="Show what would be synced without making changes.",
    ),
    version: bool = typer.Option(
        False,
        "--version",
        "-v",
        callback=version_callback,
        is_eager=True,
        help="Show version number.",
    ),
) -> None:
    """
    Sync Claude skills from repo to ~/.claude/skills/ and ~/.codex/skills/.

    Behavior:
      - Checks content similarity before syncing (SKILL.md, scripts/, references/)
      - Skips skills that are already up-to-date (identical content)
      - Overwrites only skills that have changed
      - Preserves other skills already in target directories

    Examples:
      $ skills-sync              # Sync skills
      $ skills-sync --dry-run    # Preview changes
    """
    sync_skills(dry_run=dry_run)


if __name__ == "__main__":
    app()
