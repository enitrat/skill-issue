"""skills-sync: Sync skills and hooks from this repo to ~/.claude/"""

import filecmp
import json
import shutil
import sys
from pathlib import Path
from typing import Any

import typer
from rich.console import Console

VERSION = "3.0.0"

console = Console()

# Resolve paths relative to script location
SCRIPT_DIR = Path(__file__).resolve().parent
REPO_SKILLS = SCRIPT_DIR.parent / "plugins" / "personal-skills" / "skills"
REPO_HOOKS = SCRIPT_DIR.parent / "hooks"
TARGET_DIRS = [
    Path.home() / ".claude" / "skills",
    Path.home() / ".codex" / "skills",
]
TARGET_HOOKS_DIR = Path.home() / ".claude" / "hooks" / "synced"
SETTINGS_FILE = Path.home() / ".claude" / "settings.json"

app = typer.Typer(
    help="Sync Claude skills (to ~/.claude/ and ~/.codex/) and hooks (to ~/.claude/)",
    add_completion=False,
    no_args_is_help=False,
)


def directories_identical(src: Path, dst: Path) -> bool:
    """Check if two directories have identical content recursively."""
    if not dst.exists():
        return False

    # Use filecmp.dircmp for recursive comparison
    comparison = filecmp.dircmp(src, dst)
    return _dircmp_equal(comparison)


def _dircmp_equal(dcmp: filecmp.dircmp) -> bool:
    """Recursively check if dircmp shows directories are equal."""
    # Check for any differences
    if dcmp.left_only or dcmp.right_only or dcmp.diff_files or dcmp.funny_files:
        return False

    # Recursively check subdirectories
    for subdir in dcmp.common_dirs:
        sub_dcmp = filecmp.dircmp(
            Path(dcmp.left) / subdir,
            Path(dcmp.right) / subdir,
        )
        if not _dircmp_equal(sub_dcmp):
            return False

    return True


def get_changed_files(src: Path, dst: Path) -> list[str]:
    """Get list of files that differ between directories."""
    if not dst.exists():
        return ["(new skill)"]

    changes = []
    comparison = filecmp.dircmp(src, dst)
    _collect_changes(comparison, "", changes)
    return changes[:3]  # Limit to first 3 for brevity


def _collect_changes(dcmp: filecmp.dircmp, prefix: str, changes: list[str]) -> None:
    """Recursively collect changed files."""
    for name in dcmp.left_only:
        changes.append(f"+{prefix}{name}")
    for name in dcmp.right_only:
        changes.append(f"-{prefix}{name}")
    for name in dcmp.diff_files:
        changes.append(f"~{prefix}{name}")

    for subdir in dcmp.common_dirs:
        sub_dcmp = filecmp.dircmp(
            Path(dcmp.left) / subdir,
            Path(dcmp.right) / subdir,
        )
        _collect_changes(sub_dcmp, f"{prefix}{subdir}/", changes)


# ─────────────────────────────────────────────────────────────────────────────
# Hook Syncing
# ─────────────────────────────────────────────────────────────────────────────


def load_settings() -> dict[str, Any]:
    """Load settings.json, creating empty structure if missing."""
    if not SETTINGS_FILE.exists():
        return {}
    try:
        return json.loads(SETTINGS_FILE.read_text())
    except json.JSONDecodeError:
        console.print(f"[yellow]Warning:[/yellow] Invalid JSON in {SETTINGS_FILE}")
        return {}


def save_settings(settings: dict[str, Any]) -> None:
    """Save settings.json with proper formatting."""
    SETTINGS_FILE.parent.mkdir(parents=True, exist_ok=True)
    SETTINGS_FILE.write_text(json.dumps(settings, indent=2) + "\n")


def hook_command_matches(hook_entry: dict, command_pattern: str) -> bool:
    """Check if a hook entry's command matches the pattern (by path suffix)."""
    cmd = hook_entry.get("command", "")
    return command_pattern in cmd


def find_existing_hook_index(
    hooks_array: list[dict], event: str, matcher: str | None, command_pattern: str
) -> int | None:
    """Find index of existing hook entry that matches our hook.

    Returns the index of the matcher object that contains our hook command,
    or None if not found.
    """
    for i, matcher_obj in enumerate(hooks_array):
        obj_matcher = matcher_obj.get("matcher")
        # Match if both have same matcher (or both have no matcher)
        if obj_matcher == matcher:
            for hook in matcher_obj.get("hooks", []):
                if hook_command_matches(hook, command_pattern):
                    return i
    return None


def register_hook_in_settings(
    settings: dict[str, Any],
    hook_name: str,
    event: str,
    matcher: str | None,
    timeout: int | None,
) -> bool:
    """Register a hook in settings without duplicating.

    Returns True if hook was added/updated, False if already exists unchanged.
    """
    # Build the command path
    command = f"bash $HOME/.claude/hooks/synced/{hook_name}/wrapper.sh"

    # Ensure hooks structure exists
    if "hooks" not in settings:
        settings["hooks"] = {}
    if event not in settings["hooks"]:
        settings["hooks"][event] = []

    hooks_array = settings["hooks"][event]

    # Build the hook entry
    hook_entry: dict[str, Any] = {"type": "command", "command": command}
    if timeout:
        hook_entry["timeout"] = timeout

    # Check if hook already exists with same config
    command_pattern = f"hooks/synced/{hook_name}/wrapper.sh"
    existing_idx = find_existing_hook_index(hooks_array, event, matcher, command_pattern)

    if existing_idx is not None:
        # Check if the existing hook has the same config
        matcher_obj = hooks_array[existing_idx]
        for hook in matcher_obj.get("hooks", []):
            if hook_command_matches(hook, command_pattern):
                # Check if timeout matches
                existing_timeout = hook.get("timeout")
                if existing_timeout == timeout:
                    return False  # Already exists unchanged
                # Update timeout
                if timeout:
                    hook["timeout"] = timeout
                elif "timeout" in hook:
                    del hook["timeout"]
                return True

    # Find or create matcher object
    target_matcher_obj = None
    for matcher_obj in hooks_array:
        if matcher_obj.get("matcher") == matcher:
            target_matcher_obj = matcher_obj
            break

    if target_matcher_obj is None:
        # Create new matcher object
        target_matcher_obj = {"hooks": []}
        if matcher:
            target_matcher_obj["matcher"] = matcher
        hooks_array.append(target_matcher_obj)

    # Add the hook
    target_matcher_obj["hooks"].append(hook_entry)
    return True


def sync_hooks(dry_run: bool = False) -> int:
    """Sync hooks from repo to ~/.claude/hooks/synced/ and register in settings.

    Returns count of hooks synced.
    """
    if not REPO_HOOKS.is_dir():
        console.print(f"[dim]No hooks directory found at {REPO_HOOKS}[/dim]")
        return 0

    # Find hook directories (must have hook.json)
    hook_dirs = [
        d for d in REPO_HOOKS.iterdir()
        if d.is_dir() and (d / "hook.json").exists()
    ]

    if not hook_dirs:
        console.print(f"[dim]No hooks with hook.json found in {REPO_HOOKS}[/dim]")
        return 0

    console.print(f"\n[blue]{'─' * 60}[/blue]")
    console.print(f"[blue]Hooks[/blue]")
    console.print(f"[blue]{'─' * 60}[/blue]")
    console.print(f"[blue]Source:[/blue] {REPO_HOOKS}")
    console.print(f"[blue]Target:[/blue] {TARGET_HOOKS_DIR}\n")

    if dry_run:
        console.print("[yellow][DRY RUN][/yellow] Would sync:\n")

    # Load current settings
    settings = load_settings()
    settings_changed = False

    synced_count = 0
    skipped_count = 0

    for hook_dir in sorted(hook_dirs):
        hook_name = hook_dir.name
        target_hook = TARGET_HOOKS_DIR / hook_name

        # Load hook config
        try:
            hook_config = json.loads((hook_dir / "hook.json").read_text())
        except json.JSONDecodeError:
            console.print(f"  [red]\\[error]     [/red] {hook_name} - invalid hook.json")
            continue

        event = hook_config.get("event")
        if not event:
            console.print(f"  [red]\\[error]     [/red] {hook_name} - missing 'event' in hook.json")
            continue

        matcher = hook_config.get("matcher")  # Optional
        timeout = hook_config.get("timeout")  # Optional

        # Check if files changed
        files_changed = not directories_identical(hook_dir, target_hook)

        # Check if settings need update
        if not dry_run:
            settings_updated = register_hook_in_settings(
                settings, hook_name, event, matcher, timeout
            )
        else:
            # In dry run, check if it would be added
            settings_updated = find_existing_hook_index(
                settings.get("hooks", {}).get(event, []),
                event,
                matcher,
                f"hooks/synced/{hook_name}/wrapper.sh",
            ) is None

        if not files_changed and not settings_updated:
            console.print(f"  [dim]\\[skip]      [/dim] {hook_name}")
            skipped_count += 1
            continue

        # Determine action
        if target_hook.exists():
            action = "update"
            style = "yellow"
        else:
            action = "create"
            style = "green"

        # Get details
        details = f"[dim]({event}"
        if matcher:
            details += f", matcher={matcher}"
        details += ")[/dim]"

        action_tag = f"\\[{action}]"

        if dry_run:
            console.print(f"  [{style}]{action_tag:<12}[/{style}] {hook_name} {details}")
        else:
            # Copy hook files
            TARGET_HOOKS_DIR.mkdir(parents=True, exist_ok=True)
            if target_hook.exists():
                shutil.rmtree(target_hook)
            shutil.copytree(hook_dir, target_hook)

            if settings_updated:
                settings_changed = True

            console.print(f"  [{style}]✓[/{style}] {action_tag:<12} {hook_name} {details}")

        synced_count += 1

    # Save settings if changed
    if settings_changed and not dry_run:
        save_settings(settings)
        console.print(f"\n  [green]✓[/green] Updated {SETTINGS_FILE}")

    console.print(f"\n  {synced_count} synced, {skipped_count} skipped (up-to-date)")

    return synced_count


def sync_skills(dry_run: bool = False) -> int:
    """Main sync logic."""
    # Check source exists
    if not REPO_SKILLS.is_dir():
        console.print(f"[red]Error:[/red] Source directory not found: {REPO_SKILLS}")
        raise typer.Exit(1)

    # Check if any skills exist
    skill_dirs = [d for d in REPO_SKILLS.iterdir() if d.is_dir()]
    if not skill_dirs:
        console.print(f"[yellow]Warning:[/yellow] No skills found in {REPO_SKILLS}")
        raise typer.Exit(0)

    console.print(f"[blue]Source:[/blue] {REPO_SKILLS}\n")

    if dry_run:
        console.print("[yellow][DRY RUN][/yellow] Would sync:\n")

    total_count = 0

    for target_dir in TARGET_DIRS:
        # Create target if needed
        if not dry_run:
            target_dir.mkdir(parents=True, exist_ok=True)

        console.print(f"[blue]Target:[/blue] {target_dir}")

        synced_count = 0
        skipped_count = 0

        for skill_dir in sorted(skill_dirs):
            skill_name = skill_dir.name
            target_skill = target_dir / skill_name

            # Check if content is identical
            if directories_identical(skill_dir, target_skill):
                console.print(f"  [dim]\\[skip]      [/dim] {skill_name}")
                skipped_count += 1
                continue

            # Determine action
            if target_skill.exists():
                action = "update"
                style = "yellow"
            else:
                action = "create"
                style = "green"

            # Get changed files for verbose output
            changes = get_changed_files(skill_dir, target_skill)
            changes_str = f" [dim]({', '.join(changes)})[/dim]" if changes else ""

            # Format action tag with escaped brackets
            action_tag = f"\\[{action}]"

            if dry_run:
                console.print(f"  [{style}]{action_tag:<12}[/{style}] {skill_name}{changes_str}")
            else:
                # Remove old target and copy fresh
                if target_skill.exists():
                    shutil.rmtree(target_skill)
                shutil.copytree(skill_dir, target_skill)
                console.print(f"  [{style}]\u2713[/{style}] {action_tag:<12} {skill_name}{changes_str}")

            synced_count += 1

        console.print(f"  {synced_count} synced, {skipped_count} skipped (up-to-date)\n")
        total_count += synced_count

    if dry_run:
        console.print(f"Would sync [blue]{total_count}[/blue] skill(s) total")
    else:
        console.print(f"Synced [green]{total_count}[/green] skill(s) total")

    return total_count


def version_callback(value: bool) -> None:
    """Show version and exit."""
    if value:
        console.print(f"skills-sync version {VERSION}")
        raise typer.Exit()


@app.command()
def main(
    dry_run: bool = typer.Option(
        False,
        "--dry-run",
        "-n",
        help="Show what would be synced without making changes.",
    ),
    version: bool = typer.Option(
        False,
        "--version",
        "-v",
        callback=version_callback,
        is_eager=True,
        help="Show version number.",
    ),
) -> None:
    """
    Sync Claude skills and hooks from repo.

    Skills: Synced to ~/.claude/skills/ and ~/.codex/skills/
    Hooks:  Synced to ~/.claude/hooks/synced/ and registered in settings.json

    Behavior:
      - Checks content similarity before syncing
      - Skips items that are already up-to-date (identical content)
      - Overwrites only items that have changed
      - Preserves other skills/hooks already in target directories
      - Hooks require a hook.json config file with 'event' (and optional 'matcher', 'timeout')

    Examples:
      $ skills-sync              # Sync skills and hooks
      $ skills-sync --dry-run    # Preview changes
    """
    # Sync skills to Claude and Codex
    sync_skills(dry_run=dry_run)

    # Sync hooks to Claude only
    sync_hooks(dry_run=dry_run)


if __name__ == "__main__":
    app()
