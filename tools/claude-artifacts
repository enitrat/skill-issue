    )


def show_version(value: bool) -> None:
    if value:
        typer.echo(f"claude-artifacts {VERSION}")
        raise typer.Exit()


@app.callback()
def main(
    ctx: typer.Context,
    version: Annotated[bool, typer.Option("--version", "-v", callback=show_version, is_eager=True, help="Show the version.")] = False,
) -> None:
    """Composition root: resolve the token once, then hand commands the API."""
    helper = Path(__file__).resolve().parent / "claude-mcp-headers"
    base = os.environ.get("CLAUDE_ARTIFACTS_API", "https://api.anthropic.com/api/frame")
    ctx.obj = Context(lambda: FrameApi(base, expect(read_token(helper))))


if __name__ == "__main__":
    app()
