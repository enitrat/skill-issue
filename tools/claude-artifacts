#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["typer>=0.12"]
# ///
"""Publish and manage claude.ai Artifacts from a CLIProxy session.

Claude Code's Artifact tool needs a claude.ai login, which a session routed
through CLIProxy does not have. This CLI calls the same undocumented endpoints
(api.anthropic.com/api/frame/*) with the claude.ai OAuth token CLIProxy keeps.
claude-mcp-headers resolves that token and the account.
"""

import json
import re
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
import uuid
from enum import Enum
from pathlib import Path
from typing import Annotated, Any, Optional

import typer

VERSION = "3.1.0"
API = "https://api.anthropic.com/api/frame"
BASE58 = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"
USER_AGENT = f"claude-artifacts/{VERSION}"
UUID = re.compile(r"^[0-9a-f]{8}-([0-9a-f]{4}-){3}[0-9a-f]{12}$")

app = typer.Typer(
    help=__doc__,
    no_args_is_help=True,
    add_completion=False,
    pretty_exceptions_enable=False,
)


class Share(str, Enum):
    private = "private"
    org = "org"


class Scope(str, Enum):
    mine = "mine"
    shared = "shared"
    all = "all"


ArtifactArg = Annotated[
    str,
    typer.Argument(
        help="A claude.ai/artifact/<id> or claude.ai/code/artifact/<uuid> link, or the bare id.",
        show_default=False,
    ),
]
JsonOpt = Annotated[bool, typer.Option("--json", help="Print JSON.")]


def fail(message: str) -> None:
    typer.echo(f"claude-artifacts: {message}", err=True)
    raise typer.Exit(1)


def slug_of(artifact: str) -> str:
    """The API's uuid for a link or id. Short ids are the uuid in base58."""
    ident = urllib.parse.urlsplit(artifact).path.rstrip("/").rsplit("/", 1)[-1]
    if UUID.match(ident.lower()):
        return ident.lower()
    if not ident or any(c not in BASE58 for c in ident):
        fail(f"not an artifact link or id: {artifact}")
    n = 0
    for c in ident:
        n = n * 58 + BASE58.index(c)
    if n >= 1 << 128:
        fail(f"not an artifact id: {artifact}")
    h = f"{n:032x}"
    return f"{h[:8]}-{h[8:12]}-{h[12:16]}-{h[16:20]}-{h[20:]}"


def short_link(slug: str) -> str:
    n = int(slug.replace("-", ""), 16)
    digits = ""
    while n:
        n, r = divmod(n, 58)
        digits = BASE58[r] + digits
    return f"https://claude.ai/artifact/{digits.rjust(22, BASE58[0])}"


_auth: Optional[str] = None


def auth() -> str:
    global _auth
    if _auth is None:
        helper = Path(__file__).resolve().parent / "claude-mcp-headers"
        done = subprocess.run([str(helper)], capture_output=True, text=True)
        if done.returncode != 0:
            fail(f"no claude.ai token: {done.stderr.strip()} (see claude-mcp-headers --help)")
        _auth = json.loads(done.stdout)["Authorization"]
    return _auth


def frame(method: str, path: str, body: Any = None, headers: Optional[dict] = None) -> Any:
    request = urllib.request.Request(
        f"{API}{path}",
        method=method,
        data=None if body is None else json.dumps(body).encode(),
        headers={
            "Authorization": auth(),
            "X-Frame-CP": "go",
            "content-type": "application/json",
            "User-Agent": USER_AGENT,
            **(headers or {}),
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=60) as response:
            raw = response.read()
    except urllib.error.HTTPError as error:
        fail(f"{method} {path}: HTTP {error.code}: {error.read()[:300].decode(errors='replace')}")
    except urllib.error.URLError as error:
        fail(f"{method} {path}: {error.reason}")
    return json.loads(raw) if raw.strip() else None


def frames(rel: Optional[str], limit: int) -> list[dict]:
    query = {"limit": str(limit), **({"rel": rel} if rel else {})}
    body = frame("GET", f"/frames?{urllib.parse.urlencode(query)}")
    if isinstance(body, list):
        return body
    return body.get("data") or body.get("frames") or body.get("items") or []


def page_title(html: str, file: Path) -> str:
    found = re.search(r"<title[^>]*>(.*?)</title>", html, re.IGNORECASE | re.DOTALL)
    title = " ".join(found.group(1).split()) if found else ""
    return title or file.stem


def set_share(slug: str, share: Share) -> None:
    mode = "owner" if share is Share.private else "org"
    current = frame("GET", f"/perm/{slug}")
    now = (current.get("read") or {}).get("mode") or "owner"
    if now == mode:
        return
    allowed = current.get("assignableReadModes")
    if allowed is not None and mode not in allowed:
        fail(f"this account or organization does not allow {share.value} sharing")
    users = (current.get("read") or {}).get("users") or [] if mode == "org" else []
    frame("PATCH", f"/perm/{slug}", {"read": {"mode": mode, "users": users}}, {"If-Match": current["version"]})


def deploy(
    file: Path,
    slug: Optional[str],
    title: Optional[str],
    description: Optional[str],
    icon: Optional[str],
    label: Optional[str],
    share: Optional[Share],
    pin: bool,
    as_json: bool,
) -> None:
    if file.suffix.lower() not in (".html", ".htm"):
        fail(f"only .html files: {file}")
    try:
        html = file.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as error:
        fail(f"cannot read {file}: {error}")
    body = {
        "title": title or page_title(html, file),
        "favicon": "*",
        "content": html,
        **({"slug": slug} if slug else {}),
        **({"description": description} if description else {}),
        **({"icon": icon} if icon else {}),
        **({"label": label} if label else {}),
    }
    result = frame("POST", "/deploy/direct", body)
    new_slug = result.get("slug") if isinstance(result, dict) else None
    if not new_slug:
        fail(f"deploy returned no slug: {json.dumps(result)[:300]}")
    if share:
        set_share(new_slug, share)
    if pin:
        frame("POST", f"/favorite/{new_slug}")
    link = short_link(new_slug)
    if as_json:
        typer.echo(json.dumps({"url": link, "slug": new_slug, "title": body["title"], "version": result.get("version"), "created": slug is None}, indent=2))
        return
    verb = "Updated" if slug else "Created"
    typer.echo(f'{verb} "{body["title"]}" ({result.get("version", "?")})', err=True)
    typer.echo(link)


TitleOpt = Annotated[Optional[str], typer.Option(help="Title. Defaults to the page's <title>, then the file name.")]
DescriptionOpt = Annotated[Optional[str], typer.Option(help="One sentence for the gallery card.")]
IconOpt = Annotated[Optional[str], typer.Option(help="One generic word for the tab icon, such as chart or book.")]
LabelOpt = Annotated[Optional[str], typer.Option(help="Short name for this version.")]
ShareOpt = Annotated[Optional[Share], typer.Option(help="Audience after publishing.")]
PinOpt = Annotated[bool, typer.Option("--pin", help="Pin to the claude.ai sidebar.")]
FileArg = Annotated[Path, typer.Argument(help="The .html page.", show_default=False)]


@app.command()
def publish(
    file: FileArg,
    title: TitleOpt = None,
    description: DescriptionOpt = None,
    icon: IconOpt = None,
    label: LabelOpt = None,
    share: ShareOpt = None,
    pin: PinOpt = False,
    as_json: JsonOpt = False,
) -> None:
    """Publish a page as a new artifact. Prints its link; new artifacts start private."""
    deploy(file, None, title, description, icon, label, share, pin, as_json)


@app.command()
def update(
    artifact: ArtifactArg,
    file: FileArg,
    title: TitleOpt = None,
    description: DescriptionOpt = None,
    icon: IconOpt = None,
    label: LabelOpt = None,
    share: ShareOpt = None,
    pin: PinOpt = False,
    as_json: JsonOpt = False,
) -> None:
    """Publish a page as a new version of an existing artifact, same link."""
    slug = slug_of(artifact)
    frame("GET", f"/{slug}")
    if description is None:
        # A deploy without a description clears it; keep the current one.
        current = next((r for r in frames(None, 200) if r.get("slug") == slug), {})
        description = current.get("description")
    deploy(file, slug, title, description, icon, label, share, pin, as_json)


@app.command("list")
def list_(
    scope: Annotated[Scope, typer.Option(help="Your artifacts, ones shared with you, or both.")] = Scope.mine,
    limit: Annotated[int, typer.Option(help="Maximum per scope.")] = 60,
    as_json: JsonOpt = False,
) -> None:
    """List artifacts, most recently updated first."""
    rows = []
    for rel in {"mine": [None], "shared": ["shared"], "all": [None, "shared"]}[scope.value]:
        rows += frames(rel, limit)
    rows = [r for r in rows if r.get("source_surface", "code") == "code" or scope is not Scope.mine]
    out = [
        {
            "url": short_link(r["slug"]),
            "title": r.get("title"),
            "audience": r.get("audience"),
            "updated": r.get("updatedAt") or r.get("created_at"),
            "owner": r.get("owner_email"),
        }
        for r in rows
    ]
    out.sort(key=lambda r: r["updated"] or "", reverse=True)
    if as_json:
        typer.echo(json.dumps(out, indent=2))
        return
    for r in out:
        typer.echo("\t".join(str(r[k] or "") for k in ("updated", "audience", "url", "title")))


@app.command()
def read(
    artifact: ArtifactArg,
    content: Annotated[bool, typer.Option("--content", help="Print the published source instead.")] = False,
    path: Annotated[str, typer.Option(help="File to print with --content.")] = "index.html",
    as_json: JsonOpt = False,
) -> None:
    """Show an artifact's metadata, or its published source with --content."""
    slug = slug_of(artifact)
    meta = frame("GET", f"/{slug}")
    if content:
        url = f"https://{slug}.frame.claudeusercontent.com/_f/{meta['ver']}/_src/{urllib.parse.quote(path)}?__frame_t={urllib.parse.quote(meta['assetToken'])}"
        try:
            with urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": USER_AGENT}), timeout=60) as response:
                sys.stdout.buffer.write(response.read())
        except urllib.error.HTTPError as error:
            fail(f"{path}: HTTP {error.code}")
        return
    perm = meta.get("perm") or {}
    info = {
        "url": short_link(slug),
        "title": meta.get("title"),
        "audience": perm.get("mode") or "owner",
        "version": meta.get("live"),
        "versions": len(meta.get("history") or []),
        "files": [f.get("path") for f in meta.get("files") or []],
        "author": (meta.get("author") or {}).get("email"),
        "created": meta.get("created_at"),
        "updated": meta.get("updated_at"),
        "views": meta.get("view_count"),
    }
    if as_json:
        typer.echo(json.dumps(info, indent=2))
        return
    for key, value in info.items():
        typer.echo(f"{key}: {', '.join(value) if isinstance(value, list) else value}")


@app.command()
def versions(artifact: ArtifactArg, as_json: JsonOpt = False) -> None:
    """List an artifact's versions, newest first."""
    slug = slug_of(artifact)
    body = frame("GET", f"/versions/{slug}")
    details = body.get("versions") or {}
    out = [{"version": v, "live": v == body.get("live"), **details.get(v, {})} for v in body.get("history") or []]
    if as_json:
        typer.echo(json.dumps(out, indent=2))
        return
    for v in out:
        typer.echo("\t".join([v["version"], "live" if v["live"] else "", v.get("created_at", ""), v.get("title", "")]))


@app.command()
def comments(artifact: ArtifactArg, as_json: JsonOpt = False) -> None:
    """Show an artifact's comment threads."""
    body = frame("GET", f"/comments/{slug_of(artifact)}?names=1")
    if as_json:
        typer.echo(json.dumps(body.get("threads") or [], indent=2))
        return
    threads = body.get("threads") or []
    if not threads:
        typer.echo("No comments.", err=True)
    for thread in threads:
        typer.echo(json.dumps(thread, ensure_ascii=False))


@app.command()
def share(artifact: ArtifactArg, audience: Annotated[Share, typer.Argument(help="private or org.")]) -> None:
    """Set who can open an artifact: only you, or your organization."""
    slug = slug_of(artifact)
    set_share(slug, audience)
    typer.echo(short_link(slug))


@app.command()
def rename(artifact: ArtifactArg, title: Annotated[str, typer.Argument(help="New title.")]) -> None:
    """Rename an artifact without publishing a new version."""
    slug = slug_of(artifact)
    frame("POST", f"/retitle/{slug}", {"title": title})
    typer.echo(short_link(slug))


@app.command()
def pin(artifact: ArtifactArg) -> None:
    """Pin an artifact to your claude.ai sidebar."""
    frame("POST", f"/favorite/{slug_of(artifact)}")


@app.command()
def unpin(artifact: ArtifactArg) -> None:
    """Unpin an artifact from your claude.ai sidebar."""
    frame("DELETE", f"/favorite/{slug_of(artifact)}")


@app.command()
def delete(
    artifact: ArtifactArg,
    yes: Annotated[bool, typer.Option("--yes", help="Delete; without it, only say what would go.")] = False,
) -> None:
    """Delete an artifact. Its link stops working for everyone."""
    slug = slug_of(artifact)
    title = frame("GET", f"/{slug}").get("title")
    if not yes:
        fail(f'would delete "{title}" ({short_link(slug)}); add --yes')
    frame("DELETE", f"/{slug}")
    typer.echo(f'Deleted "{title}"', err=True)


TEXT_TYPES = {
    ".html": "text/html",
    ".htm": "text/html",
    ".css": "text/css",
    ".js": "text/javascript",
    ".json": "application/json",
    ".md": "text/markdown",
    ".txt": "text/plain",
    ".svg": "image/svg+xml",
}


def find_type(name: str) -> dict:
    """A type by title (any case), slug, or link."""
    found = frame("GET", "/types").get("types") or []
    wanted = name.strip().lower()
    for t in found:
        if wanted in ((t.get("title") or "").lower(), t.get("slug"), (t.get("url") or "").lower()):
            return t
    if "/" in name or UUID.match(wanted) or len(wanted) == 22:
        slug = slug_of(name)
        for t in found:
            if t.get("slug") == slug:
                return t
    fail(f"no type named {name!r}; `claude-artifacts types` lists the ones this account has")


@app.command()
def types(as_json: JsonOpt = False) -> None:
    """List the artifact types (Slides, Sheets, Design...) this account can create."""
    found = frame("GET", "/types").get("types") or []
    out = [{"title": t.get("title"), "url": t.get("url"), "description": t.get("description")} for t in found]
    if as_json:
        typer.echo(json.dumps(out, indent=2))
        return
    for t in out:
        typer.echo(f"{t['title']}\t{t['url']}\t{(t['description'] or '')[:100]}")


@app.command("type-skill")
def type_skill(
    type_name: Annotated[str, typer.Argument(metavar="TYPE", help="Type title, such as Slides, or its link.")],
    path: Annotated[str, typer.Option(help="Another file of the type, such as artifact-type/reference/format.md.")] = "SKILL.md",
) -> None:
    """Print a type's SKILL.md: how to fill an artifact made from it."""
    t = find_type(type_name)
    parts = "/".join(urllib.parse.quote(part) for part in path.split("/"))
    body = frame("GET", f"/types/{t['slug']}/files/{parts}")
    if body.get("truncated"):
        typer.echo(f"claude-artifacts: {path} is truncated by the server", err=True)
    typer.echo(body.get("text") or body.get("content") or "")


@app.command()
def create(
    type_name: Annotated[str, typer.Argument(metavar="TYPE", help="Type title, such as Slides, or its link.")],
    title: Annotated[str, typer.Argument(help="The new artifact's title.")],
    as_json: JsonOpt = False,
) -> None:
    """Create an empty artifact from a type. Fill it with push, following type-skill."""
    t = find_type(type_name)
    key = urllib.parse.quote(f"claude-artifacts-{uuid.uuid4()}")
    body = frame("POST", f"/types/{t['slug']}/create?idempotency_key={key}", {"target_type_version": None, "title": title})
    slug = body.get("slug")
    if not slug:
        fail(f"create returned no slug: {json.dumps(body)[:300]}")
    if as_json:
        typer.echo(json.dumps({"url": short_link(slug), "slug": slug, "type": t.get("title"), "version": body.get("version"), "contract": body.get("contract")}, indent=2))
        return
    typer.echo(f'Created a {t.get("title")} artifact, "{title}"', err=True)
    typer.echo(short_link(slug))


@app.command()
def push(
    artifact: ArtifactArg,
    directory: Annotated[Path, typer.Argument(help="Folder whose files land at the same paths, such as one holding project/.")],
    remove: Annotated[Optional[list[str]], typer.Option("--remove", help="Path to delete from the artifact; repeatable.")] = None,
    label: LabelOpt = None,
    as_json: JsonOpt = False,
) -> None:
    """Send a folder's files to an artifact. Files not sent stay as they are."""
    slug = slug_of(artifact)
    if not directory.is_dir():
        fail(f"not a directory: {directory}")
    manifest = {}
    for file in sorted(p for p in directory.rglob("*") if p.is_file()):
        rel = file.relative_to(directory).as_posix()
        if any(part.startswith(".") for part in file.relative_to(directory).parts):
            continue
        content_type = TEXT_TYPES.get(file.suffix.lower())
        if content_type is None:
            fail(f"only text files ({', '.join(sorted(TEXT_TYPES))}): {rel}")
        try:
            manifest[rel] = {"content": file.read_text(encoding="utf-8"), "contentType": content_type}
        except UnicodeDecodeError:
            fail(f"not UTF-8: {rel}")
    for path in remove or []:
        manifest[path] = None
    if not manifest:
        fail(f"no files in {directory}")
    meta = frame("GET", f"/{slug}")
    body = {
        "slug": slug,
        "title": meta.get("title"),
        "baseVersion": meta.get("live") or meta.get("ver"),
        "manifest": manifest,
        "mode": "patch",
        **({"label": label} if label else {}),
    }
    result = frame("POST", "/deploy/direct", body)
    if as_json:
        typer.echo(json.dumps({"url": short_link(slug), "version": result.get("version"), "files": sorted(manifest)}, indent=2))
        return
    typer.echo(f'Pushed {len(manifest)} changes to "{meta.get("title")}" ({result.get("version", "?")})', err=True)
    typer.echo(short_link(slug))


def version_callback(value: bool) -> None:
    if value:
        typer.echo(f"claude-artifacts {VERSION}")
        raise typer.Exit()


@app.callback()
def main(
    version: Annotated[
        bool, typer.Option("--version", "-v", callback=version_callback, is_eager=True, help="Show the version.")
    ] = False,
) -> None:
    pass


if __name__ == "__main__":
    app()
