#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["typer>=0.12"]
# ///
"""Publish and manage claude.ai Artifacts from a CLIProxy session.

Claude Code's Artifact tool needs a claude.ai login, which a session routed
through CLIProxy does not have. This CLI calls the same undocumented endpoints
(api.anthropic.com/api/frame/*) with the claude.ai OAuth token CLIProxy keeps.
claude-mcp-headers resolves that token and the account.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
import uuid
from dataclasses import asdict, dataclass
from enum import Enum
from pathlib import Path
from typing import Annotated, Any, Callable, Generic, NoReturn, Optional, TypeVar, Union

import typer

VERSION = "4.0.0"
USER_AGENT = f"claude-artifacts/{VERSION}"
BASE58 = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"

T = TypeVar("T")

# ---------------------------------------------------------------- failures
# Expected failures are values. Commands are the only place that turns one into
# an exit code; the shared base exists so that check can narrow the type.


class Failure:
    @property
    def message(self) -> str:
        raise NotImplementedError


@dataclass(frozen=True)
class InvalidArtifactId(Failure):
    text: str

    @property
    def message(self) -> str:
        return f"not an artifact link or id: {self.text}"


@dataclass(frozen=True)
class UnsupportedFile(Failure):
    path: str
    reason: str

    @property
    def message(self) -> str:
        return f"{self.path}: {self.reason}"


@dataclass(frozen=True)
class NoToken(Failure):
    detail: str

    @property
    def message(self) -> str:
        return f"no claude.ai token: {self.detail} (see claude-mcp-headers --help)"


@dataclass(frozen=True)
class RequestFailed(Failure):
    operation: str
    status: Optional[int]
    detail: str

    @property
    def message(self) -> str:
        status = f"HTTP {self.status}" if self.status is not None else "network error"
        return f"{self.operation}: {status}: {self.detail}"


@dataclass(frozen=True)
class MalformedResponse(Failure):
    operation: str

    @property
    def message(self) -> str:
        return f"{self.operation}: the API answered in an unexpected shape"


@dataclass(frozen=True)
class Conflict(Failure):
    artifact: ArtifactId

    @property
    def message(self) -> str:
        return f"{self.artifact.link} changed since it was read; read it again and redo the change"


@dataclass(frozen=True)
class UnknownType(Failure):
    name: str

    @property
    def message(self) -> str:
        return f"no type named {self.name!r}; `claude-artifacts types` lists the ones this account has"


@dataclass(frozen=True)
class SharingNotAllowed(Failure):
    audience: Audience

    @property
    def message(self) -> str:
        return f"this account or organization does not allow {self.audience.value} sharing"


ApiFailure = Union[RequestFailed, MalformedResponse, Conflict]


@dataclass(frozen=True)
class Ok(Generic[T]):
    """A success. Wrapping it keeps `Ok[T] | Failure` unambiguous for type checkers."""

    value: T

# ------------------------------------------------------------------ domain


@dataclass(frozen=True)
class ArtifactId:
    """An artifact's uuid. Short links (claude.ai/artifact/<id>) are it in base58."""

    value: uuid.UUID

    @staticmethod
    def parse(text: str) -> Ok[ArtifactId] | InvalidArtifactId:
        segment = urllib.parse.urlsplit(text.strip()).path.rstrip("/").rsplit("/", 1)[-1]
        try:
            return Ok(ArtifactId(uuid.UUID(segment)))
        except ValueError:
            pass
        if not 0 < len(segment) <= 22 or any(c not in BASE58 for c in segment):
            return InvalidArtifactId(text)
        n = 0
        for c in segment:
            n = n * 58 + BASE58.index(c)
        return Ok(ArtifactId(uuid.UUID(int=n))) if n < 1 << 128 else InvalidArtifactId(text)

    @property
    def short(self) -> str:
        n, digits = self.value.int, ""
        while n:
            n, r = divmod(n, 58)
            digits = BASE58[r] + digits
        return digits.rjust(22, BASE58[0])

    @property
    def link(self) -> str:
        return f"https://claude.ai/artifact/{self.short}"

    def __str__(self) -> str:
        return str(self.value)


class Audience(str, Enum):
    private = "private"
    org = "org"

    @property
    def read_mode(self) -> str:
        return "owner" if self is Audience.private else "org"


class Scope(str, Enum):
    mine = "mine"
    shared = "shared"
    all = "all"


@dataclass(frozen=True)
class Page:
    """A single-file HTML artifact."""

    html: str
    title: str

    @staticmethod
    def read(file: Path) -> Ok[Page] | UnsupportedFile:
        if file.suffix.lower() not in (".html", ".htm"):
            return UnsupportedFile(str(file), "only .html pages; use push for typed artifacts")
        try:
            html = file.read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError) as error:
            return UnsupportedFile(str(file), str(error))
        found = re.search(r"<title[^>]*>(.*?)</title>", html, re.IGNORECASE | re.DOTALL)
        return Ok(Page(html, (" ".join(found.group(1).split()) if found else "") or file.stem))


TEXT_TYPES = {
    ".html": "text/html",
    ".htm": "text/html",
    ".css": "text/css",
    ".js": "text/javascript",
    ".json": "application/json",
    ".md": "text/markdown",
    ".txt": "text/plain",
    ".svg": "image/svg+xml",
}


@dataclass(frozen=True)
class FileContent:
    text: str
    content_type: str


# A path mapped to None deletes that file from the artifact.
Manifest = dict[str, Optional[FileContent]]


def read_manifest(directory: Path, removals: list[str]) -> Ok[Manifest] | UnsupportedFile:
    """Every visible file under directory, at its relative path, plus removals."""
    if not directory.is_dir():
        return UnsupportedFile(str(directory), "not a directory")
    manifest: Manifest = {}
    for file in sorted(p for p in directory.rglob("*") if p.is_file()):
        parts = file.relative_to(directory).parts
        if any(part.startswith(".") for part in parts):
            continue
        rel = "/".join(parts)
        content_type = TEXT_TYPES.get(file.suffix.lower())
        if content_type is None:
            return UnsupportedFile(rel, f"only text files ({', '.join(sorted(TEXT_TYPES))})")
        try:
            manifest[rel] = FileContent(file.read_text(encoding="utf-8"), content_type)
        except UnicodeDecodeError:
            return UnsupportedFile(rel, "not UTF-8")
    for path in removals:
        manifest[path] = None
    return Ok(manifest) if manifest else UnsupportedFile(str(directory), "no files to send")


@dataclass(frozen=True)
class Card:
    """What the gallery card shows besides the title. None keeps the server's default."""

    description: Optional[str] = None
    icon: Optional[str] = None
    label: Optional[str] = None


@dataclass(frozen=True)
class Artifact:
    id: ArtifactId
    title: str
    live: str
    history: tuple[str, ...]
    files: tuple[str, ...]
    audience: str
    author: Optional[str]
    created: str
    updated: str
    views: int
    asset_token: str


@dataclass(frozen=True)
class Summary:
    id: ArtifactId
    title: str
    audience: str
    rel: str
    updated: str
    description: Optional[str]


@dataclass(frozen=True)
class Version:
    version: str
    live: bool
    title: str
    created: str


@dataclass(frozen=True)
class ArtifactType:
    id: ArtifactId
    title: str
    description: str

    def matches(self, name: str) -> bool:
        wanted = ArtifactId.parse(name)
        return name.strip().lower() == self.title.lower() or (isinstance(wanted, Ok) and wanted.value == self.id)


@dataclass(frozen=True)
class Published:
    id: ArtifactId
    version: str


# ---------------------------------------------------------------- adapters


class Redacted(Generic[T]):
    """Keeps a secret out of reprs, logs and tracebacks."""

    def __init__(self, value: T) -> None:
        self._value = value

    def reveal(self) -> T:
        return self._value

    def __repr__(self) -> str:
        return "Redacted(<hidden>)"


def read_token(helper: Path) -> Ok[Redacted[str]] | NoToken:
    """The Authorization header claude-mcp-headers prints for the configured account."""
    try:
        done = subprocess.run([str(helper)], capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired) as error:
        return NoToken(str(error))
    if done.returncode != 0:
        return NoToken(done.stderr.strip() or f"exit {done.returncode}")
    try:
        return Ok(Redacted(str(json.loads(done.stdout)["Authorization"])))
    except (ValueError, KeyError, TypeError):
        return NoToken("claude-mcp-headers printed no Authorization header")


class FrameApi:
    """The undocumented frame API behind Claude Code's Artifact tool.

    Raw JSON stays in here: every method returns parsed values or a failure.
    """

    def __init__(self, base: str, token: Redacted[str]) -> None:
        self._base = base.rstrip("/")
        self._token = token

    def _call(self, operation: str, method: str, path: str, body: Any = None, headers: Optional[dict[str, str]] = None) -> Any | RequestFailed:
        request = urllib.request.Request(
            f"{self._base}{path}",
            method=method,
            data=None if body is None else json.dumps(body).encode(),
            headers={
                "Authorization": self._token.reveal(),
                "X-Frame-CP": "go",
                "content-type": "application/json",
                "User-Agent": USER_AGENT,
                **(headers or {}),
            },
        )
        try:
            with urllib.request.urlopen(request, timeout=60) as response:
                raw = response.read()
        except urllib.error.HTTPError as error:
            return RequestFailed(operation, error.code, error.read()[:300].decode(errors="replace"))
        except (urllib.error.URLError, TimeoutError) as error:
            return RequestFailed(operation, None, str(getattr(error, "reason", error)))
        try:
            return json.loads(raw) if raw.strip() else None
        except ValueError:
            return RequestFailed(operation, None, "response is not JSON")

    def _parsed(self, operation: str, raw: Any, parse: Callable[[Any], T]) -> Ok[T] | ApiFailure:
        if isinstance(raw, RequestFailed):
            return raw
        try:
            return Ok(parse(raw))
        except (KeyError, TypeError, ValueError):
            return MalformedResponse(operation)

    def artifact(self, id: ArtifactId) -> Ok[Artifact] | ApiFailure:
        def parse(raw: Any) -> Artifact:
            return Artifact(
                id=id,
                title=raw["title"],
                live=raw["live"],
                history=tuple(raw["history"]),
                files=tuple(f["path"] for f in raw["files"]),
                audience=(raw.get("perm") or {}).get("mode") or "owner",
                author=(raw.get("author") or {}).get("email"),
                created=raw["created_at"],
                updated=raw["updated_at"],
                views=int(raw.get("view_count") or 0),
                asset_token=raw["assetToken"],
            )

        return self._parsed("read", self._call("read", "GET", f"/{id}"), parse)

    def summaries(self) -> Ok[list[Summary]] | ApiFailure:
        def parse(raw: Any) -> list[Summary]:
            return [
                Summary(
                    id=ArtifactId(uuid.UUID(r["slug"])),
                    title=r["title"],
                    audience=r.get("audience") or "owner",
                    rel=r["rel"],
                    updated=r.get("updatedAt") or r["created_at"],
                    description=r.get("description"),
                )
                for r in raw["frames"]
            ]

        return self._parsed("list", self._call("list", "GET", "/frames?limit=200"), parse)

    def deploy_page(self, page: Page, card: Card, target: Optional[Artifact]) -> Ok[Published] | ApiFailure:
        body = {
            "title": page.title,
            "favicon": "*",
            "content": page.html,
            **({"slug": str(target.id), "baseVersion": target.live} if target else {}),
            **{k: v for k, v in asdict(card).items() if v is not None},
        }
        return self._deploy(body, target)

    def deploy_files(self, manifest: Manifest, target: Artifact, label: Optional[str]) -> Ok[Published] | ApiFailure:
        body = {
            "slug": str(target.id),
            "title": target.title,
            "baseVersion": target.live,
            # Without "patch", files the manifest leaves out are dropped.
            "mode": "patch",
            "manifest": {path: None if f is None else {"content": f.text, "contentType": f.content_type} for path, f in manifest.items()},
            **({"label": label} if label else {}),
        }
        return self._deploy(body, target)

    def _deploy(self, body: dict[str, Any], target: Optional[Artifact]) -> Ok[Published] | ApiFailure:
        raw = self._call("publish", "POST", "/deploy/direct", body)
        if isinstance(raw, RequestFailed) and raw.status == 409 and target is not None:
            return Conflict(target.id)
        return self._parsed("publish", raw, lambda r: Published(ArtifactId(uuid.UUID(r["slug"])), r["version"]))

    def share(self, id: ArtifactId, audience: Audience) -> Ok[None] | ApiFailure | SharingNotAllowed:
        current = self._call("share", "GET", f"/perm/{id}")
        if isinstance(current, RequestFailed):
            return current
        try:
            read = current.get("read") or {}
            if (read.get("mode") or "owner") == audience.read_mode:
                return Ok(None)
            allowed = current.get("assignableReadModes")
            if allowed is not None and audience.read_mode not in allowed:
                return SharingNotAllowed(audience)
            users = read.get("users") or [] if audience is Audience.org else []
            etag = current["version"]
        except (AttributeError, KeyError, TypeError):
            return MalformedResponse("share")
        done = self._call("share", "PATCH", f"/perm/{id}", {"read": {"mode": audience.read_mode, "users": users}}, {"If-Match": etag})
        return done if isinstance(done, RequestFailed) else Ok(None)

    def rename(self, id: ArtifactId, title: str) -> Ok[None] | RequestFailed:
        done = self._call("rename", "POST", f"/retitle/{id}", {"title": title})
        return done if isinstance(done, RequestFailed) else Ok(None)

    def pin(self, id: ArtifactId, pinned: bool) -> Ok[None] | RequestFailed:
        done = self._call("pin" if pinned else "unpin", "POST" if pinned else "DELETE", f"/favorite/{id}")
        return done if isinstance(done, RequestFailed) else Ok(None)

    def delete(self, id: ArtifactId) -> Ok[None] | RequestFailed:
        done = self._call("delete", "DELETE", f"/{id}")
        return done if isinstance(done, RequestFailed) else Ok(None)

    def versions(self, id: ArtifactId) -> Ok[list[Version]] | ApiFailure:
        def parse(raw: Any) -> list[Version]:
            details = raw.get("versions") or {}
            return [
                Version(v, v == raw.get("live"), (details.get(v) or {}).get("title", ""), (details.get(v) or {}).get("created_at", ""))
                for v in raw["history"]
            ]

        return self._parsed("versions", self._call("versions", "GET", f"/versions/{id}"), parse)

    def comment_threads(self, id: ArtifactId) -> Ok[list[Any]] | ApiFailure:
        return self._parsed("comments", self._call("comments", "GET", f"/comments/{id}?names=1"), lambda r: list(r.get("threads") or []))

    def source(self, artifact: Artifact, path: str) -> Ok[bytes] | RequestFailed:
        url = (
            f"https://{artifact.id}.frame.claudeusercontent.com/_f/{artifact.live}/_src/"
            f"{urllib.parse.quote(path)}?__frame_t={urllib.parse.quote(artifact.asset_token)}"
        )
        # The content host answers 403 to requests without a User-Agent.
        try:
            with urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": USER_AGENT}), timeout=60) as response:
                return Ok(response.read())
        except urllib.error.HTTPError as error:
            return RequestFailed(f"read {path}", error.code, "")
        except (urllib.error.URLError, TimeoutError) as error:
            return RequestFailed(f"read {path}", None, str(getattr(error, "reason", error)))

    def types(self) -> Ok[list[ArtifactType]] | ApiFailure:
        def parse(raw: Any) -> list[ArtifactType]:
            return [ArtifactType(ArtifactId(uuid.UUID(t["slug"])), t["title"], t.get("description") or "") for t in raw["types"]]

        return self._parsed("types", self._call("types", "GET", "/types"), parse)

    def type_file(self, type_: ArtifactType, path: str) -> Ok[str] | ApiFailure:
        quoted = "/".join(urllib.parse.quote(part) for part in path.split("/"))
        return self._parsed("type-skill", self._call("type-skill", "GET", f"/types/{type_.id}/files/{quoted}"), lambda r: str(r["text"]))

    def create(self, type_: ArtifactType, title: str) -> Ok[Published] | ApiFailure:
        raw = self._call("create", "POST", f"/types/{type_.id}/create", {"target_type_version": None, "title": title})
        return self._parsed("create", raw, lambda r: Published(ArtifactId(uuid.UUID(r["slug"])), r["version"]))


# ---------------------------------------------------------------- commands

app = typer.Typer(help=__doc__, no_args_is_help=True, add_completion=False, pretty_exceptions_enable=False)


class Context:
    """Builds the API on first use, so --help needs no token."""

    def __init__(self, build: Callable[[], FrameApi]) -> None:
        self._build = build
        self._api: Optional[FrameApi] = None

    def api(self) -> FrameApi:
        if self._api is None:
            self._api = self._build()
        return self._api


def expect(result: Union[Ok[T], Failure]) -> T:
    """Unwrap a success, or report the failure and exit 1."""
    if isinstance(result, Failure):
        stop(result.message)
    return result.value


def stop(message: str) -> NoReturn:
    typer.echo(f"claude-artifacts: {message}", err=True)
    raise typer.Exit(1)


def api_of(ctx: typer.Context) -> FrameApi:
    context = ctx.find_object(Context)
    if context is None:
        raise RuntimeError("main() sets the command context before any command runs")
    return context.api()


def emit(as_json: bool, data: Any, lines: list[str], note: Optional[str] = None) -> None:
    """Print data as JSON, or the note on stderr and the lines on stdout."""
    if as_json:
        typer.echo(json.dumps(data, indent=2, ensure_ascii=False))
        return
    if note:
        typer.echo(note, err=True)
    for line in lines:
        typer.echo(line)


def find_type(api: FrameApi, name: str) -> ArtifactType:
    return next((t for t in expect(api.types()) if t.matches(name)), None) or stop(UnknownType(name).message)


def parse_id(text: str) -> ArtifactId:
    return expect(ArtifactId.parse(text))


ArtifactArg = Annotated[
    ArtifactId,
    typer.Argument(
        parser=parse_id,
        metavar="ARTIFACT",
        help="A claude.ai/artifact/<id> or claude.ai/code/artifact/<uuid> link, or the bare id.",
        show_default=False,
    ),
]
TypeArg = Annotated[str, typer.Argument(metavar="TYPE", help="Type title, such as Slides, or its link.")]
FileArg = Annotated[Path, typer.Argument(help="The .html page.", show_default=False)]
JsonOpt = Annotated[bool, typer.Option("--json", help="Print JSON.")]
TitleOpt = Annotated[Optional[str], typer.Option(help="Title. Defaults to the page's <title>, then the file name.")]
DescriptionOpt = Annotated[Optional[str], typer.Option(help="One sentence for the gallery card.")]
IconOpt = Annotated[Optional[str], typer.Option(help="One generic word for the tab icon, such as chart or book.")]
LabelOpt = Annotated[Optional[str], typer.Option(help="Short name for this version.")]
ShareOpt = Annotated[Optional[Audience], typer.Option(help="Audience after publishing.")]
PinOpt = Annotated[bool, typer.Option("--pin", help="Pin to the claude.ai sidebar.")]


def finish_publish(
    ctx: typer.Context, page: Page, published: Published, verb: str, share: Optional[Audience], pin: bool, as_json: bool
) -> None:
    api = api_of(ctx)
    if share is not None:
        expect(api.share(published.id, share))
    if pin:
        expect(api.pin(published.id, pinned=True))
    emit(
        as_json,
        {"url": published.id.link, "id": str(published.id), "title": page.title, "version": published.version},
        [published.id.link],
        f'{verb} "{page.title}" ({published.version})',
    )


@app.command()
def publish(
    ctx: typer.Context,
    file: FileArg,
    title: TitleOpt = None,
    description: DescriptionOpt = None,
    icon: IconOpt = None,
    label: LabelOpt = None,
    share: ShareOpt = None,
    pin: PinOpt = False,
    as_json: JsonOpt = False,
) -> None:
    """Publish a page as a new artifact. Prints its link; new artifacts start private."""
    page = expect(Page.read(file))
    page = Page(page.html, title or page.title)
    published = expect(api_of(ctx).deploy_page(page, Card(description, icon, label), target=None))
    finish_publish(ctx, page, published, "Created", share, pin, as_json)


@app.command()
def update(
    ctx: typer.Context,
    artifact: ArtifactArg,
    file: FileArg,
    title: TitleOpt = None,
    description: DescriptionOpt = None,
    icon: IconOpt = None,
    label: LabelOpt = None,
    share: ShareOpt = None,
    pin: PinOpt = False,
    as_json: JsonOpt = False,
) -> None:
    """Publish a page as a new version of an existing artifact, same link."""
    api = api_of(ctx)
    page = expect(Page.read(file))
    page = Page(page.html, title or page.title)
    target = expect(api.artifact(artifact))
    if description is None:
        # A deploy without a description clears it; resend the current one.
        description = next((s.description for s in expect(api.summaries()) if s.id == artifact), None)
    published = expect(api.deploy_page(page, Card(description, icon, label), target))
    finish_publish(ctx, page, published, "Updated", share, pin, as_json)


@app.command()
def push(
    ctx: typer.Context,
    artifact: ArtifactArg,
    directory: Annotated[Path, typer.Argument(help="Folder whose files land at the same paths, such as one holding project/.")],
    remove: Annotated[Optional[list[str]], typer.Option("--remove", help="Path to delete from the artifact; repeatable.")] = None,
    label: LabelOpt = None,
    as_json: JsonOpt = False,
) -> None:
    """Send a folder's files to an artifact. Files not sent stay as they are."""
    api = api_of(ctx)
    manifest = expect(read_manifest(directory, remove or []))
    target = expect(api.artifact(artifact))
    published = expect(api.deploy_files(manifest, target, label))
    emit(
        as_json,
        {"url": artifact.link, "version": published.version, "files": sorted(manifest)},
        [artifact.link],
        f'Pushed {len(manifest)} changes to "{target.title}" ({published.version})',
    )


@app.command("list")
def list_(
    ctx: typer.Context,
    scope: Annotated[Scope, typer.Option(help="Your artifacts, ones shared with you, or both.")] = Scope.mine,
    as_json: JsonOpt = False,
) -> None:
    """List artifacts, most recently updated first."""
    rows = sorted(
        (s for s in expect(api_of(ctx).summaries()) if scope is Scope.all or s.rel == scope.value),
        key=lambda s: s.updated,
        reverse=True,
    )
    emit(
        as_json,
        [{"url": s.id.link, "title": s.title, "audience": s.audience, "updated": s.updated} for s in rows],
        [f"{s.updated}\t{s.audience}\t{s.id.link}\t{s.title}" for s in rows],
    )


@app.command()
def read(
    ctx: typer.Context,
    artifact: ArtifactArg,
    content: Annotated[bool, typer.Option("--content", help="Print the published source instead.")] = False,
    path: Annotated[str, typer.Option(help="File to print with --content.")] = "index.html",
    as_json: JsonOpt = False,
) -> None:
    """Show an artifact's metadata, or its published source with --content."""
    api = api_of(ctx)
    found = expect(api.artifact(artifact))
    if content:
        sys.stdout.buffer.write(expect(api.source(found, path)))
        return
    info = {
        "url": found.id.link,
        "title": found.title,
        "audience": found.audience,
        "version": found.live,
        "versions": len(found.history),
        "files": list(found.files),
        "author": found.author,
        "created": found.created,
        "updated": found.updated,
        "views": found.views,
    }
    emit(as_json, info, [f"{k}: {', '.join(v) if isinstance(v, list) else v}" for k, v in info.items()])


