#!/bin/bash
# bx: Boat sandboxes for development. Builds the saved snapshots that task sandboxes
# start from, and creates, lists and removes those sandboxes together with their herdr
# machine entries. Everything else is plain `boat`.
set -euo pipefail

VERSION="0.9.0"

# A stopped sandbox older than this is garbage for `bx gc`.
GC_DAYS=3
# How long a sandbox from `bx new` stays on before Boat stops it.
AUTO_STOP_HOURS=4
# Its sibling, which owns the Tailscale API; ~/.local/bin may not have it yet.
tailnet=$(dirname "$(readlink -f "$0")")/tailnet

usage() {
  cat <<'EOF'
bx - Boat sandboxes for development

USAGE
    bx new --snapshot <snapshot> --name <name> [--type <size>]
                            Start a sandbox from <snapshot>, log gh in with your token,
                            and add it to herdr under <name>. <size> is small, default,
                            large or xlarge (see `boat new --help`); large if omitted
    bx teleport --session <id> [--name <name>] [--snapshot <snapshot>] [--type <size>]
                            Move Claude Code session <id> to a new sandbox and resume it
                            in herdr: its repo as it is on disk (local commits and
                            uncommitted changes included, nothing pushed), the transcript
                            and the scratchpad, at the same paths as on this Mac. The
                            snapshot defaults to the one whose repo list has the repo
    bx ls                   List sandboxes: name, id, state, age, machine time cost so
                            far, whether herdr has them
    bx list                 List snapshots to start from: built or not, age, size, repos
    bx rm <name|id>         Remove a sandbox from herdr and delete it
    bx tailnet <name|id>    Join a sandbox to the tailnet again. Tailscale drops a box
                            that stays stopped for long; `bx new` joins it the first time
    bx gc [--yes]           Find sandboxes stopped for over 3 days and herdr entries whose
                            sandbox is gone; delete them after asking, or at once with --yes
    bx bake dev             Build the `dev` snapshot: bare Ubuntu plus bootstrap/linux.sh
    bx bake <snapshot>      Build <snapshot> from `dev`: clone the repos listed in
                            ~/.config/bx/<snapshot> into ~/<snapshot>/ and install their
                            dependencies
    bx bake --all           Build every snapshot that has a repo list, one after another.
                            A failed one is named at the end and does not stop the rest
    bx update <snapshot>    Bring <snapshot> to skill-issue's current main in minutes, without
                            a bake: re-run the bootstrap on a sandbox from it and save it
                            under the same name. Its repos keep their baked commit
    bx --help | --version

Sandbox names are unique, so a name works wherever an id does. `ssh` and herdr use the id
(`ssh bx_<id>`, or `bx_<id>.wake` to resume a stopped one).

A box from `bx new` joins your tailnet under its name, tagged tag:box, with a single-use
key that `tailnet key` mints for it. Your devices reach its ports there, such as a dev
server at http://<name>:3000 from your phone; the box cannot reach them or other boxes
(tailscale/policy.hujson). `bx rm` and `bx gc` delete the box's node from the tailnet.

Snapshots hold no credentials. A sandbox from `bx new` gets Boat's agent logins from your
default Boat environment, plus your `gh auth token` and git name and email, so agents can
commit, push and open pull requests. Deleting the sandbox deletes them.

A snapshot's repo list, ~/.config/bx/<snapshot>, has one owner/repo per line. It stays on this Mac, so private repo names
never reach this public repository. `bx bake` clones with your `gh auth token`, sent over
SSH for the clone only: no token is written to the build sandbox or kept in the snapshot.
Each repo gets: git submodules, `pnpm install --frozen-lockfile` when it has a pnpm
lockfile, Playwright's Chromium and its system libraries for each Playwright it installs,
and `make setup` when its Makefile has that target. Then ~/.config/bx/<snapshot>.sh, if it
exists, runs on the build sandbox in ~/<snapshot>/: put what the repos need beyond that
there, such as starting a Docker stack once so its images are in the snapshot.

Build sandboxes get your Boat environment like any other: a sandbox made with --no-env
passes "no logins" on to every sandbox started from its snapshot. Before saving, the bake
deletes the login files Boat wrote, so the snapshot holds none. A failed build keeps its
sandbox for inspection and prints how to delete it.
EOF
}

die() { echo "bx: $*" >&2; exit 1; }
log() { echo "bx: $*" >&2; }

# Every sandbox, in any state, as JSON lines: {id, name, state, createdAt, stoppedAt}.
sandboxes() {
  boat list --all --json | jq -c '.sandboxes[] | {id, name, state, hydrated, createdAt, stoppedAt}'
}

# herdr machine entries that point at a Boat sandbox, as JSON lines.
herdr_boxes() {
  herdr machine list --json | jq -c '.[] | select(.target | startswith("bx_"))'
}

# Prints the id of the sandbox named or numbered $1.
resolve() {
  case $1 in bx_*) echo "$1"; return ;; esac
  local ids
  ids=$(sandboxes | jq -r --arg n "$1" 'select(.name == $n) | .id')
  [ -n "$ids" ] || die "no sandbox named $1"
  [ "$(printf '%s\n' "$ids" | wc -l)" -eq 1 ] || die "several sandboxes are named $1; use the id"
  echo "$ids"
}

# Removes the herdr entries for sandbox $1, if any.
herdr_forget() {
  local profile
  for profile in $(herdr_boxes | jq -r --arg id "$1" 'select(.target == $id) | .id'); do
    herdr machine remove "$profile" >/dev/null
  done
}

# Joins sandbox $1 to the tailnet as $2 with a key minted for it alone. The key travels
# on stdin into a root-only file in /run, which is memory, and is deleted once used:
# never in a command line or on disk. A failed join leaves the box usable, off the tailnet.
tailnet_join() {
  local id=$1 name=$2 key
  if ! key=$("$tailnet" key); then
    log "$id: could not mint a Tailscale key; staying off the tailnet. Retry: bx tailnet $name"
    return 0
  fi
  log "$id: joining the tailnet as $name"
  local status=0
  # shellcheck disable=SC2016 # Expanded on the sandbox.
  printf '%s\n' "$key" | ssh -o BatchMode=yes "$id" "
    set -e
    ts=\$HOME/.nix-profile/bin/tailscale
    systemctl cat tailscaled.service >/dev/null 2>&1 || exit 3
    # tailscaled starts once Boat has restored /nix.
    for _ in \$(seq 60); do [ -S /run/tailscale/tailscaled.sock ] && break; sleep 2; done
    trap 'sudo rm -f /run/tailscale/authkey' EXIT
    sudo install -m 600 /dev/stdin /run/tailscale/authkey
    sudo \$ts up --auth-key=file:/run/tailscale/authkey --hostname=$(printf %q "$name") --timeout=60s >/dev/null
  " || status=$?
  case $status in
    0) ;;
    3) log "$id: its snapshot predates Tailscale; staying off the tailnet. Rebuild it: bx update <snapshot>" ;;
    *) log "could not join $id to the tailnet; run: bx tailnet $name" ;;
  esac
}

new() {
  local snapshot=$1 name=$2 type=$3 id
  if ! boat snapshots --json | jq -e --arg n "$snapshot" '.named[] | select(.name == $n)' >/dev/null; then
    die "no snapshot $snapshot. See bx list"
  fi
  if sandboxes | jq -e --arg n "$name" 'select(.name == $n)' >/dev/null; then
    die "a sandbox named $name exists; pick another name or bx rm $name"
  fi
  log "starting $name from $snapshot ($type), on for ${AUTO_STOP_HOURS}h"
  # Boat's auto-stop counts from the create, not from activity: with its default hour, an
  # agent still working after an hour is stopped mid-task.
  id=$(boat new --from "$snapshot" --name "$name" --type "$type" --ttl $((AUTO_STOP_HOURS * 3600)) --json \
    | jq -r 'select(.event == "ready") | .id' | grep .) \
    || die "could not create $name from $snapshot"
  log "$id: logging gh in"
  # The token travels on stdin only, never in a command line or Boat's variables. It goes
  # straight into hosts.yml: `gh auth login` also rewrites config.yml, which home-manager
  # owns read-only.
  gh auth token | ssh -o BatchMode=yes "$id" "
    set -e
    read -r token
    mkdir -p ~/.config/gh
    (umask 077; printf 'github.com:\n    oauth_token: %s\n    git_protocol: https\n    user: %s\n' \"\$token\" $(printf %q "$(gh api user -q .login)") > ~/.config/gh/hosts.yml)
    gh auth status >/dev/null
    git config -f ~/.gitconfig.local user.name $(printf %q "$(git config user.name)")
    git config -f ~/.gitconfig.local user.email $(printf %q "$(git config user.email)")
  " || die "could not log gh in on $id. Delete: bx rm $id"
  wait_hydrated "$id"
  # Only after the restore: `machine add` starts the box's herdr server, and a server
  # started earlier listens on ~/.config/herdr/herdr.sock inside the FUSE layer that the
  # restore removes, so `herdr --machine` gets ConnectionRefused.
  log "$id: adding to herdr as $name"
  herdr machine add "$id" --label "$name" >/dev/null \
    || log "herdr machine add failed; run: herdr machine add $id --label $name"
  tailnet_join "$id" "$name"
  ready_check "$id" "$snapshot" || die "$id is not ready (see above). Inspect: ssh $id. Delete: bx rm $id"
  echo "$id"
  log "ready: ssh $id"
}

# Boat restores a sandbox's disk in the background after `ready`, and what starts during
# that window can break when it ends (see bootstrap/nix-after-restore.service). Boat's
# signal for the end is `hydrated`. It took 1 to 8 minutes in our measurements.
wait_hydrated() {
  local info i=0
  while [ $i -lt 200 ]; do
    info=$(boat info "$1" --json)
    [ "$(echo "$info" | jq -r .sandbox.hydrated)" = true ] && return
    [ $((i % 10)) -eq 0 ] && log "$1: restoring the disk ($(echo "$info" | jq -r '.sandbox.hydration.percent // 0 | floor')%)"
    sleep 3
    i=$((i + 1))
  done
  die "$1 was still restoring after 10 minutes. Delete: bx rm $1"
}

# What `ready` means for a task sandbox. Run after the restore has ended, so a pass here
# stays a pass. Prints each failure.
ready_check() {
  ssh -o BatchMode=yes "$1" "
    fails=0
    check() { name=\$1; shift; \"\$@\" >/dev/null 2>&1 || { echo \"bx: not ready: \$name\" >&2; fails=1; }; }
    nix_up() {
      for _ in \$(seq 15); do /nix/var/nix/profiles/default/bin/nix store ping && return; sleep 2; done
      return 1
    }
    check 'nix daemon answers' nix_up
    check 'gh is logged in' gh auth status
    # find, not a glob: the remote shell is zsh, which fails on a glob that matches
    # nothing, and dev has no ~/dev.
    for repo in \$(find ~/$2 -mindepth 1 -maxdepth 1 -type d 2>/dev/null); do
      [ -d \"\$repo/.git\" ] || continue
      check \"git fetch in \$repo\" git -C \"\$repo\" fetch --quiet origin
      if [ -f \"\$repo/pnpm-lock.yaml\" ]; then
        # Online allowed: pnpm fetches its own pinned version into ~/.cache, which Boat never
        # saves. The packages come from the store in the snapshot.
        check \"pnpm install in \$repo\" sh -c \"cd '\$repo' && pnpm install --frozen-lockfile --prefer-offline\"
      fi
    done
    exit \$fails
  "
}

# When bx last saved each snapshot. Boat's createdAt is when the name was first used: a
# save under the same name replaces the snapshot and keeps that date.
# TODO: reported to Boat with `boat feedback` on 2026-11-03. Once `boat snapshots --json`
# shows a replaced snapshot's save time, delete SAVED_DIR and read Boat's date again.
SAVED_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/bx/saved

# bx's snapshots are `dev` and one per repo list in ~/.config/bx.
list_snapshots() {
  local built saved names=dev f snapshot repos
  built=$(boat snapshots --json | jq -c '.named')
  saved=$(for f in "$SAVED_DIR"/*; do [ -f "$f" ] && jq -n --arg n "${f##*/}" --arg t "$(cat "$f")" '{($n): $t}'; done | jq -s 'add // {}')
  for f in "$HOME"/.config/bx/*; do
    case $f in *.sh) ;; *) [ -f "$f" ] && names="$names $(basename "$f")" ;; esac
  done
  {
    printf 'SNAPSHOT\tBUILT\tSIZE\tREPOS\n'
    for snapshot in $names; do
      repos="(bootstrap only)"
      [ "$snapshot" = dev ] || repos=$(grep -v -e '^#' -e '^$' "$HOME/.config/bx/$snapshot" | paste -sd, -)
      echo "$built" | jq -r --arg n "$snapshot" --arg r "$repos" --argjson saved "$saved" '
        (map(select(.name == $n)) | first) as $s
        | if $s == null then [$n, "not built", "-", $r]
          else [$n, ((now - ($saved[$n] // $s.createdAt | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601)) / 86400
                     | if . < 1 then "today" else "\(floor)d ago" end),
                "\($s.sizeBytes / 1e9 * 10 | round / 10) GB", $r] end | @tsv'
    done
  } | column -t -s "$(printf '\t')"
}

ls_boxes() {
  local herdr_ids costs
  herdr_ids=$(herdr_boxes | jq -r '.target' | tr '\n' ' ')
  # One API call per sandbox, so eight at a time. A sandbox whose usage cannot be read
  # shows "-".
  costs=$(sandboxes | jq -r .id | xargs -P 8 -I{} boat usage {} --json 2>/dev/null \
    | jq -s 'map({(.sandboxId): .dollars}) | add // {}')
  sandboxes | jq -r --arg herdr " $herdr_ids" --argjson costs "$costs" '
    def age: (now - (.createdAt | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601)) / 3600
      | if . < 48 then "\(floor)h" else "\(. / 24 | floor)d" end;
    # A restored disk streams in after the start: until then, reads are slower.
    .id as $id
    | [.name, .id, (if .hydrated == false and .state != "stopped" then "\(.state), hydrating" else .state end), age,
       (if $costs[$id] == null then "-" else "$\($costs[$id] * 100 | round / 100)" end),
       (if ($herdr | contains(" \($id) ")) then "herdr" else "" end)] | @tsv' \
    | (printf 'NAME\tID\tSTATE\tAGE\tCOST\tHERDR\n'; cat) | column -t -s "$(printf '\t')"
}

name_of() {
  sandboxes | jq -r --arg id "$1" 'select(.id == $id) | .name'
}

rm_box() {
  local id
  id=$(resolve "$1")
  herdr_forget "$id"
  # Else the node lingers offline for a while, and a new box with this name gets <name>-1.
  "$tailnet" forget "$(name_of "$id")" || log "could not remove $id from the tailnet"
  boat delete "$id" --yes >/dev/null
  rm -f "${XDG_CACHE_HOME:-$HOME/.cache}/boat-resolve/$id.json"
  log "deleted $id"
}

gc() {
  local yes=$1 stale gone line answer=y
  stale=$(sandboxes | jq -r --argjson days "$GC_DAYS" '
    select(.state == "stopped" and .stoppedAt != null)
    | select((now - (.stoppedAt | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601)) > $days * 86400)
    | "\(.id)\t\(.name)"')
  local live
  live=" $(sandboxes | jq -r .id | tr '\n' ' ')"
  gone=$(herdr_boxes | jq -r --arg live "$live " \
    '.target as $t | select($live | contains(" \($t) ") | not) | $t')
  local nodes
  nodes=$("$tailnet" boxes | sort -u | grep -vxF -f <(sandboxes | jq -r .name)) || nodes=''
  if [ -z "$stale" ] && [ -z "$gone" ] && [ -z "$nodes" ]; then log "nothing to clean"; return; fi
  [ -z "$stale" ] || { echo "Sandboxes stopped for over $GC_DAYS days, to delete:"; printf '%s\n' "$stale" | sed 's/^/  /'; }
  [ -z "$gone" ] || { echo "herdr entries whose sandbox is gone, to remove:"; printf '%s\n' "$gone" | sed 's/^/  /'; }
  [ -z "$nodes" ] || { echo "tag:box nodes on the tailnet whose sandbox is gone, to delete:"; printf '%s\n' "$nodes" | sed 's/^/  /'; }
  if [ "$yes" != yes ]; then
    printf 'Proceed? [y/N] '
    read -r answer
  fi
  [ "$answer" = y ] || { log "nothing changed"; return; }
  for line in $(printf '%s\n' "$stale" | cut -f1); do rm_box "$line"; done
  for line in $gone; do herdr_forget "$line"; done
  # shellcheck disable=SC2086 # One hostname per word.
  [ -z "$nodes" ] || "$tailnet" forget $nodes
}

# Linux side of a snapshot build. stdin: the GitHub token. Arguments: the snapshot, the
# setup script (may be empty), then owner/repo...
bake_script() {
  cat <<'EOF'
set -euo pipefail
read -r GH_TOKEN
export GH_TOKEN
. "$HOME/.nix-profile/etc/profile.d/hm-session-vars.sh"
export PATH="$HOME/.nix-profile/bin:$HOME/.local/bin:$PATH"
snapshot=$1 setup=$2
shift 2
for repo in "$@"; do
  dir="$HOME/$snapshot/${repo#*/}"
  echo "== $repo -> $dir"
  [ -d "$dir/.git" ] || git clone --quiet "https://github.com/$repo" "$dir"
  cd "$dir"
  git submodule update --init --recursive --quiet
  if [ -f pnpm-lock.yaml ]; then pnpm install --frozen-lockfile --reporter=silent; fi
  # --with-deps installs Chromium's system libraries with apt: 5 minutes on a fresh box.
  for pw in node_modules/.bin/playwright */*/node_modules/.bin/playwright; do
    if [ -x "$pw" ]; then "$pw" install --with-deps chromium; fi
  done
  if grep -q '^setup:' Makefile 2>/dev/null; then make setup; fi
done
if [ -n "$setup" ]; then
  echo "== $snapshot.sh"
  cd "$HOME/$snapshot"
  bash -euo pipefail -c "$setup"
fi
EOF
}

# Creates a sandbox and prints its id. Arguments go to `boat new`.
create() {
  boat new --json "$@" | jq -r 'select(.event == "ready") | .id' | grep . \
    || die "could not create a sandbox"
}

# Deletes the logins Boat writes to a sandbox's disk (docs.boat.dev/environments/access),
# so a snapshot holds none. Tokens in /run/ascii-secrets are never snapshotted.
scrub_logins() {
  # Tailscale's state holds the machine key tailscaled made at its first start, joined or
  # not: kept, every box from the snapshot would be the same node. Each box makes its own
  # when the service starts there.
  ssh -o BatchMode=yes "$1" 'rm -f ~/.claude/.credentials.json ~/.codex/auth.json \
    ~/.config/gh/hosts.yml ~/.config/ascii/boat/config.json
    if systemctl cat tailscaled.service >/dev/null 2>&1; then
      sudo systemctl stop tailscaled.service && sudo rm -rf /var/lib/tailscale
    fi'
}

# Waits for the setup script that `boat new --setup-file` started. The bootstrap takes
# about 7 minutes; 10 leaves room for a slow Nix download.
wait_setup() {
  local status i=0
  while [ $i -lt 120 ]; do
    status=$(boat info "$1" --json | jq -r '.sandbox.setupStatus')
    case $status in
      running | pending | null) sleep 5 ;;
      done) return ;;
      *) return 1 ;;
    esac
    i=$((i + 1))
  done
  log "setup still running after 10 minutes"
  return 1
}

bake() {
  local snapshot=$1 id
  if [ "$snapshot" = dev ]; then
    local setup commit
    # By commit, not `main`: GitHub caches raw files for 5 minutes after a push.
    commit=$(git ls-remote https://github.com/enitrat/skill-issue main | cut -f1)
    [ -n "$commit" ] || die "cannot read the skill-issue main commit"
    log "baking skill-issue ${commit:0:7}"
    setup=$(mktemp)
    # shellcheck disable=SC2016 # $HOME expands on the sandbox, not here.
    printf '%s\n' '#!/bin/bash' 'set -euo pipefail' \
      "curl -fsSL https://raw.githubusercontent.com/enitrat/skill-issue/$commit/bootstrap/linux.sh | bash" \
      '"$HOME/skill-issue/bootstrap/check.sh"' \
      '# Each byte left in the store is downloaded again at every start.' \
      '/nix/var/nix/profiles/default/bin/nix-collect-garbage -d' >"$setup"
    log "creating a bare sandbox"
    id=$(create --name "bake-$snapshot" --setup-file "$setup")
    rm -f "$setup"
    log "$id: running the bootstrap (about 7 minutes)"
    wait_setup "$id" || die "bootstrap failed on $id. Inspect: boat info $id. Delete: boat delete $id"
  else
    local list=$HOME/.config/bx/$snapshot line repos=()
    [ -f "$list" ] || die "no repo list $list (one owner/repo per line)"
    # macOS ships bash 3.2, which has no mapfile.
    while read -r line; do
      case $line in '' | '#'*) ;; *) repos+=("$line") ;; esac
    done <"$list"
    [ ${#repos[@]} -gt 0 ] || die "$list lists no repos"
    local setup=''
    [ -f "$list.sh" ] && setup=$(cat "$list.sh")
    log "creating a sandbox from dev"
    id=$(create --from dev --name "bake-$snapshot")
    # Install nothing while the disk restores: pnpm then puts its store on Boat's restore
    # layer, a path that is gone once the restore ends, and every later install wants to
    # rebuild node_modules.
    wait_hydrated "$id"
    log "$id: cloning ${repos[*]}"
    # One connection: the script travels quoted in the command line, the token on stdin.
    gh auth token | ssh -o BatchMode=yes "$id" \
      "bash -c $(printf %q "$(bake_script)") bx-bake $(printf '%q ' "$snapshot" "$setup" "${repos[@]}")" \
      || die "snapshot setup failed on $id. Inspect: ssh $id. Delete: boat delete $id"
  fi
  save "$id" "$snapshot"
}

# Bakes every snapshot with a repo list. Each bake runs in a subshell, so the `die` of a
# failed one ends that bake only.
bake_all() {
  local f snapshot failed=''
  for f in "$HOME"/.config/bx/*; do
    case $f in *.sh) continue ;; esac
    [ -f "$f" ] || continue
    snapshot=$(basename "$f")
    log "== $snapshot"
    (bake "$snapshot") || failed="$failed $snapshot"
  done
  [ -z "$failed" ] || die "failed to bake:$failed"
}

# Saves build sandbox $1 as snapshot $2, without the logins Boat wrote, then deletes it.
save() {
  local id=$1 snapshot=$2
  scrub_logins "$id" || die "could not delete the logins on $id. Delete: boat delete $id"
  log "$id: saving as $snapshot"
  boat snapshot "$id" "$snapshot" --json | jq -e 'select(.event == "saved")' >/dev/null \
    || die "could not save $snapshot from $id"
  mkdir -p "$SAVED_DIR"
  date -u +%Y-%m-%dT%H:%M:%S.000Z >"$SAVED_DIR/$snapshot"
  boat delete "$id" --yes >/dev/null
  log "saved $snapshot. Start from it: boat new --from $snapshot"
}

# Brings a saved snapshot to skill-issue's current main without rebuilding it: re-runs the
# bootstrap on a sandbox started from the snapshot, which pulls the checkout, switches
# home-manager and reinstalls the skills, then saves it under the same name. Its repos stay
# at the commit they were baked at.
update() {
  local snapshot=$1 id commit
  boat snapshots --json | jq -e --arg n "$snapshot" '.named[] | select(.name == $n)' >/dev/null \
    || die "no snapshot $snapshot. See bx list"
  # By commit, not `main`: GitHub caches raw files for 5 minutes after a push.
  commit=$(git ls-remote https://github.com/enitrat/skill-issue main | cut -f1)
  [ -n "$commit" ] || die "cannot read the skill-issue main commit"
  log "creating a sandbox from $snapshot"
  id=$(create --from "$snapshot" --name "update-$snapshot")
  wait_hydrated "$id"
  log "$id: re-running the bootstrap at skill-issue ${commit:0:7}"
  ssh -o BatchMode=yes "$id" "set -euo pipefail
    curl -fsSL https://raw.githubusercontent.com/enitrat/skill-issue/$commit/bootstrap/linux.sh | bash
    . \"\$HOME/.nix-profile/etc/profile.d/hm-session-vars.sh\"
    export PATH=\"\$HOME/.nix-profile/bin:\$HOME/.local/bin:\$PATH\"
    \"\$HOME/skill-issue/bootstrap/check.sh\"
    /nix/var/nix/profiles/default/bin/nix-collect-garbage -d >/dev/null" \
    || die "update failed on $id. Inspect: ssh $id. Delete: boat delete $id"
  save "$id" "$snapshot"
}

# Linux side of a teleport. The pack (code, transcript, scratchpad) is in ~/.bx-teleport.
# Arguments: box checkout, Mac repo root, Mac cwd, owner/repo, branch (empty when detached),
# commit, Claude project key, session id, Mac Claude temp dir (<tmp>/claude-<uid>).
teleport_script() {
  cat <<'EOF'
set -euo pipefail
. "$HOME/.nix-profile/etc/profile.d/hm-session-vars.sh"
export PATH="$HOME/.nix-profile/bin:$HOME/.local/bin:$PATH"
dir=$1 top=$2 cwd=$3 repo=$4 branch=$5 sha=$6 key=$7 sid=$8 mac_tmp=$9
pack=$HOME/.bx-teleport
data=$HOME/.local/share/bx-teleport

echo "== $repo at ${sha:0:7} in $dir"
[ -d "$dir/.git" ] || gh repo clone "$repo" "$dir" -- --quiet
cd "$dir"
git fetch --quiet origin
# Local commits that origin lacks travel as a bundle; it needs origin's history first.
[ ! -f "$pack/head.bundle" ] || git fetch --quiet "$pack/head.bundle" HEAD
if [ -n "$branch" ]; then
  git checkout --quiet -B "$branch" "$sha"
  if git rev-parse --quiet --verify "refs/remotes/origin/$branch" >/dev/null; then
    git branch --quiet --set-upstream-to "origin/$branch"
  fi
else
  git checkout --quiet --detach "$sha"
fi
git submodule update --init --recursive --quiet
[ ! -s "$pack/work.patch" ] || git apply --binary "$pack/work.patch"
if [ -f pnpm-lock.yaml ]; then pnpm install --frozen-lockfile --prefer-offline --reporter=silent; fi

echo "== session $sid"
mkdir -p "$HOME/.claude/projects/$key" "$HOME/.claude/file-history" "$data/claude-tmp/$key"
cp -R "$pack/claude/projects/$key/." "$HOME/.claude/projects/$key/"
[ ! -d "$pack/claude/file-history/$sid" ] || cp -R "$pack/claude/file-history/$sid" "$HOME/.claude/file-history/"
[ ! -d "$pack/tmp/$sid" ] || cp -R "$pack/tmp/$sid" "$data/claude-tmp/$key/"
# The user asked to move a session they already run in this repo: trust it here too.
f=$HOME/.claude.json
[ -s "$f" ] || echo '{}' >"$f"
jq --arg top "$top" --arg cwd "$cwd" \
  '.projects[$top].hasTrustDialogAccepted = true | .projects[$cwd].hasTrustDialogAccepted = true' \
  "$f" >"$f.bx" && mv "$f.bx" "$f"

echo "== same paths as the Mac"
# Claude keys a session by its resolved cwd, and the transcript names Mac paths, so the
# checkout and the scratchpads appear at those exact paths. Bind mounts, not symlinks:
# Claude resolves symlinks. The data stays under /home/user, which Boat saves.
mounts=$(mktemp)
{
  printf '%s\t%s\n' "$dir" "$top"
  printf '%s\t%s\n' "$data/claude-tmp" "$mac_tmp"
  printf '%s\t%s\n' "$data/claude-tmp" "${mac_tmp%/*}/claude-$(id -u)"
} >"$mounts"
touch "$mounts.old"
[ ! -f /etc/bx-teleport.mounts ] || cp /etc/bx-teleport.mounts "$mounts.old"
sort -u "$mounts.old" "$mounts" | sudo tee /etc/bx-teleport.mounts >/dev/null
rm -f "$mounts" "$mounts.old"
# Mounts are not saved, and a bind made while Boat restores /home/user points at the FUSE
# layer it removes afterwards: wait for the swap, as nix-after-restore.service does.
sudo tee /usr/local/sbin/bx-teleport-mounts >/dev/null <<'SCRIPT'
#!/bin/sh
while grep -q ' /home/user fuse' /proc/mounts; do sleep 2; done
tab=$(printf '\t')
while IFS=$tab read -r src dst; do
  mkdir -p "$dst"
  mountpoint -q "$dst" || mount --bind "$src" "$dst"
done </etc/bx-teleport.mounts
SCRIPT
sudo chmod 755 /usr/local/sbin/bx-teleport-mounts
sudo /usr/local/sbin/bx-teleport-mounts
sudo tee /etc/systemd/system/bx-teleport-mounts.service >/dev/null <<'UNIT'
[Unit]
Description=Bind bx teleport paths once Boat has restored /home/user

[Service]
Type=simple
ExecStart=/usr/local/sbin/bx-teleport-mounts

[Install]
WantedBy=multi-user.target
UNIT
sudo systemctl daemon-reload
sudo systemctl enable --quiet bx-teleport-mounts.service
rm -rf "$pack"
EOF
}

# Moves Claude Code session $1, its repository as it is on disk and its scratchpad to a
# new box, and resumes it there in herdr.
teleport() {
  local sid=$1 name=$2 type=$3 snapshot=$4
  case $sid in '' | *[!0-9a-f-]*) die "not a session id: $sid" ;; esac
  local file key cwd mode top url repo branch sha mac_tmp dir id tmp
  file=$(find "$HOME/.claude/projects" -mindepth 2 -maxdepth 2 -name "$sid.jsonl" | head -1)
  [ -n "$file" ] || die "no transcript for session $sid in ~/.claude/projects"
  key=$(basename "$(dirname "$file")")
  cwd=$(jq -rn 'first(inputs | objects | select(.cwd) | .cwd) // empty' "$file")
  [ -n "$cwd" ] || die "$file names no working directory"
  mode=$(jq -rn '[inputs | objects | select(.type == "permission-mode") | .permissionMode] | last // empty' "$file")
  top=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null) || die "$cwd is not in a git repository"
  url=$(git -C "$top" remote get-url origin 2>/dev/null) || die "$top has no origin remote"
  repo=$(printf '%s\n' "$url" | sed -E 's#^(git@github\.com:|ssh://git@github\.com/|https://github\.com/)##; s#\.git$##')
  case $repo in */*/* | *:* | '') die "origin is not a GitHub repository: $url" ;; esac
  branch=$(git -C "$top" symbolic-ref --quiet --short HEAD || true)
  sha=$(git -C "$top" rev-parse HEAD)
  mac_tmp=$(cd "${CLAUDE_CODE_TMPDIR:-/tmp}" && pwd -P)/claude-$(id -u)

  if [ -z "$snapshot" ]; then
    snapshot=dev
    local built f
    built=$(boat snapshots --json | jq -r '.named[].name')
    for f in "$HOME"/.config/bx/*; do
      case $f in *.sh) continue ;; esac
      if [ -f "$f" ] && grep -qxF "$repo" "$f" && printf '%s\n' "$built" | grep -qxF "$(basename "$f")"; then
        snapshot=$(basename "$f")
        break
      fi
    done
  fi
  if [ "$snapshot" = dev ]; then dir=/home/user/work/${repo#*/}; else dir=/home/user/$snapshot/${repo#*/}; fi
  [ -n "$name" ] || name=tp-$(basename "$top" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9\n' '-' | cut -c1-20)-${sid:0:4}

  log "teleporting session $sid ($repo, ${branch:-detached} at ${sha:0:7}) to $name from $snapshot"
  id=$(new "$snapshot" "$name" "$type") || exit 1

  # Packed after the box is ready, so the transcript holds everything up to this command.
  tmp=$(mktemp -d)
  # shellcheck disable=SC2064 # $tmp is fixed now.
  trap "rm -rf '$tmp'" EXIT
  mkdir -p "$tmp/pack/claude/projects/$key" "$tmp/pack/tmp"
  if [ -n "$(git -C "$top" rev-list -n 1 HEAD --not --remotes)" ]; then
    git -C "$top" bundle create "$tmp/pack/head.bundle" HEAD --not --remotes 2>/dev/null
  fi
  # The working tree against HEAD, untracked files included, the real index untouched.
  cp "$(git -C "$top" rev-parse --path-format=absolute --git-path index)" "$tmp/index"
  GIT_INDEX_FILE=$tmp/index git -C "$top" add -A
  GIT_INDEX_FILE=$tmp/index git -C "$top" diff --cached --binary HEAD >"$tmp/pack/work.patch"
  cp -Rp "$file" "$tmp/pack/claude/projects/$key/"
  [ ! -d "${file%.jsonl}" ] || cp -Rp "${file%.jsonl}" "$tmp/pack/claude/projects/$key/"
  if [ -d "$HOME/.claude/file-history/$sid" ]; then
    mkdir -p "$tmp/pack/claude/file-history"
    cp -Rp "$HOME/.claude/file-history/$sid" "$tmp/pack/claude/file-history/"
  fi
  [ ! -d "$mac_tmp/$key/$sid" ] || cp -Rp "$mac_tmp/$key/$sid" "$tmp/pack/tmp/"
  log "$id: copying $(du -sh "$tmp/pack" | cut -f1) of code and session"
  COPYFILE_DISABLE=1 tar czf - -C "$tmp/pack" . | ssh -o BatchMode=yes "$id" \
    'rm -rf ~/.bx-teleport && mkdir ~/.bx-teleport && tar xzf - --warning=no-unknown-keyword -C ~/.bx-teleport' \
    || die "could not copy the session to $id. Delete: bx rm $name"
  ssh -o BatchMode=yes "$id" "bash -c $(printf %q "$(teleport_script)") bx-teleport $(printf '%q ' \
    "$dir" "$top" "$cwd" "$repo" "$branch" "$sha" "$key" "$sid" "$mac_tmp")" \
    || die "setting up the session on $id failed (see above). Inspect: ssh $id. Delete: bx rm $name"

  local pane='' i=0
  # The first calls right after `machine add` can be refused while its bridge starts.
  while [ $i -lt 10 ] && [ -z "$pane" ]; do
    pane=$(herdr --machine "$name" pane list 2>/dev/null | jq -r '.result.panes[0].pane_id // empty') || true
    [ -n "$pane" ] || sleep 3
    i=$((i + 1))
  done
  [ -n "$pane" ] || die "herdr on $name does not answer; see bx-boxes. Inspect: ssh $id"
  i=0
  herdr --machine "$name" pane run "$pane" \
    "cd $(printf %q "$cwd") && export CLAUDE_CODE_TMPDIR=$(printf %q "${mac_tmp%/*}")" >/dev/null
  while [ $i -lt 15 ] && [ "$(herdr --machine "$name" pane list | jq -r --arg p "$pane" '.result.panes[] | select(.pane_id == $p) | .cwd')" != "$cwd" ]; do
    sleep 1
    i=$((i + 1))
  done
  log "$id: resuming the session in herdr pane $pane"
  local args=(--resume "$sid")
  [ -z "$mode" ] || args+=(--permission-mode "$mode")
  if ! herdr --machine "$name" agent start claude --kind claude --pane "$pane" --timeout 120000 -- "${args[@]}" >/dev/null; then
    log "Claude did not reach its prompt; a dialog may be waiting. Read it:"
    log "  herdr --machine $name agent read claude --source visible"
    exit 3
  fi
  # The copied transcript ends inside the command that ran this teleport. Tell the resumed
  # session it finished, so it does not run it again.
  herdr --machine "$name" agent prompt claude "This session was teleported to the Boat box $name ($id) by bx teleport, which completed. The repository, its uncommitted changes and the scratchpad are at the same paths as on the Mac; this machine is Linux. Do not run bx teleport again. Reply with one short line, then wait for the user." \
    --wait --timeout 300000 >/dev/null || log "the first prompt did not settle; check: herdr --machine $name agent read claude"
  echo "$id"
  log "resumed in herdr. Attach: herdr --remote $id (or pick $name in the herdr machine list). Delete: bx rm $name"
}

case ${1:-} in
  -h | --help) usage ;;
  --version) echo "bx $VERSION" ;;
  new)
    shift
    snapshot='' name='' type=large
    while [ $# -gt 0 ]; do
      case $1 in
        --snapshot | --name | --type)
          [ $# -ge 2 ] || die "$1 needs a value"
          case $1 in --snapshot) snapshot=$2 ;; --name) name=$2 ;; --type) type=$2 ;; esac
          shift 2 ;;
        *) die "unknown argument $1. Usage: bx new --snapshot <snapshot> --name <name> [--type <size>]" ;;
      esac
    done
    [ -n "$snapshot" ] && [ -n "$name" ] || die "usage: bx new --snapshot <snapshot> --name <name>"
    new "$snapshot" "$name" "$type"
    ;;
  teleport)
    shift
    session='' name='' type=large snapshot=''
    while [ $# -gt 0 ]; do
      case $1 in
        --session | --name | --type | --snapshot)
          [ $# -ge 2 ] || die "$1 needs a value"
          case $1 in --session) session=$2 ;; --name) name=$2 ;; --type) type=$2 ;; --snapshot) snapshot=$2 ;; esac
          shift 2 ;;
        *) die "unknown argument $1. Usage: bx teleport --session <id> [--name <name>] [--snapshot <snapshot>] [--type <size>]" ;;
      esac
    done
    [ -n "$session" ] || die "usage: bx teleport --session <id>"
    teleport "$session" "$name" "$type" "$snapshot"
    ;;
  ls) ls_boxes ;;
  list) list_snapshots ;;
  rm)
    [ $# -eq 2 ] || die "usage: bx rm <name|id>"
    rm_box "$2"
    ;;
  tailnet)
    [ $# -eq 2 ] || die "usage: bx tailnet <name|id>"
    id=$(resolve "$2")
    tailnet_join "$id" "$(name_of "$id")"
    ;;
  gc)
    case ${2:-} in
      '') gc no ;;
      --yes) gc yes ;;
      *) die "usage: bx gc [--yes]" ;;
    esac
    ;;
  bake)
    [ $# -eq 2 ] || die "usage: bx bake <dev|snapshot|--all>"
    if [ "$2" = --all ]; then bake_all; else bake "$2"; fi
    ;;
  update)
    [ $# -eq 2 ] || die "usage: bx update <snapshot>"
    update "$2"
    ;;
  *) usage >&2; exit 1 ;;
esac
