#!/bin/bash
# dev-check: Verify development environment is properly set up

VERSION="1.0.0"

# $'..' so these hold real escape characters: printf does not expand \033 in
# a %s argument, only in the format string.
RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
NC=$'\033[0m'

show_help() {
    cat << 'EOF'
NAME
    dev-check - verify development environment setup

SYNOPSIS
    dev-check [category]
    dev-check --help | -h
    dev-check --version | -v

DESCRIPTION
    dev-check verifies that development tools are properly installed
    and shows their versions. Useful after a fresh install or to
    diagnose environment issues.

CATEGORIES
    all (default)
        Check all categories

    starknet
        StarkNet/Cairo tools: scarb, snforge, sncast, starkli

    node
        Node.js ecosystem: node, npm, bun, pnpm

    rust
        Rust toolchain: rustc, cargo

    system
        System tools: git, gh, vim, fzf, zoxide, claude

    python
        Python tools: uv

    go
        Go toolchain: go

    cpp
        C/C++ toolchain: gcc, clang, llvm, cmake

    drift
        Tools mise manages that another copy on PATH is shadowing --
        usually a stale Homebrew install left over from before mise.

    inventory
        Every tool declared in the chezmoi package inventory, checked for
        actually being installed. Catches an install that failed quietly.

EXAMPLES
    Check everything:
        $ dev-check

    Check only StarkNet tools:
        $ dev-check starknet

    Find tools shadowed by a stale non-mise copy:
        $ dev-check drift

    Confirm everything the inventory declares is really installed:
        $ dev-check inventory

EOF
}

show_version() {
    echo "dev-check version $VERSION"
}

check_cmd() {
    local name="$1"
    local cmd="$2"

    if command -v "$cmd" &> /dev/null; then
        local version
        version=$("$cmd" --version 2>&1 | head -1)
        printf "  %s✓%s %-12s %s\n" "$GREEN" "$NC" "$name" "$version"
        return 0
    else
        printf "  %s✗%s %-12s not found\n" "$RED" "$NC" "$name"
        return 1
    fi
}

check_cmd_custom() {
    local name="$1"
    local cmd="$2"
    local version_cmd="$3"

    if command -v "$cmd" &> /dev/null; then
        local version
        version=$(eval "$version_cmd" 2>&1 | head -1)
        printf "  %s✓%s %-12s %s\n" "$GREEN" "$NC" "$name" "$version"
        return 0
    else
        printf "  %s✗%s %-12s not found\n" "$RED" "$NC" "$name"
        return 1
    fi
}

check_starknet() {
    echo "StarkNet/Cairo:"
    check_cmd "scarb" "scarb"
    check_cmd "snforge" "snforge"
    check_cmd "sncast" "sncast"
    check_cmd "starkli" "starkli"
    echo ""
}

check_node() {
    echo "Node.js:"
    check_cmd "node" "node"
    check_cmd "npm" "npm"
    check_cmd "bun" "bun"
    check_cmd "pnpm" "pnpm"
    echo ""
}

check_rust() {
    echo "Rust:"
    check_cmd "rustc" "rustc"
    check_cmd "cargo" "cargo"
    echo ""
}

check_system() {
    echo "System:"
    check_cmd "git" "git"
    check_cmd "gh" "gh"
    check_cmd "vim" "vim"
    check_cmd "fzf" "fzf"
    check_cmd_custom "zoxide" "zoxide" "echo zoxide $(zoxide --version)"
    check_cmd_custom "atuin" "atuin" "atuin --version"
    check_cmd "claude" "claude"
    echo ""
}

check_python() {
    echo "Python:"
    check_cmd "uv" "uv"
    echo ""
}

check_go() {
    echo "Go:"
    check_cmd_custom "go" "go" "go version"
    echo ""
}

check_cpp() {
    echo "C/C++:"
    check_cmd_custom "clang" "clang" "clang --version | head -1"
    check_cmd_custom "llvm" "llvm-config" "llvm-config --version"
    check_cmd "cmake" "cmake"
    check_cmd "make" "make"
    echo ""
}

# The declared inventory and what is actually installed are different things:
# a failed install leaves the tool in ~/.config/mise/config.toml and absent from
# disk. Reading the generated config keeps this honest without a second list to
# maintain here.
check_inventory() {
    echo "Declared vs installed:"

    local cfg="${MISE_CONFIG_FILE:-$HOME/.config/mise/config.toml}"
    if [ ! -f "$cfg" ]; then
        printf "  %s!%s %s not found\n\n" "$YELLOW" "$NC" "$cfg"
        return
    fi

    local missing=0 total=0
    while read -r tool; do
        [ -n "$tool" ] || continue
        total=$((total + 1))
        # Backend prefixes name the source, not the binary: cargo:mergiraf
        # installs `mergiraf`, github:abhinav/git-spice installs `git-spice`.
        local bin="${tool##*[:/]}"
        # ...and several packages ship a binary under a different name again.
        case "$bin" in
            difftastic) bin=difft ;;
            ripgrep)    bin=rg ;;
            rust)       bin=rustc ;;
            node)       bin=node ;;
        esac
        if ! command -v "$bin" &> /dev/null; then
            printf "  %s✗%s %-14s declared, not on PATH\n" "$RED" "$NC" "$bin"
            missing=$((missing + 1))
        fi
    done < <(sed -n 's/^"\{0,1\}\([^"= ]*\)"\{0,1\}[[:space:]]*=.*/\1/p' "$cfg")

    if [ "$missing" -eq 0 ]; then
        printf "  %s✓%s all %s declared tools present\n" "$GREEN" "$NC" "$total"
    else
        printf "\n  %s of %s missing. Re-run 'chezmoi apply' to reinstall.\n" "$missing" "$total"
    fi
    echo ""
}

# A tool installed by mise but resolving somewhere else means an older copy is
# earlier on PATH. That copy wins in every shell, so the mise version is dead
# weight and the shadowing one never gets upgraded.
check_drift() {
    echo "Shadowed mise tools:"

    if ! command -v mise &> /dev/null; then
        printf "  %s!%s mise not found, cannot compare\n\n" "$YELLOW" "$NC"
        return
    fi

    # Both are mise resolving correctly: shims when it is activated, the
    # install path when the shell has the versioned dirs on PATH directly.
    local mise_data="${MISE_DATA_DIR:-$HOME/.local/share/mise}"
    local found=0

    while read -r tool; do
        # Backend-qualified names (github:owner/repo) rarely match their binary.
        case "$tool" in *:*) continue ;; esac
        local resolved
        resolved="$(command -v "$tool" 2>/dev/null)" || continue
        case "$resolved" in
            "$mise_data"/installs/*|"$mise_data"/shims/*) ;;
            *)
                printf "  %s!%s %-12s %s\n" "$YELLOW" "$NC" "$tool" "$resolved"
                found=$((found + 1))
                ;;
        esac
    done < <(mise ls -g --no-header 2>/dev/null | awk '{print $1}')

    if [ "$found" -eq 0 ]; then
        printf "  %s✓%s none - every mise tool resolves to its mise install\n" "$GREEN" "$NC"
    else
        printf "\n  %s tool(s) shadowed. Remove the other copy, e.g. 'brew uninstall <name>'.\n" "$found"
    fi
    echo ""
}

check_all() {
    echo ""
    check_system
    check_node
    check_python
    check_go
    check_rust
    check_cpp
    check_starknet
    check_inventory
    check_drift
}

case "$1" in
    -h|--help)
        show_help
        ;;
    -v|--version)
        show_version
        ;;
    ""|all)
        check_all
        ;;
    starknet)
        echo ""
        check_starknet
        ;;
    node)
        echo ""
        check_node
        ;;
    rust)
        echo ""
        check_rust
        ;;
    system)
        echo ""
        check_system
        ;;
    python)
        echo ""
        check_python
        ;;
    go)
        echo ""
        check_go
        ;;
    cpp|c++)
        echo ""
        check_cpp
        ;;
    drift)
        echo ""
        check_drift
        ;;
    inventory)
        echo ""
        check_inventory
        ;;
    *)
        echo "Unknown category: $1"
        echo "Run 'dev-check --help' for usage"
        exit 1
        ;;
esac
