#!/bin/bash
# ssh-sync: Bootstrap remote Linux/macOS machines with your dev environment
#
# Thin SSH wrapper around chezmoi. All the actual provisioning logic
# (packages, shell config, tool installs) lives in dotfiles/ at the root of
# this repo and is applied by chezmoi itself on the remote box - this script
# just gets chezmoi there and tells it to run.

VERSION="2.0.0"
REPO_URL="https://github.com/enitrat/skill-issue.git"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

DRY_RUN=false
SSH_PORT=22
SSH_IDENTITY=""
SSH_TARGET=""
ALLOW_PASSWORD=false

show_help() {
    cat << 'EOF'
NAME
    ssh-sync - bootstrap a remote machine with your dev environment via chezmoi

SYNOPSIS
    ssh-sync <user@host> [options]
    ssh-sync --help | -h
    ssh-sync --version | -v

DESCRIPTION
    Connects over SSH, installs chezmoi if needed, and runs
    'chezmoi init --apply' against this repo. All provisioning (packages,
    shell config, mise-managed CLI tools, Tailscale/mosh, Cursor-server
    maintenance, iTerm2 integration) is defined in dotfiles/ and executed
    idempotently by chezmoi on the remote box - re-running this is safe.

    No secrets are transferred. Git identity (gh auth, GPG signing, etc.)
    and Tailscale login are intentionally left as manual post-setup steps -
    see NEXT STEPS below.

OPTIONS
    -n, --dry-run       Show the chezmoi diff without applying it.
    -p, --port <port>   SSH port (default: 22).
    -i <key>            SSH identity file to use.
    --password          Allow password authentication (disables BatchMode).
    -h, --help          Show this help message.
    -v, --version       Show version number.

WHAT GETS INSTALLED (see dotfiles/run_once_*.sh.tmpl for exact commands)
    Shell:    zsh, oh-my-zsh + plugins, Starship
    Version manager: mise (also installs node/python/go/rust/bun/uv)
    CLI:      atuin, bat, delta, eza, fd, fzf, gh, ripgrep, tmux, zoxide,
              difftastic, mergiraf, git-spice, sesh, httpie
    Network:  Tailscale, mosh
    Extras:   iTerm2 shell integration, Cursor remote-server maintenance

    Plus: this repo is cloned to ~/.local/share/chezmoi (symlinked to
    ~/workspace/skill-issue) so tools/ and Claude skills come along too.

NEXT STEPS (manual, by design - not scriptable/secret-safe)
    1. gh auth login          (GitHub CLI auth)
    2. atuin login            (shared shell history sync)
    3. tailscale up           (join your tailnet)
    4. git-id add <name> ...  (git identity - see tools/git-id --help)

EXAMPLES
    ssh-sync user@server.example.com
    ssh-sync user@server.example.com --dry-run
    ssh-sync user@server.example.com -p 2222 -i ~/.ssh/id_custom

EOF
}

show_version() { echo "ssh-sync version $VERSION"; }
log_info()  { printf "${BLUE}[INFO]${NC} %s\n" "$1"; }
log_ok()    { printf "${GREEN}[OK]${NC} %s\n" "$1"; }
log_error() { printf "${RED}[ERROR]${NC} %s\n" "$1"; }

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help) show_help; exit 0 ;;
            -v|--version) show_version; exit 0 ;;
            -n|--dry-run) DRY_RUN=true; shift ;;
            --password) ALLOW_PASSWORD=true; shift ;;
            -p|--port) SSH_PORT="$2"; shift 2 ;;
            -i) SSH_IDENTITY="$2"; shift 2 ;;
            -*) log_error "Unknown option: $1"; exit 1 ;;
            *)
                if [[ -z "$SSH_TARGET" ]]; then
                    SSH_TARGET="$1"
                else
                    log_error "Unexpected argument: $1"; exit 1
                fi
                shift
                ;;
        esac
    done

    if [[ -z "$SSH_TARGET" ]]; then
        log_error "Missing required argument: user@host"
        echo "Run 'ssh-sync --help' for usage"
        exit 1
    fi
    if [[ ! "$SSH_TARGET" =~ ^[^@]+@[^@]+$ ]]; then
        log_error "Invalid SSH target format. Expected: user@host"
        exit 1
    fi
}

get_ssh_opts() {
    local opts="-o ConnectTimeout=10 -p $SSH_PORT"
    [[ "$ALLOW_PASSWORD" != "true" ]] && opts="$opts -o BatchMode=yes"
    [[ -n "$SSH_IDENTITY" ]] && opts="$opts -i $SSH_IDENTITY"
    echo "$opts"
}

# Remote command: install chezmoi if missing, then init/apply this repo.
#
# mise's github/aqua backends hit the GitHub API heavily (release lookups,
# checksums, artifact attestations) - easily 20-30 calls for the tool list
# in dotfiles/run_once_before_20-install-tools-via-mise.sh.tmpl. Unauthenticated
# requests are capped at 60/hour and this WILL exhaust that on a single run.
# Forward the local gh CLI's token transiently (used in-memory for this SSH
# session only, never written to disk on the remote box) if available.
remote_command() {
    local chezmoi_flags="--apply"
    [[ "$DRY_RUN" == "true" ]] && chezmoi_flags="--dry-run --verbose"

    local github_token
    github_token="$(gh auth token 2>/dev/null || true)"

    cat << REMOTE_EOF
set -e
export PATH="\$HOME/.local/bin:\$PATH"
$( [[ -n "$github_token" ]] && echo "export GITHUB_TOKEN='$github_token'" )

if ! command -v chezmoi >/dev/null 2>&1; then
    echo "Installing chezmoi..."
    sh -c "\$(curl -fsLS get.chezmoi.io)" -- -b "\$HOME/.local/bin"
fi

chezmoi init $chezmoi_flags "$REPO_URL"

if [ "$DRY_RUN" != "true" ]; then
    mkdir -p "\$HOME/workspace"
    [ -e "\$HOME/workspace/skill-issue" ] || ln -s "\$HOME/.local/share/chezmoi" "\$HOME/workspace/skill-issue"

    mkdir -p "\$HOME/.claude/skills"
    if [ -d "\$HOME/workspace/skill-issue/plugins/personal-skills/skills" ]; then
        cp -r "\$HOME/workspace/skill-issue/plugins/personal-skills/skills"/* "\$HOME/.claude/skills/" 2>/dev/null || true
    fi
fi
REMOTE_EOF
}

main() {
    parse_args "$@"

    printf "\n${BOLD}${BLUE}ssh-sync${NC} v%s\n" "$VERSION"
    printf "Target: ${CYAN}%s${NC}\n" "$SSH_TARGET"
    [[ "$DRY_RUN" == "true" ]] && printf "${YELLOW}Dry run - showing chezmoi diff only${NC}\n"

    local ssh_opts
    ssh_opts=$(get_ssh_opts)

    log_info "Connecting and running chezmoi..."
    # shellcheck disable=SC2029
    ssh $ssh_opts "$SSH_TARGET" "bash -s" < <(remote_command)

    if [[ "$DRY_RUN" != "true" ]]; then
        log_ok "Setup complete."
        printf "\n${CYAN}Next steps (run on the remote box):${NC}\n"
        printf "  1. gh auth login\n"
        printf "  2. atuin login -u <username>\n"
        printf "  3. tailscale up\n"
        printf "  4. git-id add <name> \"Your Name\" you@email.com <ssh-key-name>\n"
        printf "  5. exec zsh   (or log back in) to pick up the new shell\n\n"
    fi
}

main "$@"
