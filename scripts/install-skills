#!/usr/bin/env node

import {
  cpSync,
  existsSync,
  lstatSync,
  mkdtempSync,
  mkdirSync,
  readdirSync,
  readFileSync,
  renameSync,
  rmSync,
  statSync,
  symlinkSync,
  writeFileSync,
} from "node:fs";
import { spawnSync } from "node:child_process";
import { homedir, tmpdir } from "node:os";
import { basename, dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const repoRoot = dirname(dirname(fileURLToPath(import.meta.url)));
const externalRoot = join(repoRoot, "skills", "external");
const manifest = JSON.parse(
  readFileSync(join(repoRoot, "skills-external.json"), "utf8"),
);
const argv = process.argv.slice(2);
const update = argv[0] === "--update";

function run(args, cwd = repoRoot) {
  const result = spawnSync("npx", ["skills", ...args], {
    cwd,
    stdio: "inherit",
  });
  if (result.error) throw result.error;
  if (result.status !== 0) throw new Error(`skills exited with status ${result.status ?? 1}`);
}

// `skills add --copy` replaces symlinks with copies. A launcher in bin/ that
// links to a script at the skill root then runs from bin/ and cannot import
// the package beside the script, so turn such copies back into symlinks.
function restoreBinLinks(skillDir) {
  const binDir = join(skillDir, "bin");
  if (!existsSync(binDir)) return;
  const rootFiles = readdirSync(skillDir, { withFileTypes: true })
    .filter((entry) => entry.isFile())
    .map((entry) => entry.name);
  for (const entry of readdirSync(binDir, { withFileTypes: true })) {
    if (!entry.isFile()) continue;
    const launcher = join(binDir, entry.name);
    const contents = readFileSync(launcher);
    const target = rootFiles.find((file) =>
      readFileSync(join(skillDir, file)).equals(contents),
    );
    if (!target) continue;
    rmSync(launcher);
    symlinkSync(join("..", target), launcher);
  }
}

const externalSkills = manifest.skills ?? [];
for (const skill of externalSkills) {
  if (!skill.name || skill.name === "." || skill.name === ".." || basename(skill.name) !== skill.name) {
    throw new Error(`Invalid external skill name: ${skill.name}`);
  }
}

if (update) {
  mkdirSync(externalRoot, { recursive: true });
  const stagingRoot = mkdtempSync(join(externalRoot, ".update-"));
  const backupRoot = join(stagingRoot, ".backups");
  let fetchRoot;
  const published = [];
  let removeStaging = true;
  try {
    mkdirSync(backupRoot);
    fetchRoot = mkdtempSync(join(tmpdir(), "skill-"));
    for (const skill of externalSkills) {
      const fetchDir = join(fetchRoot, skill.name);
      mkdirSync(fetchDir);
      console.log(`\nFetching ${skill.name} from ${skill.source}`);
      run(
        [
          "add",
          skill.source,
          "--skill",
          skill.name,
          "--agent",
          "codex",
          "--copy",
          "--yes",
        ],
        fetchDir,
      );

      const fetched = join(fetchDir, ".agents", "skills", skill.name);
      if (!statSync(join(fetched, "SKILL.md")).isFile()) throw new Error(`Missing SKILL.md: ${skill.name}`);
      const staged = join(stagingRoot, skill.name);
      cpSync(fetched, staged, { recursive: true });
      restoreBinLinks(staged);

      if (skill.modelInvocable) {
        const skillFile = join(staged, "SKILL.md");
        writeFileSync(
          skillFile,
          readFileSync(skillFile, "utf8").replace(
            /^disable-model-invocation:.*\n/m,
            "",
          ),
        );
      }
    }

    for (const skill of externalSkills) {
      const destination = join(externalRoot, skill.name);
      const backup = join(backupRoot, skill.name);
      const hadPrevious = lstatSync(destination, { throwIfNoEntry: false }) !== undefined;
      if (hadPrevious) renameSync(destination, backup);
      published.push({ destination, backup, hadPrevious });
      renameSync(join(stagingRoot, skill.name), destination);
    }
  } catch (error) {
    removeStaging = false;
    for (const { destination, backup, hadPrevious } of published.reverse()) {
      rmSync(destination, { recursive: true, force: true });
      if (hadPrevious) renameSync(backup, destination);
    }
    removeStaging = true;
    throw error;
  } finally {
    if (removeStaging) rmSync(stagingRoot, { recursive: true, force: true });
    if (fetchRoot) rmSync(fetchRoot, { recursive: true, force: true });
  }
  process.exit(0);
}

console.log("\nInstalling local and external skills");
run(["add", ".", ...argv]);

// The install copies again, so repair the installed skills the same way.
const root = argv.includes("--global") || argv.includes("-g")
  ? join(homedir(), ".agents", "skills")
  : join(repoRoot, ".agents", "skills");
const localSkills = readdirSync(join(repoRoot, "skills"), { withFileTypes: true })
  .filter((entry) => entry.isDirectory() && existsSync(join(repoRoot, "skills", entry.name, "SKILL.md")))
  .map((entry) => entry.name);
for (const name of new Set([...localSkills, ...externalSkills.map((skill) => skill.name)])) {
  const dir = join(root, name);
  if (existsSync(dir)) restoreBinLinks(dir);
}
