{{- $isDarwin := eq .chezmoi.os "darwin" -}}
# Amazon Q pre block. Keep at the top of this file.
[[ -f "${HOME}/Library/Application Support/amazon-q/shell/zshrc.pre.zsh" ]] && builtin source "${HOME}/Library/Application Support/amazon-q/shell/zshrc.pre.zsh"

# =============================================================================
# OH-MY-ZSH CONFIGURATION
# =============================================================================

export ZSH="$HOME/.oh-my-zsh"

# Theme handled by Starship below
ZSH_THEME=""

plugins=(
    virtualenv
    git
{{- if $isDarwin }}
    macos
{{- end }}
    zsh-autosuggestions
    zsh-syntax-highlighting
    zsh-history-substring-search
    command-not-found
)
source $ZSH/oh-my-zsh.sh

# =============================================================================
# ENVIRONMENT VARIABLES
# =============================================================================

export EDITOR='vim'
export LANG=en_US.UTF-8

# Claude Code
export CLAUDE_CODE_DISABLE_AUTO_MEMORY=1

# Bun
export BUN_INSTALL="$HOME/.bun"

# pnpm
{{- if $isDarwin }}
export PNPM_HOME="$HOME/Library/pnpm"
{{- else }}
export PNPM_HOME="$HOME/.local/share/pnpm"
{{- end }}
{{ if $isDarwin }}
# Android
export ANDROID_HOME="$HOME/Library/Android/sdk"
export JAVA_HOME=$(/usr/libexec/java_home 2>/dev/null)

# LLVM for Cairo-Native
export LDFLAGS="-L/opt/homebrew/opt/llvm@18/lib"
export CPPFLAGS="-I/opt/homebrew/opt/llvm@18/include"
{{ end -}}
# Nargo (Noir)
export NARGO_HOME="$HOME/.nargo"

# =============================================================================
# PATH CONFIGURATION (consolidated)
# =============================================================================

typeset -U path  # Ensure unique entries in PATH

path=(
    "$HOME/workspace/skill-issue/tools"
    "$HOME/bin"
    "$HOME/.local/bin"
{{- if $isDarwin }}
    "/opt/homebrew/bin"
    "/opt/homebrew/opt/llvm@18/bin"
    "/opt/homebrew/opt/openjdk/bin"
    "/opt/homebrew/opt/openssl@1.1/bin"
    "/opt/homebrew/opt/libpq/bin"
    "$ANDROID_HOME/emulator"
    "$ANDROID_HOME/platform-tools"
    "/usr/local/texlive/2023/bin/universal-darwin"
{{- end }}
    "$BUN_INSTALL/bin"
    "$HOME/go/bin"
    "$PNPM_HOME"
    "$HOME/.huff/bin"
    "$HOME/.starklings/dist/starklings"
    "$HOME/.risc0/bin"
    "$NARGO_HOME/bin"
    $path
)

export PATH

# =============================================================================
# VERSION MANAGER (mise - replaces nvm/asdf/pyenv)
# =============================================================================

eval "$(mise activate zsh)"

# =============================================================================
# SHELL ENHANCEMENTS
# =============================================================================

# Zoxide (smart cd)
eval "$(zoxide init zsh)"

# FZF
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_CTRL_T_OPTS="--preview 'bat --color=always --line-range :200 {}'"
export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 {}'"

# Starship prompt
eval "$(starship init zsh)"

# Bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

{{ if $isDarwin -}}
# Starkli
[ -f "$HOME/.starkli/env" ] && . "$HOME/.starkli/env"

# Fig export (if exists)
[[ -f "$HOME/fig-export/dotfiles/dotfile.zsh" ]] && builtin source "$HOME/fig-export/dotfiles/dotfile.zsh"

{{ end -}}
# Atuin (shell history)
[ -f "$HOME/.atuin/bin/env" ] && . "$HOME/.atuin/bin/env"
eval "$(atuin init zsh)"

# iTerm2 shell integration (safe no-op if not present / not iTerm2)
[ -f "$HOME/.iterm2_shell_integration.zsh" ] && source "$HOME/.iterm2_shell_integration.zsh"

{{ if $isDarwin -}}
# Kiro integration
[[ "$TERM_PROGRAM" == "kiro" ]] && . "$(kiro --locate-shell-integration-path zsh)"

{{ end -}}
# =============================================================================
# COMPLETIONS (single compinit call at the end)
# =============================================================================

fpath=(~/.zfunc $fpath)

# Scarb completions (lazy)
_scarb() {
    if ! scarb completions zsh >/dev/null 2>&1; then
        return 0
    fi
    eval "$(scarb completions zsh)"
    _scarb "$@"
}

# Starknet Foundry completions (lazy)
_snforge() {
    if ! snforge completions zsh >/dev/null 2>&1; then
        return 0
    fi
    eval "$(snforge completions zsh)"
    _snforge "$@"
}

_sncast() {
    if ! sncast completions zsh >/dev/null 2>&1; then
        return 0
    fi
    eval "$(sncast completions zsh)"
    _sncast "$@"
}

# Single compinit call
autoload -Uz compinit && compinit

compdef _scarb scarb
compdef _snforge snforge
compdef _sncast sncast

# =============================================================================
# ALIASES
# =============================================================================

# Force English git output
alias git='LANG=en_GB git'

{{ if $isDarwin -}}
# GCC 15 (Homebrew)
alias gcc="gcc-15"
alias g++="g++-15"
alias cc="gcc-15"
alias c++="g++-15"

{{ end -}}
# Starkup installer
alias starkup="curl --proto '=https' --tlsv1.2 -sSf https://sh.starkup.sh | sh -s --"

# -----------------------------------------------------------------------------
# Modern CLI Replacements
# -----------------------------------------------------------------------------
alias cat='bat'
alias ls='eza'
alias ll='eza -la --git'
alias tree='eza --tree'

# -----------------------------------------------------------------------------
# Navigation
# -----------------------------------------------------------------------------
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias -- -='cd -'

# -----------------------------------------------------------------------------
# Git Shortcuts
# -----------------------------------------------------------------------------
alias gp='git push origin $(git branch --show-current)'
alias gclean='git branch --merged | grep -v "main\|master\|\*" | xargs -n 1 git branch -d'

# -----------------------------------------------------------------------------
# Safety & Convenience
# -----------------------------------------------------------------------------
alias df='df -h'
alias du='du -h'

# -----------------------------------------------------------------------------
# Network & System
# -----------------------------------------------------------------------------
alias myip='curl -s ifconfig.me'
{{ if $isDarwin -}}
alias localip='ipconfig getifaddr en0'
{{ else -}}
alias localip="hostname -I | awk '{print \$1}'"
{{ end -}}

# -----------------------------------------------------------------------------
# Utilities
# -----------------------------------------------------------------------------
alias cpwd='pwd | pbcopy'
alias reload='source ~/.zshrc'
alias json='uv run python -m json.tool'
alias zf='z $(zoxide query -l | fzf)'
alias please='sudo $(fc -ln -1)'

# =============================================================================
# FUNCTIONS
# =============================================================================

# mkdir + cd in one command
mkcd() { mkdir -p "$1" && cd "$1" }

# Universal archive extraction
extract() {
    case "$1" in
        *.tar.bz2) tar xjf "$1" ;;
        *.tar.gz)  tar xzf "$1" ;;
        *.tar.xz)  tar xJf "$1" ;;
        *.zip)     unzip "$1" ;;
        *.gz)      gunzip "$1" ;;
        *.7z)      7z x "$1" ;;
        *)         echo "Unknown format: $1" ;;
    esac
}

# Find what's using a port
port() { lsof -i ":$1" }

# Quick HTTP server in current dir
serve() { uv run python -m http.server "${1:-8000}" }

# Override oh-my-zsh git aliases with custom functions
unalias gcm gac gri 2>/dev/null

# Quick commit with message
gcm() { git commit -m "$*" }

# Add all + commit
gac() { git add -A && git commit -m "$*" }

# Interactive rebase last N commits
gri() { git rebase -i HEAD~"$1" }

# =============================================================================
# AMAZON Q (must stay at bottom)
# =============================================================================

[[ -f "${HOME}/Library/Application Support/amazon-q/shell/zshrc.post.zsh" ]] && builtin source "${HOME}/Library/Application Support/amazon-q/shell/zshrc.post.zsh"

{{ if $isDarwin -}}
# opencode
[ -d "$HOME/.opencode/bin" ] && export PATH="$HOME/.opencode/bin:$PATH"

# Vite+ bin (https://viteplus.dev)
[ -f "$HOME/.vite-plus/env" ] && . "$HOME/.vite-plus/env"

# pnpm
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

# Safe-chain
[ -f "$HOME/.safe-chain/scripts/init-posix.sh" ] && source "$HOME/.safe-chain/scripts/init-posix.sh"
{{ end -}}
