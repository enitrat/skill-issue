{{- $isDarwin := eq .chezmoi.os "darwin" -}}
{{- $llvm := "llvm@19" -}}
# --- oh-my-zsh -------------------------------------------------------------

export ZSH="$HOME/.oh-my-zsh"

# Empty disables oh-my-zsh theming entirely; starship draws the prompt.
ZSH_THEME=""

plugins=(
    virtualenv
    git
{{- if $isDarwin }}
    macos
{{- end }}
    zsh-autosuggestions
    zsh-syntax-highlighting
    zsh-history-substring-search
    command-not-found
)
source $ZSH/oh-my-zsh.sh

# --- Environment -----------------------------------------------------------

export EDITOR='vim'
export LANG=en_US.UTF-8

export CLAUDE_CODE_DISABLE_AUTO_MEMORY=1

export BUN_INSTALL="$HOME/.bun"

# Where `pnpm add -g` links binaries; unrelated to where pnpm itself lives.
{{- if $isDarwin }}
export PNPM_HOME="$HOME/Library/pnpm"
{{- else }}
export PNPM_HOME="$HOME/.local/share/pnpm"
{{- end }}
{{ if $isDarwin }}
export ANDROID_HOME="$HOME/Library/Android/sdk"
export JAVA_HOME=$(/usr/libexec/java_home 2>/dev/null)

# Cairo-Native needs Homebrew LLVM, but these are exported globally and so
# reach every compile in the shell, not just Cairo builds.
export LDFLAGS="-L/opt/homebrew/opt/{{ $llvm }}/lib"
export CPPFLAGS="-I/opt/homebrew/opt/{{ $llvm }}/include"
{{ end -}}
# --- PATH ------------------------------------------------------------------

typeset -U path

path=(
    "$HOME/workspace/skill-issue/tools"
    "$HOME/bin"
    "$HOME/.local/bin"
{{- if $isDarwin }}
    "/opt/homebrew/bin"
    "/opt/homebrew/opt/{{ $llvm }}/bin"
    "/opt/homebrew/opt/openjdk/bin"
    "/opt/homebrew/opt/openssl@1.1/bin"
    "/opt/homebrew/opt/libpq/bin"
    "$ANDROID_HOME/emulator"
    "$ANDROID_HOME/platform-tools"
    /usr/local/texlive/*/bin/universal-darwin(N)
{{- end }}
    "$BUN_INSTALL/bin"
    "$HOME/go/bin"
    "$PNPM_HOME"
    $path
)

export PATH

# --- Tool init -------------------------------------------------------------

eval "$(mise activate zsh)"

eval "$(zoxide init zsh)"

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_CTRL_T_OPTS="--preview 'bat --color=always --line-range :200 {}'"
export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 {}'"

eval "$(starship init zsh)"

[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

{{ if $isDarwin -}}
[ -f "$HOME/.starkli/env" ] && . "$HOME/.starkli/env"

{{ end -}}
[ -f "$HOME/.atuin/bin/env" ] && . "$HOME/.atuin/bin/env"
eval "$(atuin init zsh)"

[ -f "$HOME/.iterm2_shell_integration.zsh" ] && source "$HOME/.iterm2_shell_integration.zsh"

# --- Completions -----------------------------------------------------------

fpath=(~/.zfunc $fpath)

# Completion stubs that generate the real completions on first Tab, then
# re-dispatch to themselves. Cheaper than running three generators at startup.
_scarb() {
    if ! scarb completions zsh >/dev/null 2>&1; then
        return 0
    fi
    eval "$(scarb completions zsh)"
    _scarb "$@"
}

_snforge() {
    if ! snforge completions zsh >/dev/null 2>&1; then
        return 0
    fi
    eval "$(snforge completions zsh)"
    _snforge "$@"
}

_sncast() {
    if ! sncast completions zsh >/dev/null 2>&1; then
        return 0
    fi
    eval "$(sncast completions zsh)"
    _sncast "$@"
}

autoload -Uz compinit && compinit

compdef _scarb scarb
compdef _snforge snforge
compdef _sncast sncast

# Must come after compinit; CARAPACE_BRIDGES keeps the compdef stubs working.
if command -v carapace >/dev/null 2>&1; then
    export CARAPACE_BRIDGES='zsh'
    zstyle ':completion:*' format $'\e[2;37mCompleting %d\e[m'
    source <(carapace _carapace)
fi

# --- Aliases ---------------------------------------------------------------

# Force English git output
alias git='LANG=en_US git'

{{ if $isDarwin -}}
alias gcc="gcc-15"
alias g++="g++-15"
alias cc="gcc-15"
alias c++="g++-15"

{{ end -}}
alias starkup="curl --proto '=https' --tlsv1.2 -sSf https://sh.starkup.sh | sh -s --"

alias cat='bat'
alias ls='eza'
alias ll='eza -la --git'
alias tree='eza --tree'

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias -- -='cd -'

alias gp='git push origin $(git branch --show-current)'
alias gclean='git branch --merged | grep -v "main\|master\|\*" | xargs -n 1 git branch -d'

alias df='df -h'
alias du='du -h'

alias myip='curl -s ifconfig.me'
{{ if $isDarwin -}}
alias localip='ipconfig getifaddr en0'
{{ else -}}
alias localip="hostname -I | awk '{print \$1}'"
{{ end -}}

alias cpwd='pwd | pbcopy'
alias reload='source ~/.zshrc'
alias json='uv run python -m json.tool'
alias zf='z $(zoxide query -l | fzf)'
alias please='sudo $(fc -ln -1)'

# --- Functions -------------------------------------------------------------

mkcd() { mkdir -p "$1" && cd "$1" }

extract() {
    case "$1" in
        *.tar.bz2) tar xjf "$1" ;;
        *.tar.gz)  tar xzf "$1" ;;
        *.tar.xz)  tar xJf "$1" ;;
        *.zip)     unzip "$1" ;;
        *.gz)      gunzip "$1" ;;
        *.7z)      7z x "$1" ;;
        *)         echo "Unknown format: $1" ;;
    esac
}

port() { lsof -i ":$1" }

serve() { uv run python -m http.server "${1:-8000}" }

# The git plugin defines these as aliases, which cannot take arguments.
unalias gcm gac gri 2>/dev/null

gcm() { git commit -m "$*" }

gac() { git add -A && git commit -m "$*" }

gri() { git rebase -i HEAD~"$1" }

{{ if $isDarwin -}}
[ -d "$HOME/.opencode/bin" ] && export PATH="$HOME/.opencode/bin:$PATH"

[ -f "$HOME/.vite-plus/env" ] && . "$HOME/.vite-plus/env"

[ -f "$HOME/.safe-chain/scripts/init-posix.sh" ] && source "$HOME/.safe-chain/scripts/init-posix.sh"
{{ end -}}
