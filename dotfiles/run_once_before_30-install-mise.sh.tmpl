#!/bin/bash
set -euo pipefail
{{ template "lib.sh" . }}

if have mise; then
    log mise "already installed: $(mise --version)"
    exit 0
fi

{{ if eq .chezmoi.os "darwin" -}}
brew_path || { warn mise "Homebrew not found, cannot install mise"; exit 1; }
brew install mise
{{ else -}}
curl -fsSL https://mise.run | sh
{{ end -}}

mise_path
log mise "installed: $(mise --version 2>/dev/null || echo unknown)"
