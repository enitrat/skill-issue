#!/bin/bash
set -euo pipefail

export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"

if ! command -v gh >/dev/null 2>&1; then
    echo "[gh-auth] gh not found on PATH, skipping. Re-run 'chezmoi apply' after mise installs it." >&2
    exit 0
fi

if gh auth status >/dev/null 2>&1; then
    echo "[gh-auth] already authenticated, skipping"
    exit 0
fi

# Without a TTY the web flow would hang and stall the whole apply.
if [ ! -t 0 ]; then
    echo "[gh-auth] not authenticated and no TTY available." >&2
    echo "[gh-auth] run 'gh auth login --web -h github.com' manually to finish setup." >&2
    exit 0
fi

echo "[gh-auth] not authenticated - starting web login flow"
gh auth login --web -h github.com -p https -s repo,read:org \
    || echo "[gh-auth] login did not complete, run 'gh auth login --web' manually" >&2
