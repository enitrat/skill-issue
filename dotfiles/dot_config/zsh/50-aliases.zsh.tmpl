alias cat='bat'
alias ls='eza'
alias ll='eza -la --git'
alias tree='eza --tree'

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias -- -='cd -'

alias gp='git push origin $(git branch --show-current)'
alias gclean='git branch --merged | grep -v "main\|master\|\*" | xargs -n 1 git branch -d'

alias df='df -h'
alias du='du -h'

alias myip='curl -s ifconfig.me'
{{- if eq .chezmoi.os "darwin" }}
alias localip='ipconfig getifaddr en0'
alias cpwd='pwd | pbcopy'
{{- else }}
alias localip="hostname -I | awk '{print \$1}'"
{{- end }}

alias reload='exec zsh'
alias json='uv run --no-project python -m json.tool'
alias zf='z $(zoxide query -l | fzf)'
alias please='sudo $(fc -ln -1)'

alias starkup="curl --proto '=https' --tlsv1.2 -sSf https://sh.starkup.sh | sh -s --"
{{- if eq .chezmoi.os "darwin" }}

# Homebrew GCC, only when it is actually installed -- otherwise these would
# shadow Apple clang with a binary that does not exist.
if command -v {{ .gcc | replace "@" "-" }} >/dev/null 2>&1; then
    alias gcc="{{ .gcc | replace "@" "-" }}"
    alias cc="{{ .gcc | replace "@" "-" }}"
    alias g++="{{ .gcc | replace "@" "-" | replace "gcc" "g++" }}"
    alias c++="{{ .gcc | replace "@" "-" | replace "gcc" "g++" }}"
fi
{{- end }}
