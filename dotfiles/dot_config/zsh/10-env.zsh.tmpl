export EDITOR='vim'
export LANG=en_US.UTF-8

export CLAUDE_CODE_DISABLE_AUTO_MEMORY=1

# ripgrep reads no config file unless this points at one, and it is the only
# way to set defaults that also apply to the rg invocations agents and editors
# make. Exported from here rather than a shell function so those inherit it.
export RIPGREP_CONFIG_PATH="${XDG_CONFIG_HOME:-$HOME/.config}/ripgrep/config"

export BUN_INSTALL="$HOME/.bun"

# Where `pnpm add -g` links binaries; unrelated to where pnpm itself lives.
{{- if eq .chezmoi.os "darwin" }}
export PNPM_HOME="$HOME/Library/pnpm"
{{- else }}
export PNPM_HOME="$HOME/.local/share/pnpm"
{{- end }}
{{- if eq .chezmoi.os "darwin" }}

[ -d "$HOME/Library/Android/sdk" ] && export ANDROID_HOME="$HOME/Library/Android/sdk"
export JAVA_HOME=$(/usr/libexec/java_home 2>/dev/null)

# Cairo-Native builds against Homebrew LLVM rather than Apple clang. These are
# global, so they reach every compile in the shell -- move them into a project
# mise.toml if that ever causes an unrelated build to pick the wrong libc++.
if [ -d "/opt/homebrew/opt/{{ .llvm }}" ]; then
    export LDFLAGS="-L/opt/homebrew/opt/{{ .llvm }}/lib"
    export CPPFLAGS="-I/opt/homebrew/opt/{{ .llvm }}/include"
fi
{{- end }}
