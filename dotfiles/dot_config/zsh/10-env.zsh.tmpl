export EDITOR='vim'
export LANG=en_US.UTF-8

export CLAUDE_CODE_DISABLE_AUTO_MEMORY=1

# ripgrep reads no config file unless this points at one, and it is the only
# way to set defaults that also apply to the rg invocations agents and editors
# make. Exported from here rather than a shell function so those inherit it.
export RIPGREP_CONFIG_PATH="${XDG_CONFIG_HOME:-$HOME/.config}/ripgrep/config"

export BUN_INSTALL="$HOME/.bun"

# Where `pnpm add -g` links binaries; unrelated to where pnpm itself lives.
{{- if eq .chezmoi.os "darwin" }}
export PNPM_HOME="$HOME/Library/pnpm"
{{- else }}
export PNPM_HOME="$HOME/.local/share/pnpm"
{{- end }}

# Deliberately absent: LDFLAGS/CPPFLAGS pointing at Homebrew LLVM. They were
# here for Cairo-Native, but exporting them globally puts a second libc++ ahead
# of the SDK's for every compile in the shell, not just that one project. If a
# project needs them, they belong in its own mise.toml.
#
# Also absent: ANDROID_HOME and JAVA_HOME. Nothing here uses a JDK or the
# Android SDK, and `JAVA_HOME=$(/usr/libexec/java_home)` forked a subprocess on
# every shell start only to export an empty string when no JDK is installed.
