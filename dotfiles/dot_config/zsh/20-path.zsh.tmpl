typeset -U path

# Repo tools reach PATH as symlinks in ~/.local/bin, placed by the link-tools
# provisioning script, so the checkout itself does not need to be on PATH.
path=(
    "$HOME/.local/bin"
    "$HOME/.foundry/bin"
{{- if eq .chezmoi.os "darwin" }}
    "/opt/homebrew/bin"
{{- end }}
    "$HOME/go/bin"
    "$PNPM_HOME"
    $path
)

export PATH
