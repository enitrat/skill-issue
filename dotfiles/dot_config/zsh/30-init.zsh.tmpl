# Every init is guarded: a half-provisioned box should start a usable shell
# rather than print a wall of "command not found" on every prompt.

have() { command -v "$1" >/dev/null 2>&1; }

have mise     && eval "$(mise activate zsh)"
have zoxide   && eval "$(zoxide init zsh)"
have starship && eval "$(starship init zsh)"

# `fzf --zsh` is unavailable in older installations that may shadow mise on
# PATH, so verify the integration before sourcing it.
if have fzf && fzf --zsh >/dev/null 2>&1; then
    source <(fzf --zsh)
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_CTRL_T_OPTS="--preview 'bat --color=always --line-range :200 {}'"
    export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 {}'"
fi

# After fzf on purpose: both bind Ctrl-R and whichever runs last wins. Atuin's
# searchable synced history is the one worth having there.
have atuin && eval "$(atuin init zsh)"

[ -f "$HOME/.iterm2_shell_integration.zsh" ] && source "$HOME/.iterm2_shell_integration.zsh"
{{- if eq .chezmoi.os "darwin" }}
[ -f "$HOME/.starkli/env" ] && . "$HOME/.starkli/env"
[ -f "$HOME/.vite-plus/env" ] && . "$HOME/.vite-plus/env"
[ -f "$HOME/.safe-chain/scripts/init-posix.sh" ] && source "$HOME/.safe-chain/scripts/init-posix.sh"
[ -d "$HOME/.opencode/bin" ] && path=("$HOME/.opencode/bin" $path)
{{- end }}

unfunction have
