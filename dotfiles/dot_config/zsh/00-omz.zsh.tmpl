export ZSH="$HOME/.oh-my-zsh"

# Empty disables oh-my-zsh theming entirely; starship draws the prompt.
ZSH_THEME=""

# Before oh-my-zsh, which is what runs compinit -- fpath additions made after
# that point are invisible to the completion system.
fpath=(~/.zfunc(N) $fpath)

plugins=(
    virtualenv
    git
{{- if eq .chezmoi.os "darwin" }}
    macos
{{- end }}
    zsh-autosuggestions
    zsh-syntax-highlighting
    zsh-history-substring-search
{{- if eq .chezmoi.os "linux" }}
    # Needs the distro's command-not-found handler, which macOS has no
    # equivalent of -- the plugin is a silent no-op there.
    command-not-found
{{- end }}
)

[ -f "$ZSH/oh-my-zsh.sh" ] && source "$ZSH/oh-my-zsh.sh"
