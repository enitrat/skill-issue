# ~/.ssh/config — managed by chezmoi (skill-issue).
#
# Personal / host-specific entries go in ~/.ssh/config.local (NOT managed by
# chezmoi). SSH uses the FIRST value it finds for each option, and this file
# Includes config.local first — so anything there overrides the defaults
# below. Move any pre-existing "Host ..." blocks into config.local.
Include ~/.ssh/config.local

Host *
    # Connection multiplexing: reuse one TCP/auth session for repeat
    # connections to the same host. The 2nd+ ssh/scp/git-over-ssh is
    # near-instant. %C is a short hash (avoids the macOS 104-char socket
    # path limit). Sockets dir is created by run_once_after_60-ssh-setup.
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%C
    ControlPersist 10m

    # Keep long-lived sessions alive across Wi-Fi/NAT drops (pairs with mosh).
    ServerAliveInterval 30
    ServerAliveCountMax 3
    TCPKeepAlive yes

    # Hygiene: hash known_hosts entries, load keys into the agent on first use.
    HashKnownHosts yes
    AddKeysToAgent yes
{{- if eq .chezmoi.os "darwin" }}
    UseKeychain yes
{{- end }}
