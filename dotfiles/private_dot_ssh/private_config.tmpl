# ~/.ssh/config — managed by chezmoi (skill-issue). Edits here are overwritten.
#
# Put personal Host blocks in ~/.ssh/config.local instead. ssh keeps the FIRST
# value it sees for an option, so including it above the defaults lets anything
# there win.
Include ~/.ssh/config.local

Host *
    # Reuse one authenticated connection per host, so repeat ssh/scp/git calls
    # skip the handshake. %C hashes the path under the macOS 104-char limit.
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%C
    ControlPersist 10m

    # Survive Wi-Fi and NAT drops on long-lived sessions.
    ServerAliveInterval 30
    ServerAliveCountMax 3
    TCPKeepAlive yes

    HashKnownHosts yes
    AddKeysToAgent yes
{{- if eq .chezmoi.os "darwin" }}
    UseKeychain yes
{{- end }}
