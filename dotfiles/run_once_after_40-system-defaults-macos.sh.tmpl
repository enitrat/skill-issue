#!/bin/bash
set -uo pipefail
{{ template "lib.sh" . }}

# Every scriptable macOS system tweak, in one place. Runs after the Brewfile so
# the apps these settings are for already exist.

# --- Spotlight hotkey ------------------------------------------------------
# Raycast and Spotlight both want Cmd+Space, so release the macOS side of it.
# Claiming it for Raycast stays manual: Raycast stores its own hotkey outside
# `defaults`, so there is nothing scriptable to set.
PLIST="$HOME/Library/Preferences/com.apple.symbolichotkeys.plist"

if /usr/libexec/PlistBuddy -c "Print :AppleSymbolicHotKeys:64" "$PLIST" >/dev/null 2>&1; then
    /usr/libexec/PlistBuddy -c "Set :AppleSymbolicHotKeys:64:enabled false" "$PLIST"
else
    /usr/libexec/PlistBuddy \
        -c "Add :AppleSymbolicHotKeys:64 dict" \
        -c "Add :AppleSymbolicHotKeys:64:enabled bool false" \
        -c "Add :AppleSymbolicHotKeys:64:value dict" \
        -c "Add :AppleSymbolicHotKeys:64:value:type string standard" \
        -c "Add :AppleSymbolicHotKeys:64:value:parameters array" \
        -c "Add :AppleSymbolicHotKeys:64:value:parameters: integer 65535" \
        -c "Add :AppleSymbolicHotKeys:64:value:parameters: integer 49" \
        -c "Add :AppleSymbolicHotKeys:64:value:parameters: integer 1048576" \
        "$PLIST"
fi
# Neither kill actually rebinds anything: the WindowServer reads the symbolic
# hotkey table once, at login, and holds it for the session. They are here to
# flush the preference caches so the new value is what the next session reads.
# Saying "released" unqualified was wrong -- Cmd+Space keeps opening Spotlight
# until you log out, and the obvious conclusion is that the script failed.
killall SystemUIServer 2>/dev/null || true
killall cfprefsd 2>/dev/null || true
log spotlight-hotkey "Cmd+Space released (takes effect on next login)"

# --- Menu bar --------------------------------------------------------------
# Tighten spacing so icons stop sliding behind the notch. These keys must go
# under com.apple.controlcenter; the NSGlobalDomain equivalents only move
# third-party NSStatusItem apps, never Apple's own icons.
defaults write com.apple.controlcenter "NSStatusItemSpacing" -int 6
defaults write com.apple.controlcenter "NSStatusItem2ExtensionMinPadding" -int 6
log menu-bar "spacing set to 6 (takes effect on next login)"

# --- Scroll direction ------------------------------------------------------
# Off = content moves the way the fingers do NOT, i.e. the pre-"natural"
# behaviour. There is no trackpad-only key for this: it is one global setting,
# so an external mouse inverts with it.
defaults write NSGlobalDomain com.apple.swipescrolldirection -bool false
log scroll-direction "natural scrolling disabled (takes effect on next login)"

# --- Window tabbing --------------------------------------------------------
# Prefer tabs over new windows. Electron editors ignore AppleWindowTabbingMode,
# so they need the equivalent flipped in their own settings.json.
defaults write -g AppleWindowTabbingMode -string always
log window-tabbing "AppleWindowTabbingMode=always"

set_open_in_same_window() {
    local name="$1" settings="$2"
    # Don't conjure a settings dir for an editor that isn't installed.
    [ -d "$(dirname "$settings")" ] || return 0
    python3 - "$settings" <<'PY' && log window-tabbing "${name} set to reuse window"
import json
import sys

path = sys.argv[1]
try:
    with open(path) as f:
        data = json.load(f)
except (FileNotFoundError, json.JSONDecodeError):
    data = {}

if data.get("window.openFoldersInNewWindow") == "off":
    sys.exit(1)

data["window.openFoldersInNewWindow"] = "off"
with open(path, "w") as f:
    json.dump(data, f, indent=4)
    f.write("\n")
PY
}

set_open_in_same_window "Cursor" "$HOME/Library/Application Support/Cursor/User/settings.json"
set_open_in_same_window "VS Code" "$HOME/Library/Application Support/Code/User/settings.json"

echo
echo "Next: open Raycast > Settings (Cmd+,) > General and set 'Raycast Hotkey'"
echo "to Cmd+Space - Raycast has no defaults key for it."
