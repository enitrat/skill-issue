{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail

# Prefer tabs over new windows: native apps (Finder, TextEdit, ...) via the
# macOS window-tabbing default, plus Cursor/VS Code via their own setting
# (they're Electron apps and ignore AppleWindowTabbingMode).

defaults write -g AppleWindowTabbingMode -string always
echo "[window-tabbing] AppleWindowTabbingMode=always"

set_open_in_same_window() {
    local name="$1" settings="$2"
    mkdir -p "$(dirname "$settings")"
    if python3 - "$settings" <<'PY'
import json
import sys

path = sys.argv[1]
try:
    with open(path) as f:
        data = json.load(f)
except (FileNotFoundError, json.JSONDecodeError):
    data = {}

if data.get("window.openFoldersInNewWindow") == "off":
    sys.exit(1)

data["window.openFoldersInNewWindow"] = "off"
with open(path, "w") as f:
    json.dump(data, f, indent=4)
    f.write("\n")
PY
    then
        echo "[window-tabbing] ${name} set to reuse window (window.openFoldersInNewWindow=off)"
    else
        echo "[window-tabbing] ${name} already set to reuse window, skipping"
    fi
}

cursor_settings="$HOME/Library/Application Support/Cursor/User/settings.json"
if [ -d "$(dirname "$cursor_settings")" ] || command -v cursor >/dev/null 2>&1; then
    set_open_in_same_window "Cursor" "$cursor_settings"
fi

vscode_settings="$HOME/Library/Application Support/Code/User/settings.json"
if [ -d "$(dirname "$vscode_settings")" ] || command -v code >/dev/null 2>&1; then
    set_open_in_same_window "VS Code" "$vscode_settings"
fi
{{ else -}}
#!/bin/bash
exit 0
{{ end -}}
