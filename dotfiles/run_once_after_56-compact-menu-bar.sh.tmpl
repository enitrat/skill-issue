{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail

# Tighten menu bar spacing so icons stop sliding behind the notch. These keys
# must go under com.apple.controlcenter; the NSGlobalDomain equivalents only
# move third-party NSStatusItem apps, never Apple's own icons.
# Takes effect on next login -- killall does not reload it.

defaults write com.apple.controlcenter "NSStatusItemSpacing" -int 6
defaults write com.apple.controlcenter "NSStatusItem2ExtensionMinPadding" -int 6
echo "[compact-menu-bar] com.apple.controlcenter spacing/padding set to 6 (log out to apply)"
{{ else -}}
#!/bin/bash
exit 0
{{ end -}}
