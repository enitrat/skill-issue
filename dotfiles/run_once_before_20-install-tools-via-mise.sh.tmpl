#!/bin/bash
set -euo pipefail

export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"

if ! command -v mise >/dev/null 2>&1; then
    echo "[mise] not found on PATH, cannot install tools. Open a new shell and re-run 'chezmoi apply'." >&2
    exit 1
fi

# Keep CLI tools here rather than in per-OS package managers: mise's
# aqua/github/cargo backends give the same versions on macOS and Linux.
mise use -g \
    atuin bat delta eza fd fzf gh ripgrep starship tmux zoxide difftastic uv \
    node@lts python@latest go@latest rust@latest bun@latest pnpm@latest \
    github:abhinav/git-spice \
    github:joshmedeski/sesh

mise use -g carapace || echo "[carapace] install failed, skipping (non-critical)" >&2

# uv, not mise's pipx backend -- that backend needs a pre-existing pipx.
uv tool install httpie || echo "[httpie] uv tool install failed, skipping (non-critical)" >&2

# mergiraf is hosted on GitLab with no release binaries, so it must be built.
mise use -g cargo:mergiraf || echo "[mergiraf] cargo build failed, skipping (non-critical)" >&2
