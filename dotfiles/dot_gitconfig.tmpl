# ~/.gitconfig — managed by chezmoi (skill-issue). Edits here are overwritten.
#
# Identity is NOT here: `git-id` writes it to ~/.gitconfig.local, included at
# the bottom. Git resolves later values over earlier ones, so anything in the
# local file wins. Put hand-rolled settings there too.

[core]
	pager = delta
	excludesfile = ~/.gitignore.global
	# Git defaults to ~/.config/git/attributes, so this has to be explicit.
	attributesFile = ~/.gitattributes
	# Native filesystem watcher (FSEvents on macOS, inotify-backed daemon on
	# Linux). Turns `git status` in a large checkout from a full tree walk into
	# a query against the daemon. untrackedCache is the other half: without it
	# the watcher still has to re-scan for untracked files.
	fsmonitor = true
	untrackedCache = true

[branch]
	# Most-recently-committed first. `git branch` in a long-lived repo is
	# otherwise an alphabetical list where everything current is in the middle.
	sort = -committerdate

[column]
	# Lay branch/tag/status listings out in columns when the terminal is wide
	# enough, instead of one item per line.
	ui = auto

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	# Matches the starship prompt palette.
	syntax-theme = gruvbox-dark

[diff]
	# Detect moved lines instead of showing them as a delete plus an add.
	colorMoved = default
	algorithm = histogram

[merge]
	# zdiff3 shows the common ancestor in conflicts, which turns a lot of
	# "which side is right" guessing into reading.
	conflictstyle = zdiff3

# Git has no fallback when a configured merge driver is missing; the wrapper
# uses Git's three-way merge when Mergiraf is unavailable or unsupported.
[merge "mergiraf"]
	name = mergiraf
	driver = git-mergiraf %O %A %B %S %X %Y %P %L

[alias]
	# Structural diff, opt-in per invocation -- difftastic is far slower than
	# delta and does not pipe, so it is wrong as the default.
	dft = -c diff.external=difft diff
	dfts = -c diff.external=difft show
	rebase-last-five = "!b=\"$(git rev-parse --abbrev-ref HEAD)\" ; h=\"$(git rev-parse $b)\" ; echo \"Current branch: $b $h\" ; c=\"$(git rev-parse $b~4)\" ; echo \"Recreating $b branch with initial commit $c ...\" ; git checkout --orphan new-start $c ; git commit -C $c ; git rebase --onto new-start $c $b ; git branch -d new-start ; git gc"
	# Catch up to the default branch in one word. The branch name is read from
	# origin/HEAD rather than assumed to be main -- that ref is written at clone
	# time, and `git remote set-head origin -a` repairs it if it is missing.
	fomo = "!f() { b=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null); b=${b#origin/}; git fetch origin \"${b:=main}\" && git rebase \"origin/$b\" --autostash; }; f"

[fetch]
	prune = true
	# Keep the commit-graph current on every fetch. Ancestry queries -- log
	# --graph, merge-base, the "ahead/behind" the prompt asks for on each
	# prompt -- read it instead of walking commits.
	writeCommitGraph = true

[rebase]
	autosquash = true
	autostash = true
	# When a rebase moves commits, move every branch pointing into the rebased
	# range with them. This is what makes a stack survive a rebase of its base
	# -- the same bookkeeping git-spice does explicitly, applied to plain
	# `git rebase` too.
	updateRefs = true

[rerere]
	# Record how each conflict was resolved and replay it when the same
	# conflict reappears. Rebasing a stack means meeting identical conflicts
	# once per branch; this resolves all but the first automatically.
	enabled = true

[push]
	autoSetupRemote = true

[init]
	defaultBranch = main

[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
{{ if eq .chezmoi.os "darwin" }}
[credential]
	helper = osxkeychain
{{ end }}
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

# Last, so ~/.gitconfig.local overrides everything above.
[include]
	path = ~/.gitconfig.local
