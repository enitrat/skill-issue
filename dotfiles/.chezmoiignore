# Per-OS files are omitted before their templates or scripts are evaluated.
{{ if ne .chezmoi.os "darwin" }}
.chezmoiscripts/*-macos.sh
.config/homebrew/Brewfile
# Cocoa-only: ~/Library is a macOS path and no Linux app reads this keymap.
Library
{{ end }}
{{ if ne .chezmoi.os "linux" }}
.chezmoiscripts/*-linux.sh
{{ end }}

# Host-class file selection, same idea. Defaults live in .chezmoidata/host.toml;
# a machine opts in from its own chezmoi config.
{{ if not .ephemeral_host }}
.config/zsh/00-ephemeral-host.zsh
{{ end }}
