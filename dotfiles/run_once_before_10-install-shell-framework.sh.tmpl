#!/bin/bash
set -euo pipefail

{{ if eq .chezmoi.os "linux" -}}
if command -v apt-get >/dev/null 2>&1; then
    sudo DEBIAN_FRONTEND=noninteractive apt-get update -y
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y zsh git curl build-essential unzip locales
elif command -v dnf >/dev/null 2>&1; then
    sudo dnf install -y zsh git curl @development-tools unzip glibc-langpack-en
elif command -v pacman >/dev/null 2>&1; then
    sudo pacman -Sy --noconfirm zsh git curl base-devel unzip
else
    echo "[shell] no supported package manager (apt/dnf/pacman) found, skipping zsh install" >&2
fi

# Ensure a UTF-8 locale is generated (avoids 'setting locale failed' warnings
# and broken prompt glyphs when viewed through a Nerd-Font-capable terminal).
if command -v locale-gen >/dev/null 2>&1 && ! locale -a 2>/dev/null | grep -qi "en_US.utf8"; then
    sudo locale-gen en_US.UTF-8 || true
    sudo update-locale LANG=en_US.UTF-8 || true
fi
{{ end -}}

ZSH_CUSTOM="$HOME/.oh-my-zsh/custom"

if [ -d "$HOME/.oh-my-zsh" ]; then
    echo "[oh-my-zsh] already installed, skipping"
else
    sh -c "$(curl -fsSL https://raw.github.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
fi

clone_plugin() {
    local name="$1"
    local url="$2"
    local dest="$ZSH_CUSTOM/plugins/$name"
    if [ -d "$dest" ]; then
        echo "[$name] already installed, skipping"
    else
        git clone --depth=1 "$url" "$dest"
    fi
}

clone_plugin zsh-autosuggestions https://github.com/zsh-users/zsh-autosuggestions
clone_plugin zsh-syntax-highlighting https://github.com/zsh-users/zsh-syntax-highlighting.git
clone_plugin zsh-history-substring-search https://github.com/zsh-users/zsh-history-substring-search
