#!/bin/bash
set -uo pipefail
{{ template "lib.sh" . }}

# Re-runs whenever the cask/formula inventory changes.
# casks:    {{ .cask | toJson | sha256sum }}
# formulae: {{ .formula | toJson | sha256sum }}

if ! brew_path; then
    warn brew-bundle "Homebrew not found at /opt/homebrew or /usr/local."
    warn brew-bundle "10-bootstrap-macos should have installed it -- check its"
    warn brew-bundle "output above, then re-run 'chezmoi apply'."
    exit 1
fi

BREWFILE="$HOME/.config/homebrew/Brewfile"
if [ ! -f "$BREWFILE" ]; then
    warn brew-bundle "$BREWFILE not found. chezmoi writes it before this script"
    warn brew-bundle "runs, so its absence means the apply is in a broken state."
    exit 1
fi

log brew-bundle "applying $BREWFILE"
brew_bundle_failed=0
brew bundle --no-upgrade --file "$BREWFILE" || brew_bundle_failed=1

{{ if .remove_docker_desktop -}}
for c in docker-desktop docker; do
    if brew list --cask "$c" >/dev/null 2>&1; then
        log docker "removing Docker Desktop cask '$c'"
        brew uninstall --cask --force "$c" || warn docker "failed to remove '$c'"
    fi
done

# A hand-installed copy is only flagged, never deleted.
if [ -d "/Applications/Docker.app" ]; then
    warn docker "/Applications/Docker.app is present but not Homebrew-managed."
    warn docker "Quit it and drag it to the Trash to avoid conflicting with OrbStack."
fi
{{ end -}}

# Last, so the Docker cleanup above still runs on a partial Brewfile failure.
if [ "$brew_bundle_failed" -ne 0 ]; then
    warn brew-bundle "one or more Brewfile entries failed to install."
    warn brew-bundle "Fix the entry in dotfiles/.chezmoidata/packages.toml, or"
    warn brew-bundle "comment it out, then re-run 'chezmoi apply'."
    exit 1
fi
