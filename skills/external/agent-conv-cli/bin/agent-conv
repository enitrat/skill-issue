#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     "click==8.3.3",
# ]
# ///
"""Read your own local Claude Code / Codex CLI / Cursor conversation history.

Claude Code writes every session to `~/.claude/projects/<cwd-encoded>/<uuid>.jsonl`
— one JSON-lines file per session, in (roughly) the Anthropic Messages API shape:
each line is an event with a `type` (`user` / `assistant` / bookkeeping types like
`mode`, `file-history-snapshot`, `attachment`), and `message.content` is either a
plain string or a list of content blocks (`text`, `thinking`, `tool_use`,
`tool_result`). This is the personal-history counterpart to the iMessage/WhatsApp/
Slack/Telegram readers.

Same shape as Slack, one level up: a project (the directory you ran an agent
in) is a channel, and a session IS a thread — an anchor message (its first
turn) plus every turn tied to it. So the command set mirrors Slack's exactly,
across all three sources at once:

* **Three sources, one model.** Claude Code writes
  `~/.claude/projects/<cwd-encoded>/<uuid>.jsonl` (Anthropic Messages API
  shape). Codex CLI writes `~/.codex/sessions/<Y>/<m>/<d>/rollout-*.jsonl` +
  `~/.codex/archived_sessions/*.jsonl` (OpenAI Responses-API shape: `message`/
  `reasoning`/`function_call`/`function_call_output` items, plus narrated
  `event_msg` lines). Cursor stores everything in SQLite —
  `~/Library/Application Support/Cursor/User/globalStorage/state.vscdb`, a
  `composerHeaders` table (one row per chat, with a *real* stored title and
  unread flag — the only one of the three that has either) and a
  `cursorDiskKV` blob table keyed by `composerData:<id>` (the thread's bubble
  order) and `bubbleId:<composerId>:<bubbleId>` (each bubble's text). Every
  backend normalizes into the same `Turn(ts, role, blocks)` shape, so
  rendering/cleaning/search all work identically regardless of source.
* **The directory name is not the source of truth for the project path**
  (Claude Code, and Cursor's workspace hash). Claude Code encodes the cwd by
  replacing path separators (and dots) with `-`, lossy on its own (a real dash
  in a folder name is indistinguishable from an encoded slash) — every event
  line carries the *actual* `cwd` instead, so that's what gets reconciled
  against the directory name. Cursor's workspace id resolves to a real path
  via that workspace's own `workspace.json`. Codex just stores the real `cwd`
  directly per session (no project-level bucketing at all — sessions across
  all projects share one date-tree, so this CLI groups them by cwd itself).
* `chats` lists projects/channels across every source (most recently active
  first, tagged). `read` mirrors Slack's `read <channel>`: bare, it lists
  every thread's anchor (the channel's top-level view); `--expand` inlines
  every thread's full content, like `--expand-thread`. `thread <query>`
  mirrors Slack's `thread <channel> <ts>`: reads exactly one thread in full
  (defaults to the most recent; `--nth`/`--session` to pick another). `search`
  full-text-searches across everything; `find` locates a thread by its
  derived title (name) across every project. `--source claude|codex|cursor`
  scopes any of these to one backend. `fork`/`send` hand off to a real
  `claude --resume [--fork-session]` process to continue a past Claude Code
  thread live or headlessly — Claude-only for now (Codex has an analogous
  `codex exec resume`, but no fork; Cursor has no CLI at all). `port` goes
  cross-provider: it seeds a **brand-new** session with a different provider
  (`--into claude|codex`) using the source thread's rendered transcript as
  the opening prompt, since no provider can literally resume another's
  session format — Cursor can only ever be a `--source` for this, never a
  target, as it has no CLI to seed a chat with a prompt at all.

Reading is entirely local and read-only — each tool owns its own files and
nothing here mutates them (Cursor's `state.vscdb` is opened via a read-only
`mode=ro` URI connection rather than a snapshot copy, since the live database
is 1GB+; SQLite's own WAL-reader consistency guarantees mean a live Cursor
instance writing to it is never disturbed). `fork`, `send`, and `port` are
the commands that act: they shell out to the `claude`/`codex` binaries
themselves (a real write/launch action), and all three default to a dry-run
like the personal-messaging CLIs' `send` commands do.
"""

from __future__ import annotations

import json
import logging
import os
import re
import shlex
import shutil
import sqlite3
import subprocess
import sys
import tempfile
from dataclasses import dataclass, field
from datetime import datetime, timezone
from pathlib import Path

import click

if sys.platform == "win32":
    # Windows consoles default to a legacy codepage (cp1252); transcripts are
    # UTF-8, so accented text otherwise mojibakes or raises UnicodeEncodeError.
    for _stream in (sys.stdout, sys.stderr):
        if hasattr(_stream, "reconfigure"):
            _stream.reconfigure(encoding="utf-8", errors="replace")

logging.basicConfig(
    level=logging.WARNING, format="%(levelname)s: %(message)s", stream=sys.stderr
)
log = logging.getLogger("agent-conv")

SOURCES = ("claude", "codex", "cursor")

CLAUDE_HOME = Path(os.environ.get("CLAUDE_CONFIG_DIR", str(Path.home() / ".claude")))
PROJECTS_DIR = CLAUDE_HOME / "projects"

CODEX_HOME = Path(os.environ.get("CODEX_HOME", str(Path.home() / ".codex")))
CODEX_SESSION_DIRS = [CODEX_HOME / "sessions", CODEX_HOME / "archived_sessions"]

if sys.platform == "darwin":
    _cursor_default = Path.home() / "Library" / "Application Support" / "Cursor" / "User"
elif sys.platform.startswith("linux"):
    _cursor_default = Path.home() / ".config" / "Cursor" / "User"
else:
    _cursor_default = Path(os.environ.get("APPDATA", str(Path.home()))) / "Cursor" / "User"
CURSOR_USER_DIR = Path(os.environ.get("CURSOR_USER_DIR", str(_cursor_default)))
CURSOR_GLOBAL_DB = CURSOR_USER_DIR / "globalStorage" / "state.vscdb"
CURSOR_WORKSPACE_STORAGE = CURSOR_USER_DIR / "workspaceStorage"

# This tool's own bookkeeping — deliberately NOT under ~/.claude, since Claude
# Code owns that directory and this CLI never writes into it. Claude Code and
# Codex have no concept of read/unread; Cursor does (its own composerHeaders
# flag, read directly — never written to by this tool). This file only ever
# tracks Claude Code and Codex threads.
STATE_DIR = Path(os.environ.get("AGENT_CONV_STATE_DIR", str(Path.home() / ".config" / "agent-conv-cli")))
READ_STATE_FILE = STATE_DIR / "read-state.json"

_SYSTEM_REMINDER_RE = re.compile(r"<system-reminder>.*?</system-reminder>", re.DOTALL)
_TASK_NOTIFICATION_RE = re.compile(r"<task-notification>.*?</task-notification>", re.DOTALL)
_COMMAND_WRAPPER_RE = re.compile(
    r"<command-message>.*?</command-message>\s*<command-name>(.*?)</command-name>",
    re.DOTALL,
)


# ---------------------------------------------------------------------------
# Reading transcripts
# ---------------------------------------------------------------------------


@dataclass
class Turn:
    ts: str  # ISO 8601, as stored
    role: str  # "user" | "assistant"
    blocks: list[dict] = field(default_factory=list)


@dataclass
class ProjectHandle:
    """A channel — one real project directory, from one source."""

    source: str  # "claude" | "codex" | "cursor"
    cwd: str
    key: str  # opaque, backend-specific: re-fetches this project's sessions


@dataclass
class SessionHandle:
    """A thread — one conversation, from one source. Backends fill in only
    the locator field(s) they need (`path` for claude/codex; `composer_id`
    for cursor) and leave the rest at their default."""

    source: str
    uuid: str  # display id: session uuid (claude/codex) or composerId (cursor)
    project_cwd: str
    mtime: float = 0.0  # last-activity epoch, for sorting/unread
    path: Path | None = None
    composer_id: str | None = None
    unread_native: bool | None = None  # cursor's own hasUnreadMessages flag
    title_hint: str | None = None  # cursor stores a real title; others derive one


def _session_files(project_dir: Path) -> list[Path]:
    """This project's session transcripts, most recently modified first."""
    return sorted(
        (p for p in project_dir.glob("*.jsonl") if p.is_file()),
        key=lambda p: p.stat().st_mtime,
        reverse=True,
    )


def _iter_project_dirs():
    if not PROJECTS_DIR.is_dir():
        raise click.ClickException(
            f"{PROJECTS_DIR} not found — is this a machine with Claude Code history?"
        )
    for entry in PROJECTS_DIR.iterdir():
        if entry.is_dir() and _session_files(entry):
            yield entry


def _normalize_content(content) -> list[dict]:
    """`message.content` is either a bare string or a list of content blocks."""
    if isinstance(content, str):
        return [{"type": "text", "text": content}]
    if isinstance(content, list):
        return [b for b in content if isinstance(b, dict)]
    return []


def _iter_turns(path: Path, include_subagents: bool = False):
    """Yield Turn objects for the real conversation (user/assistant) events.

    Bookkeeping line types (`mode`, `file-history-snapshot`, `attachment`, ...)
    and, by default, subagent/sidechain branches are skipped.
    """
    with path.open(encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                continue
            if event.get("type") not in ("user", "assistant"):
                continue
            if event.get("isSidechain") and not include_subagents:
                continue
            message = event.get("message") or {}
            role = message.get("role") or event.get("type")
            blocks = _normalize_content(message.get("content"))
            if not blocks:
                continue
            yield Turn(ts=event.get("timestamp", ""), role=role, blocks=blocks)


def _claude_session_tokens(path: Path) -> int | None:
    """Input + output tokens summed across this session's assistant turns
    (including subagents — real usage incurred regardless of how it's
    rendered). Deliberately excludes `cache_read`/`cache_creation`: with
    prompt caching, a long session's later turns each re-read nearly its
    whole (ever-growing) context from cache, so summing cache fields across
    turns scales with turns × context-size and balloons into the hundreds of
    millions for long sessions — not a meaningful measure of how much was
    actually exchanged. input/output alone tracks that instead."""
    total = 0
    found = False
    with path.open(encoding="utf-8") as f:
        for line in f:
            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                continue
            if event.get("type") != "assistant":
                continue
            usage = (event.get("message") or {}).get("usage")
            if not usage:
                continue
            found = True
            total += usage.get("input_tokens", 0) + usage.get("output_tokens", 0)
    return total if found else None


def _session_cwd(path: Path) -> str | None:
    """The working directory this session *started* in (its first recorded
    `cwd`). A single session can `cd` around afterwards — later events carry
    whatever the shell's cwd was at that point, not the session's identity —
    so this intentionally only looks at the first line that has one."""
    with path.open(encoding="utf-8") as f:
        for line in f:
            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                continue
            cwd = event.get("cwd")
            if cwd:
                return cwd
    return None


def _encode_path(cwd: str) -> str:
    """Reproduce Claude Code's lossy directory-name encoding for a cwd (every
    `/` and `.` becomes `-`), so a candidate cwd can be checked against a real
    project-directory name on disk."""
    return re.sub(r"[/.]", "-", cwd)


def _project_cwd(project_dir: Path) -> str:
    """The cwd that identifies this project directory.

    A session's *first* `cwd` isn't reliable for this: a session can start in
    a parent repo and only `cd` into e.g. a git worktree afterwards (seen in
    practice — Claude Code still files it under the worktree's encoded
    directory name). So instead this scans the `cwd` values actually seen
    across the project's files and picks whichever one re-encodes to exactly
    this directory's name — the one Claude Code itself used to name it.
    Falls back to the newest file's first cwd, then the raw directory name.
    """
    files = _session_files(project_dir)
    fallback = None
    for path in files:
        with path.open(encoding="utf-8") as f:
            for line in f:
                try:
                    event = json.loads(line)
                except json.JSONDecodeError:
                    continue
                cwd = event.get("cwd")
                if not cwd:
                    continue
                if fallback is None:
                    fallback = cwd
                if _encode_path(cwd) == project_dir.name:
                    return cwd
    return fallback or project_dir.name


def _claude_iter_projects():
    for d in _iter_project_dirs():
        yield ProjectHandle(source="claude", cwd=_project_cwd(d), key=str(d))


def _claude_project_sessions(project: ProjectHandle) -> list[SessionHandle]:
    return [
        SessionHandle(
            source="claude",
            uuid=f.stem,
            project_cwd=project.cwd,
            path=f,
            mtime=f.stat().st_mtime,
        )
        for f in _session_files(Path(project.key))
    ]


# ---------------------------------------------------------------------------
# Rendering (shared by all three backends — every backend normalizes into
# the same Turn(ts, role, blocks) shape, using the same block vocabulary:
# {"type": "text"|"thinking"|"tool_use"|"tool_result", ...})
# ---------------------------------------------------------------------------


def _clean_text(text: str) -> str:
    """Strip noise not meaningful to a human reader of the transcript."""
    text = _SYSTEM_REMINDER_RE.sub("", text)
    text = _TASK_NOTIFICATION_RE.sub("", text)
    text = _COMMAND_WRAPPER_RE.sub(lambda m: m.group(1), text)
    return text.strip()


def _tool_summary(block: dict) -> str:
    name = block.get("name", "?")
    tool_input = block.get("input", {})
    snippet = json.dumps(tool_input, ensure_ascii=False)
    if len(snippet) > 120:
        snippet = snippet[:117] + "..."
    return f"→ {name}({snippet})"


def _tool_result_summary(block: dict) -> str:
    content = block.get("content")
    if isinstance(content, list):
        text = " ".join(
            b.get("text", "") for b in content if isinstance(b, dict) and b.get("text")
        )
    else:
        text = str(content or "")
    text = text.replace("\n", " ").strip()
    if len(text) > 200:
        text = text[:197] + "..."
    return f"← {text}"


def _render_turn(turn: Turn, raw: bool) -> str | None:
    """One display line (or None if nothing worth showing).

    In compact mode (raw=False) a turn that was pure tool-calling / a bare
    tool_result round-trip carries no prose at all — it's dropped entirely
    rather than shown as a placeholder.
    """
    parts: list[str] = []
    for block in turn.blocks:
        bt = block.get("type")
        if bt == "text":
            cleaned = _clean_text(block.get("text", ""))
            if cleaned:
                parts.append(cleaned)
        elif bt == "thinking" and raw:
            thinking = block.get("thinking", "").strip()
            if thinking:
                parts.append(f"[thinking] {thinking}")
        elif bt == "tool_use" and raw:
            parts.append(_tool_summary(block))
        elif bt == "tool_result" and raw:
            parts.append(_tool_result_summary(block))
    if not parts:
        return None
    return "\n".join(parts)


def _is_command_wrapper_turn(turn: Turn) -> bool:
    """A user turn whose text is (or contains) the `<command-message>...
    <command-name>...` wrapper — the "/name" trigger, before Claude Code's
    separate follow-up turn expands it into the full command body."""
    return turn.role == "user" and any(
        b.get("type") == "text" and _COMMAND_WRAPPER_RE.search(b.get("text", ""))
        for b in turn.blocks
    )


def _drop_tool_injected_followups(turns: list[Turn]) -> list[Turn]:
    """Drop a "user" turn that is really injected content, not human input.

    Two distinct cases produce this, both a bare-text `user` turn immediately
    following another `user` turn with no assistant turn in between — never
    something a human typed, since a real reply always follows an assistant
    turn:

    1. **A tool's injected payload.** Some tools (Skill is the main one)
       reply with a short `tool_result` ack *and then a separate, later*
       `user` turn carrying the tool's actual payload as plain text (e.g. a
       whole SKILL.md body) — genuine API replies from a tool always live
       inside the `tool_result` block itself.
    2. **A slash command's expansion.** Typing e.g. `/deploy-checklist` sends
       one `user` turn with just the `<command-message>/<command-name>`
       wrapper (cleaned to `/deploy-checklist` by `_clean_text`), then Claude Code
       appends a second `user` turn with the command file's *entire expanded
       body* substituted in — the actual prompt sent to the model, not
       something the human typed or would want to see again.

    Only applies in compact mode; --raw keeps everything.
    """
    filtered: list[Turn] = []
    last_tool_names: set[str] = set()
    prev_role: str | None = None
    prev_was_command_wrapper = False
    for t in turns:
        is_bare_text = all(b.get("type") == "text" for b in t.blocks)
        is_synthetic_followup = (
            t.role == "user"
            and prev_role == "user"
            and is_bare_text
            and ("Skill" in last_tool_names or prev_was_command_wrapper)
        )
        if is_synthetic_followup:
            prev_role = t.role
            prev_was_command_wrapper = False
            continue
        if t.role == "assistant":
            last_tool_names = {
                b.get("name") for b in t.blocks if b.get("type") == "tool_use"
            }
        prev_was_command_wrapper = _is_command_wrapper_turn(t)
        filtered.append(t)
        prev_role = t.role
    return filtered


def _local_ts(iso_ts: str) -> str:
    if not iso_ts:
        return "?"
    try:
        dt = datetime.fromisoformat(iso_ts.replace("Z", "+00:00"))
    except ValueError:
        return iso_ts
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    return dt.astimezone().strftime("%Y-%m-%d %H:%M")


def _format_tokens(n: int | None) -> str:
    if n is None:
        return "?"
    if n >= 1_000_000:
        return f"{n / 1_000_000:.1f}M"
    if n >= 1_000:
        return f"{n / 1_000:.1f}k"
    return str(n)


def _session_title(path: Path, max_len: int = 100) -> str:
    """First substantive thing the user said, as a stand-in for a chat title —
    Claude Code doesn't store one."""
    for turn in _iter_turns(path):
        if turn.role != "user":
            continue
        rendered = _render_turn(turn, raw=False)
        if rendered:
            title = rendered.replace("\n", " ").strip()
            return title[: max_len - 1] + "…" if len(title) > max_len else title
    return "(untitled session)"


# ---------------------------------------------------------------------------
# Codex CLI backend
#
# ~/.codex/sessions/<Y>/<m>/<d>/rollout-*.jsonl and ~/.codex/archived_sessions/
# — OpenAI Responses-API shape, not bucketed by project at all (every session
# from every project shares one date-tree), so this backend groups sessions by
# their own recorded cwd itself, cached per process since that requires
# reading every file at least once.
# ---------------------------------------------------------------------------

_AGENTS_MD_PREFIX = "# AGENTS.md instructions for "
_codex_project_cache: dict[str, list[Path]] | None = None


def _codex_all_session_files() -> list[Path]:
    files: list[Path] = []
    for d in CODEX_SESSION_DIRS:
        if d.is_dir():
            files.extend(p for p in d.rglob("*.jsonl") if p.is_file())
    return sorted(files, key=lambda p: p.stat().st_mtime, reverse=True)


def _codex_session_meta(path: Path) -> dict:
    """The `session_meta` line — always first in practice, but this scans a
    few lines defensively. Gives `cwd` and the real `session_id` (the rollout
    filename's UUID, redundantly, but session_meta is the authoritative
    source rather than parsing the filename)."""
    with path.open(encoding="utf-8") as f:
        for i, line in enumerate(f):
            if i > 5:
                break
            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                continue
            if event.get("type") == "session_meta":
                payload = event.get("payload") or {}
                return {"cwd": payload.get("cwd"), "session_id": payload.get("session_id")}
    return {}


def _codex_projects_map() -> dict[str, list[Path]]:
    global _codex_project_cache
    if _codex_project_cache is None:
        by_cwd: dict[str, list[Path]] = {}
        for f in _codex_all_session_files():
            cwd = _codex_session_meta(f).get("cwd")
            if cwd:
                by_cwd.setdefault(cwd, []).append(f)
        _codex_project_cache = by_cwd
    return _codex_project_cache


def _codex_iter_projects():
    if not any(d.is_dir() for d in CODEX_SESSION_DIRS):
        return
    for cwd in _codex_projects_map():
        yield ProjectHandle(source="codex", cwd=cwd, key=cwd)


def _codex_project_sessions(project: ProjectHandle) -> list[SessionHandle]:
    files = _codex_projects_map().get(project.cwd, [])
    out = []
    for f in files:
        meta = _codex_session_meta(f)
        out.append(
            SessionHandle(
                source="codex",
                uuid=meta.get("session_id") or f.stem,
                project_cwd=project.cwd,
                path=f,
                mtime=f.stat().st_mtime,
            )
        )
    return out


def _codex_iter_turns(path: Path):
    """Normalize Codex's `response_item` stream (OpenAI Responses-API items)
    into the common Turn/blocks shape. `developer`-role messages (Codex's
    permissions/sandbox preamble) are never yielded at all — same as Claude's
    own system prompt never appearing as a turn."""
    with path.open(encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                continue
            if event.get("type") != "response_item":
                continue
            payload = event.get("payload") or {}
            ts = event.get("timestamp", "")
            pt = payload.get("type")

            if pt == "message":
                role = payload.get("role")
                if role == "developer":
                    continue
                texts = [
                    b.get("text", "")
                    for b in (payload.get("content") or [])
                    if isinstance(b, dict) and b.get("type") in ("input_text", "output_text") and b.get("text")
                ]
                if texts:
                    yield Turn(ts=ts, role=role, blocks=[{"type": "text", "text": t} for t in texts])
            elif pt == "reasoning":
                texts = [
                    s.get("text", "")
                    for s in (payload.get("summary") or [])
                    if isinstance(s, dict) and s.get("text")
                ]
                if texts:
                    yield Turn(ts=ts, role="assistant", blocks=[{"type": "thinking", "thinking": "\n".join(texts)}])
            elif pt == "function_call":
                try:
                    tool_input = json.loads(payload.get("arguments") or "{}")
                except json.JSONDecodeError:
                    tool_input = {"raw": payload.get("arguments")}
                yield Turn(ts=ts, role="assistant", blocks=[{"type": "tool_use", "name": payload.get("name", "?"), "input": tool_input}])
            elif pt == "function_call_output":
                yield Turn(ts=ts, role="user", blocks=[{"type": "tool_result", "content": payload.get("output")}])
            elif pt in ("tool_search_call", "web_search_call", "custom_tool_call"):
                name = payload.get("name") or pt
                tool_input = payload.get("arguments") or payload.get("action") or payload.get("input") or {}
                yield Turn(ts=ts, role="assistant", blocks=[{"type": "tool_use", "name": name, "input": tool_input}])
            elif pt in ("tool_search_output", "custom_tool_call_output"):
                content = payload.get("output")
                if content is None:
                    content = payload.get("tools")
                yield Turn(ts=ts, role="user", blocks=[{"type": "tool_result", "content": content}])


def _codex_drop_noise(turns: list[Turn]) -> list[Turn]:
    """Drop the AGENTS.md dump Codex prepends as its own separate `user` turn
    (distinct from Claude's noise pattern: here it's the *first* of the two
    turns that's synthetic, identified by its distinctive prefix, not a
    positional "second consecutive user turn" rule)."""
    out = []
    for t in turns:
        if t.role == "user" and all(b.get("type") == "text" for b in t.blocks):
            text = " ".join(b.get("text", "") for b in t.blocks)
            if text.startswith(_AGENTS_MD_PREFIX):
                continue
        out.append(t)
    return out


def _codex_session_tokens(path: Path) -> int | None:
    """Sum each API call's *new* tokens (`last_token_usage.input_tokens -
    cached_input_tokens + output_tokens`) across every `token_count` event.

    `total_token_usage` looks tempting (it's a ready-made running total) but
    it has the same problem as Claude Code's cache fields: each call resends
    nearly the whole growing conversation, and `total_token_usage.input_tokens`
    is a cumulative sum of those ever-growing per-call inputs — it balloons
    into the tens of millions for long sessions (verified: 22M on a 292-turn
    session, dominated by `cached_input_tokens`). Summing each call's non-cached
    input + output instead tracks genuinely new content, consistent with how
    Claude Code's total is computed."""
    total = 0
    found = False
    with path.open(encoding="utf-8") as f:
        for line in f:
            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                continue
            if event.get("type") != "event_msg":
                continue
            payload = event.get("payload") or {}
            if payload.get("type") != "token_count":
                continue
            usage = (payload.get("info") or {}).get("last_token_usage")
            if not usage:
                continue
            found = True
            total += (
                usage.get("input_tokens", 0)
                - usage.get("cached_input_tokens", 0)
                + usage.get("output_tokens", 0)
            )
    return total if found else None


# ---------------------------------------------------------------------------
# Cursor backend
#
# Everything lives in one SQLite database:
# ~/Library/Application Support/Cursor/User/globalStorage/state.vscdb —
# `composerHeaders` (one row per chat: composerId, workspaceId, a JSON
# `value` with the real title + native unread flag) and `cursorDiskKV` (blob
# store: `composerData:<id>` gives the ordered bubble list,
# `bubbleId:<composerId>:<bubbleId>` gives each bubble's actual text).
# workspaceId resolves to a real path via that workspace's own
# workspaceStorage/<id>/workspace.json. Opened read-only (`mode=ro` URI) so a
# live Cursor instance writing to the same file is never disturbed — no
# snapshot-copy needed (unlike imessage-cli's chat.db) since SQLite's own WAL
# readers already get a consistent view without one, and this db is far too
# large (often 1GB+) to copy on every invocation.
# ---------------------------------------------------------------------------

_cursor_project_cache: dict[str, tuple[str, list[dict]]] | None = None
_cursor_workspace_cwd_cache: dict[str, str | None] = {}


def _cursor_connect() -> sqlite3.Connection | None:
    if not CURSOR_GLOBAL_DB.is_file():
        return None
    try:
        conn = sqlite3.connect(f"file:{CURSOR_GLOBAL_DB}?mode=ro", uri=True)
        conn.row_factory = sqlite3.Row
        return conn
    except sqlite3.OperationalError as exc:
        log.debug("Cursor database unavailable: %s", exc)
        return None


def _cursor_workspace_cwd(workspace_id: str) -> str | None:
    if workspace_id in _cursor_workspace_cwd_cache:
        return _cursor_workspace_cwd_cache[workspace_id]
    ws_json = CURSOR_WORKSPACE_STORAGE / workspace_id / "workspace.json"
    cwd = None
    if ws_json.is_file():
        try:
            data = json.loads(ws_json.read_text())
        except (json.JSONDecodeError, OSError):
            data = {}
        folder = data.get("folder")
        if folder and folder.startswith("file://"):
            from urllib.parse import unquote, urlparse

            cwd = unquote(urlparse(folder).path)
        elif folder:
            cwd = folder
    _cursor_workspace_cwd_cache[workspace_id] = cwd
    return cwd


def _cursor_iter_composer_headers():
    conn = _cursor_connect()
    if conn is None:
        return
    try:
        rows = conn.execute(
            "SELECT composerId, workspaceId, createdAt, lastUpdatedAt, isArchived, value FROM composerHeaders"
        ).fetchall()
    except sqlite3.OperationalError:
        # Older/partial Cursor installs have a state.vscdb without this table.
        return
    finally:
        conn.close()
    for r in rows:
        try:
            value = json.loads(r["value"]) if r["value"] else {}
        except json.JSONDecodeError:
            value = {}
        if not r["workspaceId"]:
            continue
        yield {
            "composer_id": r["composerId"],
            "workspace_id": r["workspaceId"],
            "last_updated_at": r["lastUpdatedAt"] or r["createdAt"] or 0,
            "name": value.get("name") or "",
            "has_unread": bool(value.get("hasUnreadMessages")),
        }


def _cursor_projects_map() -> dict[str, tuple[str, list[dict]]]:
    global _cursor_project_cache
    if _cursor_project_cache is None:
        by_ws: dict[str, list[dict]] = {}
        for h in _cursor_iter_composer_headers():
            by_ws.setdefault(h["workspace_id"], []).append(h)
        cache: dict[str, tuple[str, list[dict]]] = {}
        for ws_id, headers in by_ws.items():
            cwd = _cursor_workspace_cwd(ws_id)
            if not cwd:
                continue
            headers.sort(key=lambda h: h["last_updated_at"], reverse=True)
            cache[cwd] = (ws_id, headers)
        _cursor_project_cache = cache
    return _cursor_project_cache


def _cursor_iter_projects():
    if _cursor_connect() is None:
        return
    for cwd in _cursor_projects_map():
        yield ProjectHandle(source="cursor", cwd=cwd, key=cwd)


def _cursor_project_sessions(project: ProjectHandle) -> list[SessionHandle]:
    _, headers = _cursor_projects_map().get(project.cwd, (None, []))
    return [
        SessionHandle(
            source="cursor",
            uuid=h["composer_id"],
            project_cwd=project.cwd,
            composer_id=h["composer_id"],
            mtime=h["last_updated_at"] / 1000.0,
            unread_native=h["has_unread"],
            title_hint=h["name"] or None,
        )
        for h in headers
    ]


def _cursor_iter_turns(composer_id: str) -> list[Turn]:
    conn = _cursor_connect()
    if conn is None:
        return []
    try:
        row = conn.execute(
            "SELECT value FROM cursorDiskKV WHERE key = ?", (f"composerData:{composer_id}",)
        ).fetchone()
        if not row:
            return []
        try:
            data = json.loads(row[0])
        except json.JSONDecodeError:
            return []
        turns = []
        for bh in data.get("fullConversationHeadersOnly") or []:
            bubble_id = bh.get("bubbleId")
            if not bubble_id:
                continue
            brow = conn.execute(
                "SELECT value FROM cursorDiskKV WHERE key = ?",
                (f"bubbleId:{composer_id}:{bubble_id}",),
            ).fetchone()
            if not brow:
                continue
            try:
                bubble = json.loads(brow[0])
            except json.JSONDecodeError:
                continue
            role = {1: "user", 2: "assistant"}.get(bubble.get("type"))
            if role is None:
                continue
            blocks = []
            text = bubble.get("text") or ""
            if text:
                blocks.append({"type": "text", "text": text})
            for tb in bubble.get("allThinkingBlocks") or []:
                if isinstance(tb, dict) and tb.get("text"):
                    blocks.append({"type": "thinking", "thinking": tb["text"]})
            for tr in bubble.get("toolResults") or []:
                if isinstance(tr, dict):
                    blocks.append({"type": "tool_result", "content": json.dumps(tr, ensure_ascii=False)[:500]})
            if not blocks:
                continue
            turns.append(Turn(ts=bubble.get("createdAt") or "", role=role, blocks=blocks))
        return turns
    finally:
        conn.close()


def _cursor_session_tokens(composer_id: str) -> int | None:
    """Sum each bubble's `tokenCount.{inputTokens,outputTokens}` across the
    composer — Cursor tracks this per-bubble rather than as a running total."""
    conn = _cursor_connect()
    if conn is None:
        return None
    try:
        row = conn.execute(
            "SELECT value FROM cursorDiskKV WHERE key = ?", (f"composerData:{composer_id}",)
        ).fetchone()
        if not row:
            return None
        try:
            data = json.loads(row[0])
        except json.JSONDecodeError:
            return None
        total = 0
        found = False
        for bh in data.get("fullConversationHeadersOnly") or []:
            bubble_id = bh.get("bubbleId")
            if not bubble_id:
                continue
            brow = conn.execute(
                "SELECT value FROM cursorDiskKV WHERE key = ?",
                (f"bubbleId:{composer_id}:{bubble_id}",),
            ).fetchone()
            if not brow:
                continue
            try:
                bubble = json.loads(brow[0])
            except json.JSONDecodeError:
                continue
            token_count = bubble.get("tokenCount")
            if not token_count:
                continue
            found = True
            total += token_count.get("inputTokens", 0) + token_count.get("outputTokens", 0)
        return total if found else None
    finally:
        conn.close()


def _cursor_composer_ids_matching(needle: str) -> set[str] | None:
    """SQL-level prefilter across every bubble's text in one query (there's
    no cheap single-file byte-check available the way there is for
    Claude/Codex's flat JSONL files) — returns None if Cursor isn't
    available at all, so callers can skip it entirely."""
    conn = _cursor_connect()
    if conn is None:
        return None
    try:
        rows = conn.execute(
            "SELECT key FROM cursorDiskKV WHERE key LIKE 'bubbleId:%' AND value LIKE ?",
            (f"%{needle}%",),
        ).fetchall()
    finally:
        conn.close()
    ids: set[str] = set()
    for (key,) in rows:
        parts = key.split(":")
        if len(parts) == 3:
            ids.add(parts[1])
    return ids


# ---------------------------------------------------------------------------
# Unified dispatch — every command operates on ProjectHandle/SessionHandle,
# regardless of which backend produced them
# ---------------------------------------------------------------------------


def _iter_all_projects(sources: tuple[str, ...]):
    if "claude" in sources:
        yield from _claude_iter_projects()
    if "codex" in sources:
        yield from _codex_iter_projects()
    if "cursor" in sources:
        yield from _cursor_iter_projects()


def _project_sessions(project: ProjectHandle) -> list[SessionHandle]:
    if project.source == "claude":
        return _claude_project_sessions(project)
    if project.source == "codex":
        return _codex_project_sessions(project)
    if project.source == "cursor":
        return _cursor_project_sessions(project)
    return []


def _handle_iter_turns(handle: SessionHandle, include_subagents: bool) -> list[Turn]:
    if handle.source == "claude":
        return list(_iter_turns(handle.path, include_subagents=include_subagents))
    if handle.source == "codex":
        return list(_codex_iter_turns(handle.path))
    if handle.source == "cursor":
        return _cursor_iter_turns(handle.composer_id)
    return []


def _handle_token_total(handle: SessionHandle) -> int | None:
    if handle.source == "claude":
        return _claude_session_tokens(handle.path)
    if handle.source == "codex":
        return _codex_session_tokens(handle.path)
    if handle.source == "cursor":
        return _cursor_session_tokens(handle.composer_id)
    return None


def _handle_drop_noise(handle: SessionHandle, turns: list[Turn]) -> list[Turn]:
    if handle.source == "claude":
        return _drop_tool_injected_followups(turns)
    if handle.source == "codex":
        return _codex_drop_noise(turns)
    return turns  # cursor: bubbles are already clean user/assistant, no known noise pattern


def _handle_rendered_turns(handle: SessionHandle, raw: bool, include_subagents: bool, limit: int) -> list[dict]:
    turns = _handle_iter_turns(handle, include_subagents)
    if not raw:
        turns = _handle_drop_noise(handle, turns)
    if limit:
        turns = turns[-limit:]
    out = []
    for t in turns:
        rendered = _render_turn(t, raw=raw)
        if rendered is None:
            continue
        out.append({"ts": t.ts, "role": t.role, "text": rendered})
    return out


def _handle_title(handle: SessionHandle, max_len: int = 100) -> str:
    if handle.title_hint:
        title = handle.title_hint.strip()
        return title[: max_len - 1] + "…" if len(title) > max_len else title
    turns = _handle_drop_noise(handle, _handle_iter_turns(handle, include_subagents=False))
    for t in turns:
        if t.role != "user":
            continue
        rendered = _render_turn(t, raw=False)
        if rendered:
            title = rendered.replace("\n", " ").strip()
            return title[: max_len - 1] + "…" if len(title) > max_len else title
    return "(untitled thread)"


def _read_state_key(handle: SessionHandle) -> str:
    # "claude" keeps its original bare-uuid key (backward compatible with
    # anyone's existing read-state.json); other sources get a prefix so a
    # theoretical uuid collision across backends can never cross-contaminate.
    return handle.uuid if handle.source == "claude" else f"{handle.source}:{handle.uuid}"


def _handle_is_unread(handle: SessionHandle, state: dict) -> bool:
    if handle.source == "cursor":
        return bool(handle.unread_native)
    mark = state.get(_read_state_key(handle))
    return mark is None or handle.mtime > mark


def _handle_mark_read(handle: SessionHandle, state: dict) -> None:
    if handle.source == "cursor":
        return  # Cursor tracks its own unread state; never write to its db
    state[_read_state_key(handle)] = handle.mtime


def _handle_summary(handle: SessionHandle, read_state: dict) -> dict:
    turns = _handle_drop_noise(handle, _handle_iter_turns(handle, include_subagents=False))
    return {
        "uuid": handle.uuid,
        "source": handle.source,
        "cwd": handle.project_cwd,
        "start": turns[0].ts if turns else "",
        "end": turns[-1].ts if turns else "",
        "turns": len(turns),
        "tokens": _handle_token_total(handle),
        "title": _handle_title(handle),
        "unread": _handle_is_unread(handle, read_state),
    }


def _project_summary_handle(project: ProjectHandle, read_state: dict) -> dict:
    sessions = _project_sessions(project)
    last_mtime = sessions[0].mtime if sessions else 0
    return {
        "source": project.source,
        "cwd": project.cwd,
        "threads": len(sessions),
        "unread": sum(1 for h in sessions if _handle_is_unread(h, read_state)),
        "last_active": datetime.fromtimestamp(last_mtime).strftime("%Y-%m-%d %H:%M") if last_mtime else "?",
        "last_active_epoch": last_mtime,
    }


def _resolve_projects(query: str, match: int, sources: tuple[str, ...]) -> list[ProjectHandle]:
    """Like `_resolve_one_project` but source-aware, and — this is the whole
    point of unifying — when a query exactly names one real directory that
    exists under more than one source, resolves to *all* of them at once
    (e.g. a repo you've driven with both Claude Code and Codex): every
    command downstream then merges their threads into one recency-sorted
    list, tagged by source.
    """
    needle = query.lower()
    candidates = [p for p in _iter_all_projects(sources) if needle in p.cwd.lower()]
    if not candidates:
        raise click.ClickException(f"No project matches {query!r}.")

    def _recency(p: ProjectHandle) -> float:
        sessions = _project_sessions(p)
        return sessions[0].mtime if sessions else 0

    candidates.sort(key=_recency, reverse=True)

    if match:
        if match < 1 or match > len(candidates):
            raise click.ClickException(f"--match {match} out of range (1..{len(candidates)}).")
        return [candidates[match - 1]]

    exact_cwds = {p.cwd for p in candidates if Path(p.cwd).name.lower() == needle}
    if len(exact_cwds) == 1:
        (only_cwd,) = exact_cwds
        return [p for p in candidates if p.cwd == only_cwd]

    if len(candidates) == 1:
        return candidates

    click.echo(f"Multiple projects match {query!r} — pick with --match N:", err=True)
    state = _load_read_state()
    for i, p in enumerate(candidates[:20], 1):
        summary = _project_summary_handle(p, state)
        click.echo(f"  {i}. [{p.source}] {summary['cwd']}  ({summary['threads']} threads)", err=True)
    raise SystemExit(1)


def _all_sessions_for(projects: list[ProjectHandle]) -> list[SessionHandle]:
    sessions: list[SessionHandle] = []
    for p in projects:
        sessions.extend(_project_sessions(p))
    sessions.sort(key=lambda h: h.mtime, reverse=True)
    return sessions


def _pick_session_handle(handles: list[SessionHandle], session_uuid: str | None, nth: int) -> SessionHandle:
    if session_uuid:
        matches = [h for h in handles if h.uuid.startswith(session_uuid)]
        if not matches:
            raise click.ClickException(f"No thread {session_uuid!r} in this project.")
        return matches[0]
    if nth < 1 or nth > len(handles):
        raise click.ClickException(f"--nth {nth} out of range (1..{len(handles)}).")
    return handles[nth - 1]


# ---------------------------------------------------------------------------
# Read/unread tracking (local to this CLI — see STATE_DIR/READ_STATE_FILE)
# ---------------------------------------------------------------------------


def _load_read_state() -> dict:
    """{session_uuid: last-read mtime (epoch float)}."""
    if not READ_STATE_FILE.is_file():
        return {}
    try:
        return json.loads(READ_STATE_FILE.read_text())
    except (json.JSONDecodeError, OSError):
        return {}


def _save_read_state(state: dict) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = READ_STATE_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(state))
    tmp.replace(READ_STATE_FILE)  # atomic — a crash mid-write can't corrupt it


def _mark_read(path: Path, state: dict) -> None:
    """Record `path` as read up to its current mtime. Caller owns loading and
    saving `state` so a batch of marks (`unread --mark-all-read`) writes once."""
    state[path.stem] = path.stat().st_mtime


def _is_unread(path: Path, state: dict) -> bool:
    """Unread by default (never opened via `read`/marked read) — same as a
    message you've never opened. New activity (a bigger mtime) since the last
    mark makes it unread again."""
    mark = state.get(path.stem)
    return mark is None or path.stat().st_mtime > mark


def _project_summary(project_dir: Path, read_state: dict | None = None) -> dict:
    files = _session_files(project_dir)
    last_mtime = files[0].stat().st_mtime if files else 0
    state = read_state if read_state is not None else _load_read_state()
    return {
        "cwd": _project_cwd(project_dir),
        "dir": project_dir.name,
        "threads": len(files),
        "unread": sum(1 for f in files if _is_unread(f, state)),
        "last_active": datetime.fromtimestamp(last_mtime).strftime("%Y-%m-%d %H:%M")
        if last_mtime
        else "?",
        "last_active_epoch": last_mtime,
    }


def _match_projects(query: str) -> list[Path]:
    needle = query.lower()
    return sorted(
        (
            d
            for d in _iter_project_dirs()
            if needle in _project_cwd(d).lower() or needle in d.name.lower()
        ),
        key=lambda d: _session_files(d)[0].stat().st_mtime,
        reverse=True,
    )


def _resolve_one_project(query: str, match: int) -> Path:
    candidates = _match_projects(query)
    if not candidates:
        raise click.ClickException(f"No project matches {query!r}.")
    if len(candidates) > 1 and not match:
        # A query like "myproject" substring-matches every nested project
        # under it (worktrees, subpackages, ...) as well as the project itself. If
        # exactly one candidate's own directory is *named* the query (its
        # cwd's last path component, case-insensitive), that's unambiguously
        # "the" project the user meant — auto-pick it instead of forcing
        # --match every time an outer project has children that also match.
        exact = [d for d in candidates if Path(_project_cwd(d)).name.lower() == query.lower()]
        if len(exact) == 1:
            return exact[0]
        click.echo(f"Multiple projects match {query!r} — pick with --match N:", err=True)
        for i, d in enumerate(candidates[:20], 1):
            summary = _project_summary(d)
            click.echo(f"  {i}. {summary['cwd']}  ({summary['threads']} threads)", err=True)
        raise SystemExit(1)
    return candidates[match - 1 if match else 0]


def _pick_session_from_files(
    files: list[Path], session_uuid: str | None, nth: int
) -> Path:
    """--session (exact UUID/prefix) or --nth (1 = most recent) within an
    already-resolved project's session files."""
    if session_uuid:
        matches = [f for f in files if f.stem.startswith(session_uuid)]
        if not matches:
            raise click.ClickException(f"No session {session_uuid!r} in this project.")
        return matches[0]
    if nth < 1 or nth > len(files):
        raise click.ClickException(f"--nth {nth} out of range (1..{len(files)}).")
    return files[nth - 1]


def _resolve_one_session(
    query: str, match: int, nth: int, session_uuid: str | None
) -> Path:
    """Shared by `fork`/`send`: project QUERY + --match, then --session (exact
    UUID/prefix) or --nth (1 = most recent, the default)."""
    project = _resolve_one_project(query, match)
    return _pick_session_from_files(_session_files(project), session_uuid, nth)


def _print_thread_rows(
    results: list[dict], show_cwd: bool, show_unread_mark: bool, show_source: bool = False
) -> None:
    """One column-aligned line per thread — shared by every list-style
    command (`read`, `unread`, `find`) so their output lines up the same way
    regardless of how varied the turn counts or cwd lengths in this batch are."""
    if not results:
        return
    turns_width = max(len(str(s["turns"])) for s in results)
    tokens_width = max(len(_format_tokens(s.get("tokens"))) for s in results)
    cwd_width = max(len(s["cwd"]) for s in results) if show_cwd else 0
    source_width = max(len(s["source"]) for s in results) if show_source else 0
    for s in results:
        last = s["end"] or s["start"]
        mark = ("● " if s.get("unread") else "  ") if show_unread_mark else ""
        turns = f"{s['turns']:>{turns_width}} turns"
        tokens = f"{_format_tokens(s.get('tokens')):>{tokens_width}} tok"
        cwd = f"{s['cwd']:<{cwd_width}}  " if show_cwd else ""
        source = f"[{s['source']:<{source_width}}]  " if show_source else ""
        click.echo(f"{mark}{_local_ts(last)}  {source}{cwd}[{s['uuid'][:8]}]  ({turns}, {tokens})  {s['title']}")


def _print_handle_list(cwd_label: str, handles: list[SessionHandle], as_json: bool, show_source: bool) -> None:
    """The channel's top-level view: one line per thread (its anchor), no
    content — bare `read`'s output."""
    state = _load_read_state()
    out = [_handle_summary(h, state) for h in handles]
    if as_json:
        click.echo(json.dumps(out, ensure_ascii=False))
        return
    click.echo(f"# {cwd_label} — {len(out)} thread(s), most recently active first\n")
    _print_thread_rows(out, show_cwd=False, show_unread_mark=True, show_source=show_source)


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------


@click.group(context_settings={"help_option_names": ["-h", "--help"]})
def cli() -> None:
    """Read your local Claude Code / Codex CLI / Cursor conversation history (read-only)."""


_SOURCE_OPTION = click.option(
    "--source",
    "source_filter",
    type=click.Choice(SOURCES),
    help="Restrict to one source (default: claude + codex + cursor, all at once).",
)


@cli.command()
@_SOURCE_OPTION
@click.option("--limit", default=30, help="Number of projects to list.")
@click.option("--json", "as_json", is_flag=True, help="Emit JSON.")
def chats(source_filter: str | None, limit: int, as_json: bool) -> None:
    """List projects (channels) across every source, most recently active first."""
    sources = (source_filter,) if source_filter else SOURCES
    state = _load_read_state()
    projects = sorted(
        (_project_summary_handle(p, state) for p in _iter_all_projects(sources)),
        key=lambda s: s["last_active_epoch"],
        reverse=True,
    )[:limit]
    if as_json:
        click.echo(json.dumps(projects, ensure_ascii=False))
        return
    for p in projects:
        unread = f", {p['unread']} unread" if p["unread"] else ""
        click.echo(f"{p['last_active']}  [{p['source']}]  {p['cwd']}  ({p['threads']} threads{unread})")


@cli.command()
@click.argument("query")
@_SOURCE_OPTION
@click.option("--expand", is_flag=True, help="Show every thread's full content instead of just its anchor.")
@click.option("--limit", default=0, help="Cap on threads shown (0 = no cap).")
@click.option("--match", default=0, help="Pick the Nth matching project (1-based).")
@click.option("--raw", is_flag=True, help="With --expand: include thinking blocks and tool calls/results.")
@click.option("--include-subagents", is_flag=True, help="With --expand: include forked subagent turns (claude only).")
@click.option("--no-mark-read", is_flag=True, help="With --expand: don't mark the threads shown as read.")
@click.option("--json", "as_json", is_flag=True, help="Emit JSON.")
def read(
    query: str,
    source_filter: str | None,
    expand: bool,
    limit: int,
    match: int,
    raw: bool,
    include_subagents: bool,
    no_mark_read: bool,
    as_json: bool,
) -> None:
    """Read the project (channel) matching QUERY — a project IS a channel, a
    session IS a thread (its anchor = first turn, plus every turn tied to it).
    Searches claude + codex + cursor at once unless --source narrows it; a
    query that exactly names one real directory merges every source's
    threads for it into one recency-sorted list, tagged by source.

    Bare: every thread's anchor (title, turn count, timestamp), most recently
    active first — the channel's top-level view, nothing expanded. `--expand`
    inlines every thread's full content instead — exactly Slack's
    `read`/`--expand-thread`. To read exactly one thread in full, use
    `thread QUERY` (Slack's `thread <channel> <ts>`), not this command.
    """
    sources = (source_filter,) if source_filter else SOURCES
    projects = _resolve_projects(query, match, sources)
    sessions = _all_sessions_for(projects)
    session_subset = sessions[:limit] if limit else sessions
    show_source = len({p.source for p in projects}) > 1 or len(sources) > 1

    if not expand:
        cwd_label = projects[0].cwd if len(projects) == 1 else f"{len(projects)} projects matching {query!r}"
        _print_handle_list(cwd_label, session_subset, as_json, show_source)
        return

    state = _load_read_state()
    threads_out = []
    for h in session_subset:
        turns = _handle_rendered_turns(h, raw, include_subagents, limit=0)
        if not no_mark_read:
            _handle_mark_read(h, state)
        threads_out.append({
            "source": h.source,
            "session": h.uuid,
            "cwd": h.project_cwd,
            "title": _handle_title(h),
            "tokens": _handle_token_total(h),
            "turns": turns,
        })
    if not no_mark_read:
        _save_read_state(state)

    if as_json:
        click.echo(json.dumps(threads_out, ensure_ascii=False))
        return
    for t in threads_out:
        click.echo(f"## [{t['source']}] thread {t['session']} — {t['title']} — {len(t['turns'])} turns, {_format_tokens(t['tokens'])} tok\n")
        for m in t["turns"]:
            click.echo(f"{_local_ts(m['ts'])}  {m['role']}: {m['text']}\n")


@cli.command()
@click.argument("query")
@_SOURCE_OPTION
@click.option("--session", "session_uuid", help="Read exactly this thread in full (session UUID or prefix).")
@click.option("--nth", default=1, help="Which thread to read, 1 = most recent (default).")
@click.option("--match", default=0, help="Pick the Nth matching project (1-based).")
@click.option("--limit", default=0, help="Only show the last N turns (0 = all).")
@click.option("--raw", is_flag=True, help="Include thinking blocks and tool calls/results.")
@click.option("--include-subagents", is_flag=True, help="Include forked subagent turns (claude only).")
@click.option("--no-mark-read", is_flag=True, help="Don't mark this thread as read.")
@click.option("--json", "as_json", is_flag=True, help="Emit JSON.")
def thread(
    query: str,
    source_filter: str | None,
    session_uuid: str | None,
    nth: int,
    match: int,
    limit: int,
    raw: bool,
    include_subagents: bool,
    no_mark_read: bool,
    as_json: bool,
) -> None:
    """Read one thread in full, from the project matching QUERY — Slack's
    `thread <channel> <ts>`, with a UUID/--nth position standing in for
    Slack's message ts since a session has no natural timestamp handle.
    Searches claude + codex + cursor at once unless --source narrows it; when
    a query merges threads from multiple sources (see `read`), --nth ranks
    across all of them by recency together.

    Defaults to the most recently active thread; pick another with --nth
    (2 = the one before, ...) or target an exact --session UUID. Marks it
    read (see `unread`) unless --no-mark-read is passed.
    """
    sources = (source_filter,) if source_filter else SOURCES
    projects = _resolve_projects(query, match, sources)
    sessions = _all_sessions_for(projects)
    handle = _pick_session_handle(sessions, session_uuid, nth)
    out = _handle_rendered_turns(handle, raw, include_subagents, limit)
    title = _handle_title(handle)
    tokens = _handle_token_total(handle)

    if not no_mark_read:
        state = _load_read_state()
        _handle_mark_read(handle, state)
        _save_read_state(state)

    if as_json:
        click.echo(json.dumps(
            {"source": handle.source, "session": handle.uuid, "cwd": handle.project_cwd, "title": title, "tokens": tokens, "turns": out},
            ensure_ascii=False,
        ))
        return
    click.echo(f"# [{handle.source}] {handle.project_cwd} — thread {handle.uuid} — {title} — {len(out)} turns, {_format_tokens(tokens)} tok\n")
    for m in out:
        click.echo(f"{_local_ts(m['ts'])}  {m['role']}: {m['text']}\n")


def _sessions_for_scope(project_query: str | None, sources: tuple[str, ...]) -> list[SessionHandle]:
    """Every session across the matching projects (or every project in scope,
    if no query) — recency-sorted, merged across sources. Shared by
    `search`/`find`/`unread`, which (unlike `read`/`thread`) operate over a
    whole scope rather than resolving to one specific project."""
    if project_query:
        needle = project_query.lower()
        projects = [p for p in _iter_all_projects(sources) if needle in p.cwd.lower()]
    else:
        projects = list(_iter_all_projects(sources))
    return _all_sessions_for(projects)


@cli.command()
@click.argument("text")
@_SOURCE_OPTION
@click.option("--project", "project_query", help="Restrict to projects matching this query (default: all).")
@click.option("--limit", default=50, help="Number of matches to show.")
@click.option("--json", "as_json", is_flag=True, help="Emit JSON.")
def search(text: str, source_filter: str | None, project_query: str | None, limit: int, as_json: bool) -> None:
    """Full-text search across session transcripts, across every source.

    A cheap pre-filter runs before any full parsing — a raw-bytes substring
    check for claude/codex's flat JSONL files, one batched SQL LIKE query for
    cursor's SQLite store (no single-file check is possible there) — so
    searching everywhere stays fast even with a lot of history.
    """
    sources = (source_filter,) if source_filter else SOURCES
    needle = text.lower()
    needle_bytes = text.encode("utf-8")
    sessions = _sessions_for_scope(project_query, sources)
    cursor_ids = _cursor_composer_ids_matching(text) if "cursor" in sources else None

    results = []
    for h in sessions:
        if h.source in ("claude", "codex"):
            with h.path.open("rb") as f:
                if needle_bytes.lower() not in f.read().lower():
                    continue
        elif h.source == "cursor" and cursor_ids is not None and h.composer_id not in cursor_ids:
            continue
        for turn in _handle_iter_turns(h, include_subagents=False):
            rendered = _render_turn(turn, raw=False)
            if not rendered or needle not in rendered.lower():
                continue
            snippet = rendered.replace("\n", " ")
            if len(snippet) > 200:
                idx = snippet.lower().find(needle)
                start = max(0, idx - 80)
                snippet = ("…" if start else "") + snippet[start : start + 200] + "…"
            results.append(
                {
                    "ts": turn.ts,
                    "source": h.source,
                    "cwd": h.project_cwd,
                    "session": h.uuid,
                    "role": turn.role,
                    "text": snippet,
                }
            )
            if len(results) >= limit:
                break
        if len(results) >= limit:
            break

    results.sort(key=lambda r: r["ts"], reverse=True)
    if as_json:
        click.echo(json.dumps(results, ensure_ascii=False))
        return
    for r in results:
        click.echo(f"{_local_ts(r['ts'])}  [{r['source']}]  {r['cwd']}  [{r['session'][:8]}]  {r['role']}: {r['text']}")


@cli.command()
@_SOURCE_OPTION
@click.option("--project", "project_query", help="Restrict to projects matching this query (default: all).")
@click.option("--limit", default=30, help="Number of threads to show.")
@click.option("--mark-all-read", is_flag=True, help="Don't list anything — just mark everything currently unread as read.")
@click.option("--json", "as_json", is_flag=True, help="Emit JSON.")
def unread(source_filter: str | None, project_query: str | None, limit: int, mark_all_read: bool, as_json: bool) -> None:
    """List threads with activity you haven't seen yet, across every source.

    Claude Code and Codex have no concept of read/unread, so those two are
    tracked via local bookkeeping (~/.config/agent-conv-cli/read-state.json,
    override with $AGENT_CONV_STATE_DIR): a thread counts as unread until you
    view its full content via `thread` or `read --expand` (or catch up in
    bulk with --mark-all-read), same as a message you've never opened, and
    new activity since the last time makes it unread again. Cursor already
    tracks its own unread state natively — that flag is read directly and
    never written to (--mark-all-read skips Cursor threads; open them in
    Cursor itself to clear it). The very first run will likely show your
    whole Claude/Codex history as unread — run `unread --mark-all-read` once
    to start clean, then let normal usage keep it current.
    """
    sources = (source_filter,) if source_filter else SOURCES
    state = _load_read_state()
    sessions = _sessions_for_scope(project_query, sources)
    unread_handles = [h for h in sessions if _handle_is_unread(h, state)]

    if mark_all_read:
        markable = [h for h in unread_handles if h.source != "cursor"]
        for h in markable:
            _handle_mark_read(h, state)
        _save_read_state(state)
        skipped = len(unread_handles) - len(markable)
        note = f" ({skipped} cursor thread(s) skipped — open them in Cursor to clear its own unread flag)" if skipped else ""
        click.echo(f"Marked {len(markable)} thread(s) as read.{note}")
        return

    unread_handles.sort(key=lambda h: h.mtime, reverse=True)
    results = [_handle_summary(h, state) for h in unread_handles[:limit]]

    if as_json:
        click.echo(json.dumps(results, ensure_ascii=False))
        return
    if not results:
        click.echo("Nothing unread.")
        return
    _print_thread_rows(results, show_cwd=True, show_unread_mark=False, show_source=True)


@cli.command()
@click.argument("text")
@_SOURCE_OPTION
@click.option("--limit", default=30, help="Number of threads to show.")
@click.option("--json", "as_json", is_flag=True, help="Emit JSON.")
def find(text: str, source_filter: str | None, limit: int, as_json: bool) -> None:
    """Find a thread by name — i.e. by its derived title — across every
    project and source.

    Only Cursor stores a real thread title; Claude Code/Codex don't, so
    "name" there is the first substantive thing you said in it (same text
    `chats`/`read` derive titles from). Unlike `search`, which matches
    anywhere in a transcript and returns one row per matching turn, this
    matches only the title and returns one row per thread.
    """
    sources = (source_filter,) if source_filter else SOURCES
    needle = text.lower()
    needle_bytes = text.encode("utf-8")
    state = _load_read_state()
    results = []
    for h in _sessions_for_scope(None, sources):
        if h.source in ("claude", "codex"):
            # Cheap prefilter: a title always comes from early in the file,
            # so a raw-byte substring check on the first chunk skips most
            # files without a full parse.
            with h.path.open("rb") as f:
                head = f.read(8192)
            if needle_bytes.lower() not in head.lower():
                continue
        summary = _handle_summary(h, state)
        if needle not in summary["title"].lower():
            continue
        results.append(summary)

    results.sort(key=lambda s: s["end"] or s["start"], reverse=True)
    results = results[:limit]
    if as_json:
        click.echo(json.dumps(results, ensure_ascii=False))
        return
    _print_thread_rows(results, show_cwd=True, show_unread_mark=False, show_source=True)


_SKILL_TOOL_USE_NEEDLE = b'"name":"Skill"'


def _parse_iso_ts(ts: str) -> float | None:
    if not ts:
        return None
    try:
        return datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


@cli.command("skill-usage")
@click.option(
    "--since-days",
    default=0,
    help="Only scan sessions modified in the last N days (0 = all history).",
)
@click.option(
    "--recent",
    default=5,
    help="Per skill, how many of its most recent invocations to keep session pointers for (0 = none).",
)
@click.option("--json", "as_json", is_flag=True, help="Emit JSON.")
def skill_usage(since_days: int, recent: int, as_json: bool) -> None:
    """Tally Skill-tool invocations across every Claude Code session.

    Claude Code records an explicit `Skill` tool_use event (with the invoked
    skill's name in `input.skill`) in the main transcript every time a skill
    is loaded — even when the skill's own work then runs in a background
    subagent, so subagent/sidechain turns don't need to be scanned. This
    walks every project's session files, cheaply pre-filtering each one with
    a raw-bytes substring check before doing any JSON parsing (same trick
    `search`/`find` use) so a full scan of years of history stays fast, and
    reports each distinct skill name invoked: how many times total, and (in
    `--json`) a `recent` list of its last N invocations' `session`/`cwd`/`ts`
    pointers — enough to `agent-conv thread <cwd> --session <uuid>` straight
    into the transcript right after a specific load, to actually judge how
    the skill got used (one clean action vs. floundering/back-and-forth),
    not just whether it got used. Text mode only prints the count + most
    recent timestamp; use `--json` for the drill-down pointers.

    Codex and Cursor have no equivalent "Skill" tool concept, so this only
    ever looks at Claude Code history — there is nothing to `--source` this
    command with.

    This command only reports what has been *used*; it has no notion of
    which skills are currently installed, so it never decides what's
    "unused" — that comparison (against the skill directory's own contents)
    is left to the caller.
    """
    cutoff = datetime.now(timezone.utc).timestamp() - since_days * 86400 if since_days > 0 else None

    invocations: dict[str, list[dict]] = {}
    for project_dir in _iter_project_dirs():
        cwd = None
        for path in _session_files(project_dir):
            if cutoff is not None and path.stat().st_mtime < cutoff:
                continue
            with path.open("rb") as f:
                data = f.read()
            if _SKILL_TOOL_USE_NEEDLE not in data:
                continue
            if cwd is None:
                cwd = _project_cwd(project_dir)
            for turn in _iter_turns(path, include_subagents=False):
                turn_epoch = _parse_iso_ts(turn.ts)
                if cutoff is not None and turn_epoch is not None and turn_epoch < cutoff:
                    continue
                for block in turn.blocks:
                    if block.get("type") != "tool_use" or block.get("name") != "Skill":
                        continue
                    name = (block.get("input") or {}).get("skill")
                    if not name:
                        continue
                    invocations.setdefault(name, []).append(
                        {"ts": turn.ts, "session": path.stem, "cwd": cwd}
                    )

    rows = []
    for name, invs in invocations.items():
        invs.sort(key=lambda i: i["ts"], reverse=True)
        rows.append(
            {
                "skill": name,
                "count": len(invs),
                "last_used": invs[0]["ts"],
                "recent": [{"session": i["session"], "cwd": i["cwd"], "ts": i["ts"]} for i in invs[:recent]],
            }
        )
    rows.sort(key=lambda r: r["last_used"], reverse=True)

    if as_json:
        click.echo(json.dumps(rows, ensure_ascii=False))
        return
    if not rows:
        click.echo("No Skill-tool invocations found.")
        return
    for r in rows:
        click.echo(f"{_local_ts(r['last_used'])}  {r['skill']}  ({r['count']}x)")


@cli.command()
@click.argument("query")
@click.option("--nth", default=1, help="Which thread to fork, 1 = most recent (default).")
@click.option("--session", "session_uuid", help="Exact session UUID (or prefix) instead of the Nth most recent.")
@click.option("--match", default=0, help="Pick the Nth matching project (1-based).")
@click.option("--yes", is_flag=True, help="Actually launch. Without it, prints the resolved command as a dry-run.")
def fork(query: str, nth: int, session_uuid: str | None, match: int, yes: bool) -> None:
    """Continue a past thread as a NEW thread, leaving the original untouched.

    Resolves a thread the same way `thread` does (project QUERY + --nth /
    --session), then hands off to `claude --resume <uuid> --fork-session` —
    Claude Code's own mechanism for branching a past conversation into a
    fresh session ID instead of mutating the one being resumed. This is the
    one command that actually launches something: it replaces this process
    and takes over the terminal for an interactive `claude` session, from the
    original thread's working directory.

    Defaults to a dry-run that prints what would be launched. Pass --yes to
    actually do it.
    """
    path = _resolve_one_session(query, match, nth, session_uuid)
    cwd = _session_cwd(path) or str(path.parent)
    title = _session_title(path)

    if not yes:
        click.echo("DRY-RUN (nothing launched). Re-run with --yes to fork.")
        click.echo(f"  thread:  {path.stem}  ({title})")
        click.echo(f"  cwd:     {cwd}")
        click.echo(f"  command: claude --resume {path.stem} --fork-session")
        return

    if not Path(cwd).is_dir():
        raise click.ClickException(f"{cwd!r} no longer exists on disk — can't cd there to fork.")
    click.echo(f"Forking thread {path.stem} from {cwd} ...", err=True)
    os.chdir(cwd)
    try:
        os.execvp("claude", ["claude", "--resume", path.stem, "--fork-session"])
    except FileNotFoundError:
        raise click.ClickException("`claude` not found on PATH.")


@cli.command()
@click.argument("query")
@click.argument("message")
@click.option("--nth", default=1, help="Which thread to continue, 1 = most recent (default).")
@click.option("--session", "session_uuid", help="Exact session UUID (or prefix) instead of the Nth most recent.")
@click.option("--match", default=0, help="Pick the Nth matching project (1-based).")
@click.option("--fork", "fork_session", is_flag=True, help="Continue as a NEW thread instead of appending to the original (like `fork`).")
@click.option("--permission-mode", help="Passed through to claude, e.g. plan / acceptEdits / bypassPermissions / dontAsk.")
@click.option("--timeout", default=300, help="Seconds to wait for a reply before giving up.")
@click.option("--yes", is_flag=True, help="Actually send. Without it, prints the resolved command as a dry-run.")
@click.option("--json", "as_json", is_flag=True, help="Emit Claude's --output-format json reply as-is.")
def send(
    query: str,
    message: str,
    nth: int,
    session_uuid: str | None,
    match: int,
    fork_session: bool,
    permission_mode: str | None,
    timeout: int,
    yes: bool,
    as_json: bool,
) -> None:
    """Send MESSAGE into a thread non-interactively and print Claude's reply.

    Runs `claude --print --resume <uuid> MESSAGE` from the thread's own
    directory — the headless equivalent of resuming it in an interactive
    terminal and typing MESSAGE, without needing a TTY. Without --fork, this
    *is* resuming that exact thread: the reply gets appended to the same
    session file, exactly as if you'd typed it interactively. Pass --fork to
    branch into a new thread instead (like `fork`, but with the message sent
    and the reply captured immediately rather than opening a terminal).

    This is a real write action — the resumed thread may run tools (edit
    files, run commands, ...) depending on its permission mode, which is why
    it defaults to a dry-run. Pass --yes to actually run it. `--permission-mode`
    is passed straight through to `claude`; without it, whatever your global/
    project default is applies, which may prompt or block on anything needing
    approval since there is no interactive terminal to approve it in.
    """
    path = _resolve_one_session(query, match, nth, session_uuid)
    cwd = _session_cwd(path) or str(path.parent)
    title = _session_title(path)

    cmd = ["claude", "--print", "--resume", path.stem]
    if fork_session:
        cmd.append("--fork-session")
    if permission_mode:
        cmd += ["--permission-mode", permission_mode]
    if as_json:
        cmd += ["--output-format", "json"]
    cmd.append(message)

    if not yes:
        click.echo("DRY-RUN (nothing sent). Re-run with --yes to send.")
        click.echo(f"  thread:  {path.stem}  ({title})")
        click.echo(f"  cwd:     {cwd}")
        click.echo(f"  message: {message}")
        click.echo(f"  command: {' '.join(shlex.quote(c) for c in cmd)}")
        return

    if not Path(cwd).is_dir():
        raise click.ClickException(f"{cwd!r} no longer exists on disk.")
    try:
        result = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        raise click.ClickException(f"No reply within {timeout}s (--timeout to extend).")
    except FileNotFoundError:
        raise click.ClickException("`claude` not found on PATH.")
    if result.returncode != 0:
        raise click.ClickException(
            result.stderr.strip() or f"claude exited with status {result.returncode}"
        )
    click.echo(result.stdout if as_json else result.stdout.strip())


def _port_seed_text(handle: SessionHandle, raw: bool, include_subagents: bool, limit: int) -> str:
    turns = _handle_rendered_turns(handle, raw, include_subagents, limit)
    title = _handle_title(handle)
    lines = [
        f"Continuing a conversation ported from {handle.source} "
        f"(project: {handle.project_cwd}, thread: {title}):",
        "",
        "---",
    ]
    for t in turns:
        lines.append(f"{t['role']}: {t['text']}")
        lines.append("")
    lines.append("---")
    lines.append("")
    lines.append("Please pick up from here.")
    return "\n".join(lines)


@cli.command()
@click.argument("query")
@click.option("--into", "target", type=click.Choice(("claude", "codex")), required=True, help="Which provider to start the new conversation in.")
@_SOURCE_OPTION
@click.option("--session", "session_uuid", help="Port exactly this thread (session UUID or prefix).")
@click.option("--nth", default=1, help="Which thread to port, 1 = most recent (default).")
@click.option("--match", default=0, help="Pick the Nth matching project (1-based).")
@click.option("--limit", default=0, help="Only port the last N turns (0 = all).")
@click.option("--raw", is_flag=True, help="Include thinking blocks and tool calls/results in the ported transcript.")
@click.option("--include-subagents", is_flag=True, help="Include forked subagent turns (claude source only).")
@click.option("--print", "headless", is_flag=True, help="Send headlessly and print the reply, instead of opening an interactive session.")
@click.option("--permission-mode", help="Passed through to claude in --print mode (plan / acceptEdits / bypassPermissions / dontAsk).")
@click.option("--timeout", default=300, help="Seconds to wait for a reply in --print mode.")
@click.option("--no-mark-read", is_flag=True, help="Don't mark the source thread as read.")
@click.option("--yes", is_flag=True, help="Actually launch/send. Without it, prints what would run as a dry-run.")
def port(
    query: str,
    target: str,
    source_filter: str | None,
    session_uuid: str | None,
    nth: int,
    match: int,
    limit: int,
    raw: bool,
    include_subagents: bool,
    headless: bool,
    permission_mode: str | None,
    timeout: int,
    no_mark_read: bool,
    yes: bool,
) -> None:
    """Port a thread's content from any source into a BRAND-NEW conversation
    with another provider (--into claude|codex).

    This is not a true resume — each provider only understands its own
    session format, so a Codex or Cursor thread can never literally continue
    inside Claude Code (or vice versa). Instead, the source thread's rendered
    transcript (the same clean text `thread`/`read` show — no raw tool-call
    replay) becomes the *opening prompt* of a fresh session with the target
    provider, started in the same directory, so the model has full context
    to pick up from a similar point without an exact state replay.

    Cursor can only ever be a source here, never a --into target: it has no
    CLI at all to start or seed a chat with a prompt (verified — `cursor
    --help` is purely an editor launcher: open files, diff, goto-line; no
    chat/composer flags exist).

    Defaults to a dry-run that prints the resolved source thread and what
    would be launched. Pass --yes to actually do it. Without --print, this
    replaces the current process and hands the terminal off to a real,
    writable interactive session (run it from an actual terminal, not
    scripted) — with --print, it's headless via `claude --print`/`codex exec`,
    capturing and printing just the reply. Since the source thread's full
    content gets rendered either way, marks it read (see `unread`) unless
    --no-mark-read is passed.
    """
    sources = (source_filter,) if source_filter else SOURCES
    projects = _resolve_projects(query, match, sources)
    sessions = _all_sessions_for(projects)
    handle = _pick_session_handle(sessions, session_uuid, nth)
    seed = _port_seed_text(handle, raw, include_subagents, limit)
    cwd = handle.project_cwd
    title = _handle_title(handle)

    if target == "claude":
        cmd = ["claude"]
        if headless:
            cmd.append("--print")
            if permission_mode:
                cmd += ["--permission-mode", permission_mode]
        cmd.append(seed)
    else:
        cmd = ["codex", "exec", seed] if headless else ["codex", seed]

    if not yes:
        click.echo("DRY-RUN (nothing launched). Re-run with --yes to port.")
        click.echo(f"  from:    [{handle.source}] {handle.uuid}  ({title})")
        click.echo(f"  into:    {target} ({'headless' if headless else 'interactive'})")
        click.echo(f"  cwd:     {cwd}")
        first_line = seed.splitlines()[0] if seed else ""
        click.echo(f"  seed:    {len(seed)} chars, {len(seed.splitlines())} lines — {first_line}")
        cmd_display = cmd[:-1] + [f"<seed: {len(seed)} chars>"]
        click.echo(f"  command: {' '.join(shlex.quote(c) for c in cmd_display)}")
        return

    if not Path(cwd).is_dir():
        raise click.ClickException(f"{cwd!r} no longer exists on disk.")

    if not no_mark_read:
        state = _load_read_state()
        _handle_mark_read(handle, state)
        _save_read_state(state)

    if headless:
        try:
            result = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=timeout)
        except subprocess.TimeoutExpired:
            raise click.ClickException(f"No reply within {timeout}s (--timeout to extend).")
        except FileNotFoundError:
            raise click.ClickException(f"`{cmd[0]}` not found on PATH.")
        if result.returncode != 0:
            raise click.ClickException(
                result.stderr.strip() or f"{cmd[0]} exited with status {result.returncode}"
            )
        click.echo(result.stdout.strip())
        return

    click.echo(f"Porting [{handle.source}] {handle.uuid} into {target} at {cwd} ...", err=True)
    os.chdir(cwd)
    try:
        os.execvp(cmd[0], cmd)
    except FileNotFoundError:
        raise click.ClickException(f"`{cmd[0]}` not found on PATH.")


if __name__ == "__main__":
    cli()
